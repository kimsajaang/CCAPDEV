<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Backlog Hero | {{title}}</title>
    <!-- Preconnect to CDNs to speed up asset loading -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" href="/favicon.ico?v=2">
    <link rel="stylesheet" href="/style.css?v=2">
    <style>
        /* Correct Sticky Footer Flexbox Logic */
        html {
            height: 100%;
        }
        body { 
            display: flex !important; 
            flex-direction: column !important; 
            min-height: 100vh !important; 
            margin: 0; 
        }
        main.site-content { 
            flex: 1 0 auto; 
            display: flex;
            flex-direction: column;
        }
        footer { 
            flex-shrink: 0; 
            margin-top: auto; 
        }
    </style>
</head>
<body class="{{#if bodyClass}}{{bodyClass}}{{/if}}">
    <canvas id="plexus-canvas"></canvas>

    <main class="site-content">
        {{{body}}}
    </main>

    {{> footer}}

    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="/plexus-bg.js?v=3"></script>
</body>
</html>