<style>
  /* Page-specific: dashboard overrides */
  body.loading {
    overflow: hidden;
  }


  .user-post-item {
    border-left: 4px solid var(--primary) !important;
  }

  .photo-upload-area {
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), background var(--duration) var(--ease);
    background: rgba(83, 131, 232, 0.05);
  }

  .photo-upload-area:hover {
    border-color: var(--primary);
    background: rgba(83, 131, 232, 0.1);
  }

  .photo-upload-area.has-photo {
    border: 1px solid var(--border);
    padding: 8px;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .photo-preview-img {
    width: 100%;
    max-width: 300px;
    height: auto;
    max-height: 300px;
    border-radius: var(--radius-sm);
    object-fit: contain;
    margin-bottom: 0;
  }

  .photo-remove-btn {
    font-size: 0.8rem;
    padding: 4px 8px;
  }

  .feed-photo {
    width: 100%;
    max-height: 400px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin: 10px 0;
    border: 1px solid var(--border);
  }


  /* Trending section */
  .trending-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .trending-header h5 {
    margin: 0;
  }

  .trending-date {
    opacity: 0.55;
    white-space: nowrap;
  }

  .trending-header .btn {
    margin-left: auto;
  }

  .trending-scroll-wrap {
    position: relative;
  }

  .trending-scroll-wrap .scroll-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(10, 14, 19, 0.95);
    border: 1px solid var(--border);
    color: var(--text);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .trending-scroll-wrap .scroll-btn:hover {
    background: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(83, 131, 232, 0.3);
  }

  .trending-scroll-wrap .scroll-left {
    left: -12px;
  }

  .trending-scroll-wrap .scroll-right {
    right: -12px;
  }

  /* Top 50 modal */
  .top50-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }

  .top50-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .top50-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .top50-card img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }

  .top50-card .top50-rank {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
  }

  .top50-card .top50-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 8px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }

  .top50-card .top50-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .top50-card .top50-rating {
    font-size: 0.7rem;
    color: #fb923c;
  }

  /* Trailers section */
  .trailers-card {
    background: var(--bg-card);
    border: 1px solid var(--border) !important;
  }

  .trailers-scroll {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  .trailers-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .trailers-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  .trailer-item {
    flex: 0 0 280px;
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .trailer-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .trailer-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
  }

  .trailer-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .trailer-item:hover .trailer-play-icon {
    opacity: 1;
  }

  .trailer-play-icon i {
    font-size: 2.4rem;
    color: #fff;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
  }

  /* --- Game Suggestion Highlight --- */
  .highlight {
    animation: highlightGlow 1.2s ease-out;
  }

  @keyframes highlightGlow {
    0% {
      background: rgba(83, 131, 232, 0);
      box-shadow: 0 0 0 rgba(83, 131, 232, 0);
    }
    15% {
      background: rgba(83, 131, 232, 0.15);
      box-shadow: 0 0 30px rgba(83, 131, 232, 0.3);
      transform: scale(1.02);
    }
    100% {
      background: rgba(83, 131, 232, 0);
      box-shadow: 0 0 0 rgba(83, 131, 232, 0);
      transform: scale(1);
    }
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .trailer-name {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 10px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Trailer modal */
  .trailer-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .trailer-modal.active {
    opacity: 1;
    pointer-events: all;
  }

  .trailer-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  .trailer-modal-content {
    position: relative;
    width: 90vw;
    max-width: 900px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0a0e13;
    border: 1px solid var(--border);
    transform: scale(0.92);
    transition: transform 0.3s ease;
  }

  .trailer-modal.active .trailer-modal-content {
    transform: scale(1);
  }

  .trailer-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .trailer-modal-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
  }

  .trailer-modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: color 0.2s, background 0.2s;
  }

  .trailer-modal-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  .trailer-modal-body {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
  }

  .trailer-modal-body iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Completion ring */
  .completion-ring {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4);
    background: rgba(10, 14, 19, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .completion-ring-text {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .completion-ring-text strong {
    color: var(--text);
    font-weight: 700;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .suggestion-item {
    transition: background 0.2s ease, transform 0.2s ease;
    border-radius: var(--radius-md);
    padding: 8px;
    margin: -8px; /* Offset the padding for the container */
  }

  .suggestion-item:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(4px);
  }

  .suggest-result.highlight {
    border-color: var(--primary) !important;
    box-shadow: 0 0 20px rgba(83, 131, 232, 0.2);
  }

  /* Chat System Styles */
  .cm-bubble {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 10px 12px;
    margin-bottom: 8px;
    border-left: 3px solid var(--primary);
  }

  .cm-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-size: 0.75rem;
  }

  .cm-user {
    font-weight: 700;
    color: var(--primary);
  }

  .cm-time {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .cm-text {
    color: var(--text);
    font-size: 0.85rem;
    line-height: 1.35;
    word-wrap: break-word;
  }

  /* Chat Input Focus State */
  #chatInput:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 10px rgba(83, 131, 232, 0.2);
  }

  /* Chat Group Select Focus State */
  #chatGroupSelect:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 10px rgba(83, 131, 232, 0.2);
  }

  /* Modal Styles for Chat */
  #createGroupModal, #inviteFriendsModal {
    animation: fadeInScale 0.3s ease;
  }

  @keyframes slideIn {
    from {
      transform: translateX(400px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
</style>


<!-- Fake loading screen -->
