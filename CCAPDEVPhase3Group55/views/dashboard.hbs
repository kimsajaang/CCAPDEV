      });
      window.location.href = 'login';
    } catch (err) {
      console.error('Logout failed:', err);
      window.location.href = 'login';
    }
  }

  // Steam sync function

  // Check if user is logged in and fetch data
  async function initDashboard() {
    try {
      console.log('[Dashboard] Fetching current user...');
      // Fetch current user data with retry logic - more lenient
      let retries = 2;
      let currentUserData = null;

      while (retries > 0) {
        try {
          const userRes = await fetch('/api/auth/current', {
            method: 'GET',
            credentials: 'include',
            cache: 'no-store',
            headers: { 'Content-Type': 'application/json' }
          });

          console.log('[Dashboard] Auth response:', userRes.status);

          if (userRes.ok) {
            currentUserData = await userRes.json();
            console.log('[Dashboard] User logged in:', currentUserData.displayName);
            currentUser = currentUserData;
            document.getElementById('welcomeTitle').innerHTML = `Welcome back, <span class="gradient-text">${currentUser.displayName}!</span>`;

            // Fetch user stats without blocking the rest of the dashboard
            fetch('/api/auth/stats', { credentials: 'include' })
              .then(res => res.json())
              .then(stats => {
                animateCounter('statCompleted', stats.completed || 0);
                animateCounter('statTotal', stats.total || 0);
                animateCounter('statBacklog', stats.backlog || 0);
                animateCounter('statPlaying', stats.playing || 0);
                animateCounter('statHours', Math.round(stats.totalHours || 0));
              })
              .catch(statsErr => console.warn('[Dashboard] Could not fetch stats:', statsErr));

            // Show Steam sync button if user has a Steam ID
            if (currentUserData.steamId) {
              const syncBtn = document.getElementById('steamSyncBtn');
              if (syncBtn) syncBtn.style.display = '';
            }

            // Check if playing a local game session first
            let localPlaying = false;
            try {
              const localSessionStr = localStorage.getItem('bh_active_session_game');
              if (localSessionStr) {
                const localData = JSON.parse(localSessionStr);
                if (localData && localData.name) {
                  localPlaying = true;
                  const gameNameEl = document.getElementById('steamLiveGameNameCard');
                  const coverEl = document.getElementById('steamLiveGameCover');
                  const statusEl = document.getElementById('steamLiveCard');
                  
                  if (gameNameEl) gameNameEl.textContent = localData.name;
                  if (coverEl && localData.cover) coverEl.src = localData.cover;
                  if (statusEl) statusEl.style.display = 'block';
                }
              }
            } catch (err) {}

            // If not playing locally, check Steam status if they have a Steam ID 
            if (!localPlaying && currentUserData.steamId) {
              fetch('/api/auth/steam-status', { credentials: 'include' })
                .then(res => res.json())
                .then(steamData => {
                  if (steamData.playing && steamData.gameName && !steamData.isFallback) {
                    const gameNameEl = document.getElementById('steamLiveGameNameCard');
                    const coverEl = document.getElementById('steamLiveGameCover');
                    const statusEl = document.getElementById('steamLiveCard');
                    
                    if (gameNameEl) gameNameEl.textContent = steamData.gameName;
                    if (coverEl && steamData.coverUrl) coverEl.src = steamData.coverUrl;
                    if (statusEl) statusEl.style.display = 'block';
                  }
                })
                .catch(steamErr => console.warn('[Dashboard] Could not fetch live Steam status:', steamErr));
            }

            // Load critical content immediately
            loadActivityFeed(currentUserData);
            loadGameDropdown(currentUserData);
            loadPendingBadge();
            // Pre-fetch trending data once, then both sections use it
            fetchTrendingGames();
            loadTrendingGames();

            // Defer non-critical content (community scores, trailers, chat) to load after page is interactive
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                  loadCommunityScores(currentUserData);
                  loadTrailers();
                  initChat(currentUserData);
                }, 500);
              });
            } else {
              setTimeout(() => {
                loadCommunityScores(currentUserData);
                loadTrailers();
                initChat(currentUserData);
              }, 500);
            }

            return; // Success - exit function
          }
          // Retry on any non-200 status
        } catch (fetchErr) {
          console.warn('[Dashboard] Fetch attempt ' + (3 - retries) + ' failed:', fetchErr.message);
          // Network errors are temporary - retry
        }
        retries--;
        if (retries > 0) {
          await new Promise(r => setTimeout(r, 300)); // Brief wait before retry
        }
      }

      // If all retries exhausted, do one final redirect attempt
      console.error('[Dashboard] Auth check failed after all retries - redirecting');
      setTimeout(() => {
        window.location.href = 'login';
      }, 500);

    } catch (err) {
      console.error('[Dashboard] Failed to load dashboard:', err);
      setTimeout(() => {
        window.location.href = 'login';
      }, 500);
    }
  }

  // Hide loader after DOM is ready to avoid hanging on slow images/iframes
