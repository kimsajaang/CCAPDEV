  // --- Dynamic Activity Feed (combines own + friends activity) ---
  let allActivityFeedItems = []; // Store all feed items for filtering
  
  async function loadActivityFeed(user) {
    const feedEl = document.getElementById('activityFeed');
    try {
      // Fetch friend achievements and game reviews
      const res = await fetch('/api/friends/activity', { credentials: 'include' });
      if (!res.ok) {
        feedEl.innerHTML = '<div class="list-group-item p-3 text-center text-muted">Could not load friend activity.</div>';
        return;
      }

      const feedItems = await res.json();
      allActivityFeedItems = feedItems || []; // Store for filtering

