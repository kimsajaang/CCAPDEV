  function applyActivityFilters() {
    const feedEl = document.getElementById('activityFeed');
    const typeFilter = document.getElementById('activityTypeFilter').value;
    const sortFilter = document.getElementById('activitySortFilter').value;
    const positiveCbx = document.getElementById('ratingPositive').checked;
    const negativeCbx = document.getElementById('ratingNegative').checked;

    // Filter items
    let filtered = allActivityFeedItems.filter(item => {
      // Type filter
      if (typeFilter === 'review' && item.type !== 'review') return false;
      if (typeFilter === 'achievement' && item.type !== 'achievement') return false;

      // Rating filter (only applies to reviews)
      if (item.type === 'review') {
        const isPositive = item.rating >= 4;  // 4-5 stars = positive
        const isNegative = item.rating <= 2;  // 1-2 stars = negative (neutral 3 excluded)
        const shouldShow = (isPositive && positiveCbx) || (isNegative && negativeCbx);
        if (!shouldShow) return false;
      }

      return true;
    });

    // Sort items
    if (sortFilter === 'oldest') {
      filtered = filtered.reverse();
    } else if (sortFilter === 'highest') {
      filtered.sort((a, b) => (b.rating || 0) - (a.rating || 0));
    } else if (sortFilter === 'lowest') {
      filtered.sort((a, b) => (a.rating || 0) - (b.rating || 0));
    }

    // Render filtered items
    let html = '';
    if (filtered.length === 0) {
      feedEl.innerHTML = '<div class="list-group-item p-3 text-center text-muted">No activity matches your filters.</div>';
      return;
    }

    for (const item of filtered) {
      if (item.type === 'achievement') {
        const iconMap = {
          'completion': '🏁',
          'playtime': '⏱️',
          'rating': '⭐'
        };
        const icon = iconMap[item.subtype] || '🎮';
        
        html += `
          <div class="list-group-item p-3 border-start border-primary border-4 reveal is-visible" style="background: rgba(83, 131, 232, 0.05);">
            <div class="d-flex align-items-start gap-2">
              <div style="font-size: 1.5rem; flex-shrink: 0;">${icon}</div>
              <div style="flex: 1; min-width: 0;">
                <h6 class="mb-1 small fw-bold" style="color: var(--accent);">${item.friendName}</h6>
                <p class="mb-1 small" style="color: var(--text-secondary);">${item.message}</p>
                <div class="badge bg-primary" style="font-size: 0.75rem;">📈 ${item.count}</div>
              </div>
            </div>
          </div>`;
      } else if (item.type === 'post') {
        html += `
          <div class="list-group-item p-3 border-start border-warning border-4 reveal is-visible" style="background: rgba(251, 191, 36, 0.03);">
            <div class="d-flex align-items-start gap-3">
              <div style="flex-shrink: 0; font-size: 1.5rem;">📝</div>
              <div style="flex: 1; min-width: 0;">
                <h6 class="mb-1 small fw-bold" style="color: var(--accent);">${item.friendName}</h6>
                <p class="mb-1 small fw-500" style="color: var(--text-primary);">${item.title || 'Logged a session'}</p>
                ${item.game ? `<p class="mb-2 small" style="color: var(--text-secondary);">🎮 ${item.game}</p>` : ''}
                ${item.body ? `<p class="mb-0 small" style="color: var(--text-secondary);">"${item.body}"</p>` : ''}
              </div>
            </div>
          </div>`;
      } else if (item.type === 'review') {
        const coverUrl = item.coverUrl ? `style="width: 50px; height: 70px; object-fit: cover; border-radius: 4px;"` : '';
        const gameImage = item.coverUrl 
          ? `<img src="${item.coverUrl}" alt="${item.game}" ${coverUrl}>`
          : `<div style="width: 50px; height: 70px; background: var(--card-bg); border: 1px solid var(--border); border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: var(--text-muted); text-align: center; padding: 4px;">No Cover</div>`;
        
        const ratingColor = item.rating >= 4 ? '#fbbf24' : item.rating >= 3 ? '#60a5fa' : '#ef4444';
        const gameDataStr = JSON.stringify({ gameId: item.gameId, friendId: item.friendId, gameName: item.game, coverUrl: item.coverUrl, friendName: item.friendName, rating: item.rating, stars: item.stars, message: item.message }).replace(/"/g, '&quot;');
        
        // Build comments section if they exist
        let commentsHtml = '';
        if (item.comments && item.comments.length > 0) {
          commentsHtml = `
            <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border);">
              <small style="color: var(--text-muted); display: block; margin-bottom: 8px;"><i class="bi bi-chat-dots me-1"></i>Comments:</small>`;
          item.comments.forEach(comment => {
            commentsHtml += `
              <div style="background: rgba(83, 131, 232, 0.05); padding: 8px 12px; border-radius: 6px; margin-bottom: 6px;">
                <p class="mb-1 small" style="color: var(--accent); font-weight: 600;">${comment.userName}</p>
                <p class="mb-0 small" style="color: var(--text-secondary);">"${comment.text}"</p>
              </div>`;
          });
          commentsHtml += `</div>`;
        }
        
        html += `
          <div class="list-group-item p-3 border-start border-4 reveal is-visible" style="border-color: ${ratingColor}; background: rgba(251, 191, 36, 0.03); transition: all 0.2s ease;">
            <div class="d-flex align-items-start gap-3">
              <div style="flex-shrink: 0; cursor: pointer;" onclick="viewFriendReview('${gameDataStr}')">
                ${gameImage}
              </div>
              <div style="flex: 1; min-width: 0;">
                <h6 class="mb-1 small fw-bold" style="color: var(--accent);">${item.friendName}</h6>
                <p class="mb-2 small fw-500 cursor-pointer" style="color: var(--text-primary);" onclick="viewFriendReview('${gameDataStr}')">${item.game}</p>
                <div class="d-flex align-items-center gap-2 mb-2">
                  <span style="font-size: 0.9rem; color: ${ratingColor};">${item.stars}</span>
                  <span class="small" style="color: var(--text-secondary);">${item.message}</span>
                </div>
                ${commentsHtml}
                <small style="color: var(--text-muted); cursor: pointer; margin-top: 8px; display: inline-block;" onclick="viewFriendReview('${gameDataStr}')">Click to view full review</small>
              </div>
            </div>
          </div>`;
      }
    }

    feedEl.innerHTML = html;
  }

