<div class="container my-5">
  <!-- Welcome hero card with user stats -->
  <div class="hero hero-compact mb-4 reveal">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h2 class="mb-2" id="welcomeTitle"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:900; letter-spacing:-0.03em; line-height:1.1;">
          Play smarter, <span class="gradient-text">finish more.</span>
        </h2>
        <p class="hero-sub mb-4 opacity-75" style="font-size: 1.1rem;">Your personal command center for game tracking
          and discovery.</p>

        <div class="d-flex flex-wrap gap-3">
          <a class="btn btn-premium" href="/search">
            <i class="bi bi-search me-2"></i>Find Games
          </a>
          <a class="btn btn-premium-outline" href="/library">
            <i class="bi bi-collection-play me-2"></i>My Library
          </a>
        </div>
      </div>

      <div class="col-lg-6 d-flex gap-4 justify-content-lg-end align-items-center mt-4 mt-lg-0">
        
        <div class="hero-stats justify-content-lg-end">
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-check-circle-fill"></i>Completed</div>
            <div class="hero-stat-value counter-animate" id="statCompleted">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-controller"></i>Collection</div>
            <div class="hero-stat-value counter-animate" id="statTotal">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-hourglass-split"></i>Backlog</div>
            <div class="hero-stat-value counter-animate" id="statBacklog">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-play-fill"></i>Playing</div>
            <div class="hero-stat-value counter-animate" id="statPlaying">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-clock-history"></i>Hours</div>
            <div class="hero-stat-value counter-animate" id="statHours">0</div>
          </div>
        </div>

        <div id="steamLiveCard" style="display:none; width: 160px; flex-shrink: 0; animation: fadeInScale 0.4s ease forwards;">
            <div style="font-size: 0.8rem; color: #4ab76b; font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                <span class="dot-live" style="width:7px; height:7px; background:#4ab76b; border-radius:50%; box-shadow: 0 0 10px #4ab76b; animation: pulseLive 2s infinite; display: inline-block;"></span>
                Playing
            </div>
            <div class="game-card" style="border-radius: 12px; overflow: hidden; position: relative; border: 1px solid rgba(74, 183, 107, 0.4); box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 20px rgba(74, 183, 107, 0.2); cursor: pointer;" onclick="window.location.href='/library'">
                <img id="steamLiveGameCover" src="" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block;" alt="Game Cover" onerror="this.onerror=null;this.src='https://via.placeholder.com/300x400/1a2634/5383e8?text=Playing';">
                <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,0.95), transparent); padding: 30px 10px 10px;">
                    <span id="steamLiveGameNameCard" style="font-size: 0.95rem; font-weight: 800; color: #fff; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 2px 4px rgba(0,0,0,0.9);">Game Name</span>
                </div>
            </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Trending Games -->
  <div class="trending-section mb-4 reveal">
    <div class="trending-header">
      <h5><i class="bi bi-fire me-2" style="color:#fb923c;"></i>Trending <span class="gradient-text">Right Now</span>
      </h5>

      <button class="btn btn-sm btn-outline-primary" id="seeAllBtn">See All</button>
    </div>
    <div class="trending-scroll-wrap">
      <button class="scroll-btn scroll-left"
        onclick="document.getElementById('trendingScroll').scrollBy({left:-340,behavior:'smooth'})"><i
          class="bi bi-chevron-left"></i></button>
      <div class="trending-scroll" id="trendingScroll">
        <div class="text-muted small p-3">Loading trending games...</div>
      </div>
      <button class="scroll-btn scroll-right"
        onclick="document.getElementById('trendingScroll').scrollBy({left:340,behavior:'smooth'})"><i
          class="bi bi-chevron-right"></i></button>
    </div>
  </div>

  <div class="row g-4 reveal">
    <div class="col-md-3">
      <!-- Backlog suggestion tool — user enters available minutes, gets a game pick. -->
      <div class="card mb-4 reveal">
        <div class="card-body" style="padding: 16px;">
          <h5 class="card-title mb-2" style="font-size: 1.1rem;"><i class="bi bi-lightning me-2" style="color: var(--primary);"></i>What's the Plan?</h5>
          <p class="text-muted mb-3" style="font-size: 0.85rem;">Pick a source and enter your time.</p>
          
          <!-- Source Selection -->
          <div class="mb-3">
            <div class="btn-group w-100 plan-source-group" role="group" style="gap: 6px; height: 40px;">
              <input type="radio" class="btn-check" name="planSource" id="planSourceLibrary" value="library" checked>
              <label class="btn btn-sm" for="planSourceLibrary" style="flex: 1; background: transparent; border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-weight: 500; transition: all 0.2s; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden;">
                <i class="bi bi-collection me-1"></i><span>My Library</span>
              </label>
              <input type="radio" class="btn-check" name="planSource" id="planSourceNew" value="new">
              <label class="btn btn-sm" for="planSourceNew" style="flex: 1; background: transparent; border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-weight: 500; transition: all 0.2s; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; white-space: nowrap; overflow: hidden;">
                <i class="bi bi-sparkles me-1"></i><span>Try New</span>
              </label>
            </div>
            <style>
              .plan-source-group .btn-check:checked + .btn {
                background: var(--primary-subtle) !important;
                border-color: var(--primary) !important;
                color: var(--primary) !important;
              }
            </style>
          </div>

          <!-- Time Input -->
          <div class="mb-3">
            <div class="input-group" style="gap: 6px; height: 40px;">
              <input id="planHours" type="number" min="0" inputmode="numeric" class="form-control bg-dark text-white border-secondary" placeholder="Hours" style="border-radius: 6px; font-size: 0.85rem;">
              <input id="planMinutes" type="number" min="0" max="59" inputmode="numeric" class="form-control bg-dark text-white border-secondary" placeholder="Minutes" style="border-radius: 6px; font-size: 0.85rem;">
            </div>
          </div>

          <!-- Suggest Button -->
          <button id="planSuggestBtn" class="btn btn-primary w-100 mb-3" type="button" style="border-radius: 6px; font-weight: 600; font-size: 0.9rem; padding: 8px; height: 40px;">
            <i class="bi bi-arrow-right me-1"></i>Get Suggestion
          </button>

          <!-- Result Area -->
          <div id="planResult" class="suggest-result p-2 rounded border border-secondary bg-dark" style="border-radius: 6px;">
            <p class="mb-0 small text-muted text-center" style="font-size: 0.8rem;">
              <i class="bi bi-info-circle me-1"></i>Enter time
            </p>
          </div>
        </div>
      </div>

      <!-- Latest Game Trailers -->
      <div class="card border-0 mb-4 reveal trailers-card">
        <div class="card-body p-3">
          <h6 class="mb-3"><i class="bi bi-play-circle me-1" style="color:var(--accent)"></i>Latest Trailers</h6>
          <div class="trailers-scroll" id="trailersScroll">
            <div class="text-muted small p-2">Loading trailers...</div>
          </div>
        </div>
      </div>

      <!-- Community ratings sidebar -->
      <div class="card reveal" style="min-height: 400px; display: flex; flex-direction: column;">
        <div class="card-body" style="padding: 20px; flex: 1; display: flex; flex-direction: column;">
          <h6 class="mb-4" style="font-size: 1.1rem;">Community Quality Scores</h6>
          <div id="communityScores" style="flex: 1; overflow-y: auto; padding-right: 8px;">
            <p class="text-muted small mb-0">Loading scores...</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <!-- Friend Activity Feed -->
      <div class="d-flex justify-content-between align-items-center mb-4 reveal">
        <h4><i class="bi bi-broadcast me-2" style="color:var(--accent);"></i>Friend Activity <span
            class="gradient-text-accent">Feed</span></h4>
      </div>

      <!-- Filters & Sorting -->
      <div class="card bg-section border-0 shadow-sm mb-3 reveal">
        <div class="card-body p-3">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label small fw-bold mb-1">Type</label>
              <select id="activityTypeFilter" class="form-select form-select-sm bg-dark text-white border-secondary" onchange="applyActivityFilters()">
                <option value="all">All Activity</option>
                <option value="review">Reviews Only</option>
                <option value="achievement">Achievements Only</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold mb-1">Sort By</label>
              <select id="activitySortFilter" class="form-select form-select-sm bg-dark text-white border-secondary" onchange="applyActivityFilters()">
                <option value="newest">Newest First</option>
                <option value="oldest">Oldest First</option>
                <option value="highest">Highest Rated</option>
                <option value="lowest">Lowest Rated</option>
              </select>
            </div>
          </div>
          <div class="mt-2">
            <label class="form-label small fw-bold mb-1">Rating Filter</label>
            <div>
              <label class="form-check form-check-inline">
                <input type="checkbox" id="ratingPositive" class="form-check-input" checked onchange="applyActivityFilters()">
                <span class="form-check-label" style="font-size: 0.9rem; color: #10b981;">Positive (4-5★)</span>
              </label>
              <label class="form-check form-check-inline">
                <input type="checkbox" id="ratingNegative" class="form-check-input" checked onchange="applyActivityFilters()">
                <span class="form-check-label" style="font-size: 0.9rem; color: #ef4444;">Negative (1-2★)</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="list-group shadow-sm" id="activityFeed">
        <div class="list-group-item p-3 text-center text-muted">Loading activity feed...</div>
      </div>
    </div>

