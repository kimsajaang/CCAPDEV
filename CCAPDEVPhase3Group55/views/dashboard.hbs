  // --- Dynamic Community Scores ---
  async function loadCommunityScores(user) {
    const scoresEl = document.getElementById('communityScores');
    try {
      // Fetch aggregated community-wide scores from all users
      const res = await fetch('/api/community/quality-scores', { credentials: 'include' });
      if (!res.ok) {
        scoresEl.innerHTML = '<p class="text-muted small mb-0">Could not load community scores.</p>';
        return;
      }

      const communityGames = await res.json();

      if (!communityGames || communityGames.length === 0) {
        scoresEl.innerHTML = '<p class="text-muted small mb-0">No community ratings yet. Be the first to rate a game!</p>';
        return;
      }

      let html = '';
      communityGames.forEach((game, idx) => {
        // Generate stars based on actual average rating
        const avgRating = parseFloat(game.averageRating);
        const fullStars = Math.floor(avgRating);
        const hasHalfStar = (avgRating % 1) >= 0.5;
        const emptyStars = 5 - Math.ceil(avgRating);

        let stars = '★'.repeat(fullStars);
        if (hasHalfStar && fullStars < 5) stars += '½';
        stars += '☆'.repeat(emptyStars);

        html += `<div style="animation: fadeInUp 0.4s ease ${idx * 0.05}s both; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
          <div style="flex: 1; min-width: 0;">
            <div class="text-truncate fw-500" title="${game.name}" style="word-break: break-word;">${game.name}</div>
            <div class="text-muted" style="font-size: 0.75rem; margin-top: 4px;">${game.ratingCount} ${game.ratingCount === 1 ? 'rating' : 'ratings'}</div>
          </div>
          <div style="font-weight: bold; white-space: nowrap; font-size: 1rem; color: #fbbf24; flex-shrink: 0;">${stars}</div>
        </div>`;
      });

      scoresEl.innerHTML = html;
    } catch (err) {
      console.warn('[Dashboard] Community scores error:', err);
      scoresEl.innerHTML = '<p class="text-muted small mb-0">Could not load scores.</p>';
    }
  }

  // --- Dynamic Game Dropdown for Post Update ---
  async function loadGameDropdown(user) {
    const sel = document.getElementById('updateGame');
    try {
      const userId = user._id || user.id;
      const libRes = await fetch('/api/library/' + userId, { credentials: 'include' });
      if (!libRes.ok) { sel.innerHTML = '<option value="">No games in library</option>'; return; }
      const entries = await libRes.json();
      const games = entries.filter(e => e.gameId).map(e => e.gameId.name).filter(Boolean);
      if (games.length === 0) {
        sel.innerHTML = '<option value="">No games in library</option>';
        return;
      }
      sel.innerHTML = games.map(name => `<option value="${name}">${name}</option>`).join('');
    } catch (err) {
      sel.innerHTML = '<option value="">Could not load games</option>';
    }
  }

  // ════════════════════════════════════════════════════════════════
  // CHAT FUNCTIONALITY - General & Group Chats
  // ════════════════════════════════════════════════════════════════

  let activeGroupId = 'general';
  let allGroups = [];
  let messageRefreshInterval = null;

  async function initChat(user) {
    try {
      currentUser = user;
      // Don't block - load groups asynchronously
      loadChatGroups().catch(err => console.warn('[Chat] Error loading groups:', err));
      
      // Initialize with general chat, but don't await it
      // Use a very short delay to avoid blocking the main dashboard render
      setTimeout(() => {
        refreshChatMessages()
          .then(() => {
            // Only set up refresh interval after first message fetch succeeds
            if (messageRefreshInterval) clearInterval(messageRefreshInterval);
            messageRefreshInterval = setInterval(() => {
              if (activeGroupId && document.getElementById('chatMessages')) {
                refreshChatMessages().catch(err => {
                  if (err.message.includes('Failed to fetch')) {
                    console.warn('[Chat] Network error during refresh, will retry next cycle');
                  }
                });
              }
            }, 5000);
          })
          .catch(err => {
            console.warn('[Chat] Failed to load initial messages:', err.message);
            // Even if initial load fails, set up the refresh interval to retry
            if (messageRefreshInterval) clearInterval(messageRefreshInterval);
            messageRefreshInterval = setInterval(() => {
              refreshChatMessages().catch(() => {});
            }, 5000);
          });
      }, 50); // Very short delay
    } catch (err) {
      console.warn('[Chat] Init error:', err.message);
    }
  }

  async function loadChatGroups() {
    try {
      const res = await fetch('/api/chat/groups', { credentials: 'include' });
      if (!res.ok) {
        console.warn('[Chat] Failed to load groups, status:', res.status);
        return;
      }
      allGroups = await res.json();
      renderChatGroupSelect();
    } catch (err) {
      console.warn('[Chat] Failed to load groups:', err.message);
    }
  }

  function renderChatGroupSelect() {
    const select = document.getElementById('chatGroupSelect');
    // General chat + user's groups
    const options = [
      { id: 'general', name: '🌍 General Chat' },
      ...allGroups.map(g => ({ id: g._id, name: `👥 ${g.name}` }))
    ];
    select.innerHTML = options.map(opt => 
      `<option value="${opt.id}" ${activeGroupId === opt.id ? 'selected' : ''}>${opt.name}</option>`
    ).join('');
  }

  async function switchToChat(groupId) {
    activeGroupId = groupId;
    
    // Show/hide the "Add Member" button
    const addMemberBtn = document.getElementById('addMemberBtn');
    if (groupId === 'general') {
      addMemberBtn.style.display = 'none';
    } else {
      addMemberBtn.style.display = 'inline-block';
    }

    renderChatGroupSelect();
    await refreshChatMessages();
  }

  function switchChatGroup(groupId) {
    switchToChat(groupId).catch(err => console.warn('[Chat] Failed to switch group:', err.message));
  }

  async function refreshChatMessages() {
    try {
      const container = document.getElementById('chatMessages');
      if (!container) return;

      let messages = [];
      if (activeGroupId === 'general') {
        const res = await fetch('/api/chat/general?limit=50', { credentials: 'include' });
        if (!res.ok) throw new Error('Failed to fetch general chat');
        messages = await res.json();
      } else {
        const res = await fetch(`/api/chat/group/${activeGroupId}?limit=50`, { credentials: 'include' });
        if (!res.ok) throw new Error('Failed to fetch group chat');
        messages = await res.json();
      }

      if (!messages || !messages.length) {
        container.innerHTML = `
          <div class="text-center text-muted small py-5">
            <i class="bi bi-chat-dots" style="font-size:2rem; display:block; margin-bottom:10px; opacity:0.15;"></i>
            No messages yet.
          </div>
        `;
        return;
      }

      container.innerHTML = messages.map(m => `
        <div class="cm-bubble">
          <div class="cm-header">
            <span class="cm-user">${m.senderName || 'Anonymous'}</span>
            <span class="cm-time">${new Date(m.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
          </div>
          <div class="cm-text">${escapeHtml(m.text)}</div>
        </div>
      `).join('');

      container.scrollTop = container.scrollHeight;
    } catch (err) {
      console.warn('[Chat] Refresh failed:', err.message);
    }
  }

  async function handleChatInput(e) {
    if (e.key === 'Enter' && e.target.value.trim()) {
      const text = e.target.value.trim();
      e.target.value = ''; // Clear immediately for UX
      try {
        const res = await fetch('/api/chat/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ text, chatRoom: activeGroupId })
        });
        if (!res.ok) {
          console.warn('[Chat] Failed to send, status:', res.status);
          return;
        }
        // Refresh after sending
        setTimeout(() => refreshChatMessages().catch(err => console.warn('[Chat] Refresh after send failed:', err)), 300);
      } catch (err) {
        console.warn('[Chat] Send error:', err.message);
      }
    }
  }

  async function openCreateGroupModal() {
    const modal = `
      <div id="createGroupModal" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.7); display:flex; align-items:center; justify-content:center; z-index:9999;">
        <div style="background:#1a1f2e; border-radius:12px; padding:24px; width:90%; max-width:400px; box-shadow:0 20px 60px rgba(0,0,0,0.5);">
          <h5 style="margin-bottom:16px; color:#fff;">Create Group Chat</h5>
          <input type="text" id="newGroupNameInput" class="form-control form-control-sm bg-dark text-white border-secondary mb-3" placeholder="Group name..." maxlength="50" style="color: #fff !important; border-color: var(--border) !important;">
          <div style="display:flex; gap:8px;">
            <button class="btn btn-sm btn-primary" onclick="confirmCreateGroup()" style="flex:1;">Create</button>
            <button class="btn btn-sm btn-outline-secondary" onclick="this.closest('#createGroupModal').remove()" style="flex:1;">Cancel</button>
          </div>
        </div>
      </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modal);
    document.getElementById('newGroupNameInput').focus();
  }

  async function confirmCreateGroup() {
    const nameInput = document.getElementById('newGroupNameInput');
    if (!nameInput.value.trim()) {
      alert('Group name is required');
      return;
    }

    if (nameInput.value.trim().length > 50) {
      alert('Group name must be 50 characters or less');
      return;
    }

    const submitBtn = document.querySelector('#createGroupModal .btn-primary');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating...';

    try {
      const res = await fetch('/api/chat/group', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ name: nameInput.value.trim() })
      });
      if (res.ok) {
        const group = await res.json();
        const modal = document.getElementById('createGroupModal');
        if (modal) modal.remove();
        await loadChatGroups();
        await switchToChat(group._id);
      } else {
        const errData = await res.json().catch(() => ({}));
        alert(errData.error || 'Failed to create group');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Group';
      }
    } catch (err) {
      console.error('[Chat] Failed to create group:', err);
      alert('Error creating group. Please check your connection.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create Group';
    }
  }

  async function openInviteModal() {
    // Validate group exists first
    if (!activeGroupId || activeGroupId === 'general') {
      alert('Cannot invite members to general channel');
      return;
    }

    const currentGroup = allGroups.find(g => g._id === activeGroupId);
    if (!currentGroup) {
      alert('Group not found. Please refresh and try again.');
      return;
    }

    // Check if user is owner
    if (currentGroup.owner?._id !== currentUserData._id) {
      alert('Only the group owner can invite members');
      return;
    }

    // Get friends
    let friends = [];
    try {
      const res = await fetch('/api/friends', { credentials: 'include' });
      if (!res.ok) {
        throw new Error('Failed to load friends list');
      }
      friends = await res.json();
    } catch (err) {
      console.error('[Chat] Failed to load friends:', err);
      alert('Could not load friends list. Please try again.');
      return;
    }

    // Filter out members already in group
    const existingMemberIds = currentGroup.members?.map(m => m._id || m) || [];
    const availableFriends = friends.filter(f => !existingMemberIds.includes(f._id));

    const modal = `
      <div id="inviteFriendsModal" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.7); display:flex; align-items:center; justify-content:center; z-index:9999;">
        <div style="background:#1a1f2e; border-radius:12px; padding:24px; width:90%; max-width:500px; box-shadow:0 20px 60px rgba(0,0,0,0.5); max-height:80vh; overflow-y:auto;">
          <h5 style="margin-bottom:16px; color:#fff;">Invite Friends to ${escapeHtml(currentGroup.name)}</h5>
          <div id="inviteFriendsList">
            ${availableFriends.length === 0 ? `<div class="text-center py-4 text-muted">${friends.length === 0 ? 'You have no friends to invite!' : 'All friends are already in this group!'}</div>` : 
              availableFriends.map(f => `
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; padding:12px; background:rgba(255,255,255,0.02); border-radius:8px;" class="friend-invite-item" data-friend-id="${f._id}">
                  <div style="display:flex; align-items:center; gap:12px;">
                    <img src="${f.avatar || 'https://ui-avatars.com/api/?name=User'}" style="width:32px; height:32px; border-radius:50%; object-fit:cover;">
                    <span style="font-weight:600; color:#fff;">${escapeHtml(f.displayName || f.username)}</span>
                  </div>
                  <button class="btn btn-sm btn-primary add-friend-btn" style="font-size:0.75rem;">Add</button>
                </div>
              `).join('')
            }
          </div>
          <button class="btn btn-sm btn-outline-secondary mt-3" onclick="this.closest('#inviteFriendsModal')?.remove()" style="width:100%;">Close</button>
        </div>
      </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modal);

    // Attach event listeners to the Add buttons
    document.querySelectorAll('#inviteFriendsModal .add-friend-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const item = e.target.closest('.friend-invite-item');
        const friendId = item.dataset.friendId;
        const friendName = item.querySelector('span').textContent;
        await addFriendToGroup(friendId, friendName, btn);
      });
    });
  }

  async function addFriendToGroup(friendId, friendName, btn) {
    if (!btn) btn = event?.target;
    if (!btn) return;

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Adding...';

    try {
      const res = await fetch(`/api/chat/group/${activeGroupId}/member`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ userId: friendId })
      });

      if (res.ok) {
        btn.textContent = '✓ Added';
        btn.style.background = '#10b981';
        await loadChatGroups();
        setTimeout(() => {
          const modal = document.getElementById('inviteFriendsModal');
          if (modal) modal.remove();
        }, 1000);
      } else {
        const errData = await res.json().catch(() => ({}));
        const errorMsg = errData.error || `Failed to add friend (${res.status})`;
        
        if (res.status === 403) {
          alert('Only the group owner can add members');
        } else if (res.status === 409) {
          alert(errorMsg); // Already a member
        } else {
          alert(errorMsg);
        }
        
        btn.textContent = originalText;
        btn.disabled = false;
      }
    } catch (err) {
      console.error('[Chat] Failed to add friend:', err);
      alert('Error connecting to server. Please check your connection and try again.');
      btn.textContent = originalText;
      btn.disabled = false;
    }
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // --- Pending Friend Requests Badge ---
  async function loadPendingBadge() {
    try {
      const res = await fetch('/api/friends/requests', { credentials: 'include' });
      if (!res.ok) return;
      const requests = await res.json();
      if (requests.length > 0) {
        const profileLink = document.querySelector('a.nav-link[href="profile"]');
        if (profileLink) {
          profileLink.innerHTML = `Profile <span style="display:inline-flex;align-items:center;justify-content:center;background:#ef4444;color:#fff;font-size:0.6rem;font-weight:700;width:16px;height:16px;border-radius:50%;margin-left:4px;">${requests.length}</span>`;
        }
      }
    } catch (e) { /* silent */ }
  }

  // Page exit transition
  document.querySelectorAll('a[href]').forEach(a => {
    if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
      a.addEventListener('click', e => {
        e.preventDefault();
        const dest = a.href;
        document.body.classList.add('page-exit');
        setTimeout(() => window.location = dest, 300);
      });
    }
  });

  // ============================================================
  // Animated Counter
  // ============================================================
  function animateCounter(elementId, target) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const duration = 1200;
    const start = performance.now();
    const from = 0;
    function update(now) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(from + (target - from) * eased);
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  // ============================================================
  // Latest Trailers — pulled from trending games' IGDB videos
  // ============================================================
  let _trendingGamesPromise = null;
  function fetchTrendingGames() {
    if (!_trendingGamesPromise) {
      _trendingGamesPromise = fetch('/api/games/popular', { credentials: 'include' })
        .then(r => r.ok ? r.json() : [])
        .catch(() => []);
    }
    return _trendingGamesPromise;
  }

  async function loadTrailers() {
    const container = document.getElementById('trailersScroll');
    if (!container) return;
    try {
      const games = await fetchTrendingGames();
      // Extract trailers — max 1 per game for diversity
      const trailers = [];
      for (const game of games) {
        if (!game.videos || game.videos.length === 0) continue;
        trailers.push({ gameName: game.name, videoId: game.videos[0].video_id });
        if (trailers.length >= 12) break;
      }
      if (trailers.length === 0) {
        container.innerHTML = '<div class="text-muted small p-2">No trailers available for current trending games.</div>';
        return;
      }
      container.innerHTML = '';
      trailers.slice(0, 12).forEach((t, idx) => {
        const thumb = `https://img.youtube.com/vi/${t.videoId}/mqdefault.jpg`;
        const item = document.createElement('div');
        item.className = 'trailer-item';
        item.style.animation = `fadeInUp 0.4s ease ${idx * 0.07}s both`;
        item.innerHTML = `
              <img class="trailer-thumb" src="${thumb}" alt="${t.gameName}" loading="lazy">
              <div class="trailer-play-icon"><i class="bi bi-play-fill"></i></div>
              <div class="trailer-name">${t.gameName}</div>
            `;
        item.addEventListener('click', () => openTrailerPlayer(t.videoId, t.gameName));
        container.appendChild(item);
      });
    } catch (err) {
      console.warn('[Dashboard] Trailers load error:', err);
      container.innerHTML = '<div class="text-muted small p-2">Could not load trailers.</div>';
    }
  }

  // Inline YouTube player modal
  function openTrailerPlayer(videoId, gameName) {
    // Remove existing modal if any
    let existing = document.getElementById('trailerModal');
    if (existing) existing.remove();
    const modal = document.createElement('div');
    modal.id = 'trailerModal';
    modal.className = 'trailer-modal';
    modal.innerHTML = `
          <div class="trailer-modal-backdrop"></div>
          <div class="trailer-modal-content">
            <div class="trailer-modal-header">
              <span class="trailer-modal-title">${gameName}</span>
              <button class="trailer-modal-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="trailer-modal-body">
              <iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" 
                      allow="autoplay; encrypted-media; fullscreen" 
                      allowfullscreen 
                      frameborder="0"></iframe>
            </div>
          </div>
        `;
    document.body.appendChild(modal);
    // Animate in
    requestAnimationFrame(() => modal.classList.add('active'));
    // Close handlers
    const close = () => { modal.classList.remove('active'); setTimeout(() => modal.remove(), 300); };
    modal.querySelector('.trailer-modal-backdrop').addEventListener('click', close);
    modal.querySelector('.trailer-modal-close').addEventListener('click', close);
    document.addEventListener('keydown', function escHandler(e) {
      if (e.key === 'Escape') { close(); document.removeEventListener('keydown', escHandler); }
    });
  }

  // ============================================================
  // Trending Games (IGDB via server)
  // ============================================================
  async function loadTrendingGames() {
    const container = document.getElementById('trendingScroll');
    if (!container) return;
    // Show current date range
    const dateEl = document.getElementById('trendingDate');
    if (dateEl) {
      const now = new Date();
      const thirtyAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
      const fmt = d => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      dateEl.textContent = fmt(thirtyAgo) + ' — ' + fmt(now);
    }

    // ── Build the single global hover panel (created once, reused per card) ──
    let ghPanel = document.getElementById('ghp-panel');
    if (!ghPanel) {
      ghPanel = document.createElement('div');
      ghPanel.id = 'ghp-panel';
      ghPanel.className = 'ghp-panel';
      ghPanel.innerHTML = `
        <div class="ghp-media">
          <iframe class="ghp-iframe" frameborder="0"
            allow="autoplay; encrypted-media; fullscreen"
            allowfullscreen></iframe>
          <div class="ghp-screenshot" style="display:none;"></div>
          <div class="ghp-no-media" style="display:none;"><i class="bi bi-controller"></i></div>
        </div>
        <div class="ghp-body">
          <div class="ghp-title"></div>
          <div class="ghp-release"></div>
          <div class="ghp-reviews"></div>
          <div class="ghp-description"></div>
          <div class="ghp-tags"></div>
        </div>
      `;
      document.body.appendChild(ghPanel);

      // Prevent scroll inside panel from leaking to page
      ghPanel.addEventListener('wheel', e => e.stopPropagation(), { passive: true });
    }

    const ghpIframe     = ghPanel.querySelector('.ghp-iframe');
    const ghpScreenshot = ghPanel.querySelector('.ghp-screenshot');
    const ghpNoMedia    = ghPanel.querySelector('.ghp-no-media');
    let   ghpHideTimer  = null;

    const openPanel = (gameData, cardEl) => {
      clearTimeout(ghpHideTimer);
      const { name, videoId, screenshot, releaseDate, rating, reviewStatus, reviewClass, summary, tagsHtml, totalRatingCount } = gameData;

      // Media
      if (videoId) {
        ghpIframe.src  = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=0&loop=1&playlist=${videoId}&rel=0&modestbranding=1&controls=0&disablekb=1&fs=0`;
        ghpIframe.style.display    = 'block';
        ghpScreenshot.style.display = 'none';
        ghpNoMedia.style.display   = 'none';
      } else if (screenshot) {
        ghpIframe.src  = 'about:blank';
        ghpIframe.style.display    = 'none';
        ghpScreenshot.style.backgroundImage = `url('${screenshot}')`;
        ghpScreenshot.style.display = 'block';
        ghpNoMedia.style.display   = 'none';
      } else {
        ghpIframe.src  = 'about:blank';
        ghpIframe.style.display    = 'none';
        ghpScreenshot.style.display = 'none';
        ghpNoMedia.style.display   = 'flex';
      }

      // Text content
      ghPanel.querySelector('.ghp-title').textContent   = name;
      ghPanel.querySelector('.ghp-release').textContent = `Released: ${releaseDate}`;
      ghPanel.querySelector('.ghp-reviews').innerHTML   = rating > 0
        ? `<div class="steam-review-label">Overall Reviews:</div>
           <div class="steam-review-status ${reviewClass}">${reviewStatus} (${Math.floor(totalRatingCount || 100).toLocaleString()})</div>`
        : '';
      ghPanel.querySelector('.ghp-description').textContent = summary;
      ghPanel.querySelector('.ghp-tags').innerHTML = tagsHtml;
      ghPanel.scrollTop = 0;

      // Position the panel above the hovered card (or below if not enough room)
      const PANEL_W = 320;
      const GAP = 10;
      const rect = cardEl.getBoundingClientRect();

      // Temporarily show at 0,0 to measure height
      ghPanel.style.visibility = 'hidden';
      ghPanel.style.display    = 'flex';
      ghPanel.style.flexDirection = 'column';
      const panelH = Math.min(ghPanel.scrollHeight, 520);

      // Horizontal: center panel on card, clamp to viewport
      let left = rect.left + rect.width / 2 - PANEL_W / 2;
      if (left < 8) left = 8;
      if (left + PANEL_W > window.innerWidth - 8) left = window.innerWidth - PANEL_W - 8;

      // Vertical: prefer above; fall back to below
      let top = rect.top - panelH - GAP;
      if (top < 8) top = rect.bottom + GAP;

      ghPanel.style.left = left + 'px';
      ghPanel.style.top  = top  + 'px';
      ghPanel.style.visibility = '';
      ghPanel.style.display    = '';

      ghPanel.classList.add('active');
    };

    const closePanel = () => {
      ghpHideTimer = setTimeout(() => {
        ghPanel.classList.remove('active');
        ghpIframe.src = 'about:blank';
      }, 150);
    };

    // Keep panel alive when mouse moves into it
    ghPanel.addEventListener('mouseenter', () => clearTimeout(ghpHideTimer));
    ghPanel.addEventListener('mouseleave', closePanel);

    try {
      let games = await fetchTrendingGames();
      // Fallback to hardcoded popular games if API fails
      if (!games || games.length === 0) {
        games = discoverGames.map((g, i) => ({
          name: g.name,
          coverUrl: g.img,
          rating: 80 + Math.floor(Math.random() * 15),
          summary: g.note || '',
          _fallback: true
        }));
      }
      // Take top 15
      const top = games.slice(0, 15);
      container.innerHTML = '';
      top.forEach((game, idx) => {
        const name = game.name || 'Unknown';
        let cover = game.coverUrl || game.cover?.url || '';
        if (cover.includes('t_thumb')) cover = cover.replace('t_thumb', 't_cover_big');
        if (cover.includes('t_micro')) cover = cover.replace('t_micro', 't_cover_big');
        const rating = (game.total_rating || game.rating) ? Math.round(game.total_rating || game.rating) : 0;

        let reviewStatus = 'No User Reviews', reviewClass = '';
        if (rating >= 95)      { reviewStatus = 'Overwhelmingly Positive'; reviewClass = 'positive'; }
        else if (rating >= 85) { reviewStatus = 'Very Positive';           reviewClass = 'positive'; }
        else if (rating >= 70) { reviewStatus = 'Mostly Positive';         reviewClass = 'positive'; }
        else if (rating >= 40) { reviewStatus = 'Mixed';                   reviewClass = 'mixed';    }
        else if (rating >  0)  { reviewStatus = 'Mostly Negative';         reviewClass = 'negative'; }

        const summary     = game.summary || game.note || '';
        const releaseDate = game.first_release_date
          ? new Date(game.first_release_date * 1000).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })
          : 'TBA';
        const tagsHtml    = (game.genres || []).slice(0, 6).map(g => `<span class="steam-tag">${g.name}</span>`).join('');
        const videoId     = (game.videos && game.videos.length > 0) ? game.videos[0].video_id : null;

        let screenshot = '';
        if (!videoId && game.screenshots && game.screenshots.length > 0) {
          screenshot = game.screenshots[0].url || '';
          if (screenshot.startsWith('//')) screenshot = 'https:' + screenshot;
          screenshot = screenshot.replace('t_thumb', 't_screenshot_med');
        }

        const coverImg = cover
          ? `<img src="${cover.startsWith('//') ? 'https:' + cover : cover}" alt="${name}" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 160 220%22 fill=%22%231e2d3a%22%3E%3Crect width=%22160%22 height=%22220%22/%3E%3Ctext x=%2280%22 y=%22110%22 fill=%22%235a6a7a%22 text-anchor=%22middle%22 font-size=%2222%22%3E🎮%3C/text%3E%3C/svg%3E'">`
          : `<div style="width:100%;height:220px;background:#1e2d3a;display:flex;align-items:center;justify-content:center;font-size:2rem;">🎮</div>`;

        const card = document.createElement('div');
        card.className = 'trending-card';
        card.style.animation = `fadeInUp 0.5s ease ${idx * 0.06}s both`;
        card.innerHTML = `
          <div class="trending-card-inner">
            <span class="trending-rank">#${idx + 1}</span>
            ${coverImg}
            <div class="trending-overlay">
              <div class="trending-name">${name}</div>
              ${rating ? `<div class="trending-rating">★ ${rating}%</div>` : ''}
            </div>
          </div>
        `;

        // Click → search
        card.addEventListener('click', () => {
          window.location.href = '/search?q=' + encodeURIComponent(name);
        });

        // Hover → populate + show global panel near this card
        const gameData = { name, videoId, screenshot, releaseDate, rating, reviewStatus, reviewClass, summary, tagsHtml, totalRatingCount: game.total_rating_count };
        card.addEventListener('mouseenter', () => openPanel(gameData, card));
        card.addEventListener('mouseleave', closePanel);

        container.appendChild(card);
      });
    } catch (err) {
      console.warn('[Dashboard] Trending games load error:', err);
      container.innerHTML = '<div class="text-muted small p-3">Could not load trending games.</div>';
    }
  }

  // ============================================================
  // Top 50 Modal
  // ============================================================
  document.getElementById('seeAllBtn')?.addEventListener('click', async () => {
    const modal = new bootstrap.Modal(document.getElementById('top50Modal'));
    const grid = document.getElementById('top50Grid');
    grid.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading top games...</div>';
    modal.show();
    try {
      const res = await fetch('/api/games/top', { credentials: 'include' });
      const games = res.ok ? await res.json() : [];
      if (!games.length) { grid.innerHTML = '<div class="text-muted text-center py-4">No games found.</div>'; return; }
      grid.innerHTML = '';
      games.forEach((game, idx) => {
        let cover = game.cover?.url || '';
        if (cover) {
          cover = cover.replace('t_thumb', 't_cover_big');
          if (!cover.startsWith('http')) cover = 'https:' + cover;
        }
        const rating = game.total_rating ? Math.round(game.total_rating) : '';
        const name = game.name || 'Unknown';
        const card = document.createElement('div');
        card.className = 'top50-card';
        card.innerHTML = `
              ${cover ? `<img src="${cover}" alt="${name}" loading="lazy" onerror="this.onerror=null;this.style.display='none'">` : '<div style="width:100%;aspect-ratio:3/4;background:#1e2d3a;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">🎮</div>'}
              <span class="top50-rank">#${idx + 1}</span>
              <div class="top50-info">
                <div class="top50-name">${name}</div>
                ${rating ? `<div class="top50-rating">★ ${rating}%</div>` : ''}
              </div>
            `;
        card.addEventListener('click', () => { window.location.href = '/search?q=' + encodeURIComponent(name); });
        grid.appendChild(card);
      });
    } catch (err) {
      grid.innerHTML = '<div class="text-muted text-center py-4">Failed to load games.</div>';
    }
  });

  // ============================================================
  // Navbar scroll effect
  // ============================================================
  // Navbar scroll shadow (passive, cached)
  const _nav = document.querySelector('.navbar');
  let _scrollTick = false;
  window.addEventListener('scroll', () => {
    if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
  }, { passive: true });

  // --- View Friend Review ---
  async function viewFriendReview(gameDataStr) {
    try {
      const gameData = JSON.parse(gameDataStr);
      // Redirect to search page with the game name, just like clicking a game in the library
      localStorage.setItem('bh_search_query', gameData.gameName);
      window.location.href = 'search';
    } catch (err) {
      console.error('Error viewing friend review:', err);
    }
  }
</script>

