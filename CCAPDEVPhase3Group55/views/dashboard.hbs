    { name: "Far Cry 5", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1nic.jpg", genre: "Action", genreTags: ["action"], minSession: 20, avgSession: 45, note: "Quick outpost runs" },
    { name: "Valorant", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2mvt.jpg", genre: "Tactical Shooter", genreTags: ["shooter", "action"], minSession: 15, avgSession: 35, note: "One comp match ~30 min" },
    { name: "League of Legends", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co49wj.jpg", genre: "MOBA", genreTags: ["moba", "action"], minSession: 25, avgSession: 40, note: "ARAM for quick games" },
    { name: "Hades", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2qx5.jpg", genre: "Roguelike", genreTags: ["roguelike", "action"], minSession: 15, avgSession: 25, note: "Perfect for short runs" },
    { name: "Stardew Valley", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/xrpmydnu9rpxvxfjkiu7.jpg", genre: "Farming Sim", genreTags: ["sim", "simulation", "farming"], minSession: 15, avgSession: 30, note: "Relaxed pace, save anytime" },
    { name: "Balatro", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co7kaq.jpg", genre: "Roguelike Deckbuilder", genreTags: ["roguelike", "puzzle"], minSession: 10, avgSession: 20, note: "One run = one sitting" },
    { name: "Hollow Knight", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1rgi.jpg", genre: "Metroidvania", genreTags: ["platformer", "action"], minSession: 20, avgSession: 45, note: "Bench saves are frequent" },
    { name: "Slay the Spire", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1iyf.jpg", genre: "Deckbuilder", genreTags: ["puzzle", "roguelike"], minSession: 15, avgSession: 30, note: "Turn-based, pause anytime" },
    { name: "Celeste", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co3byy.jpg", genre: "Platformer", genreTags: ["platformer", "action"], minSession: 15, avgSession: 30, note: "Short chapters, tight controls" },
    { name: "Persona 5 Royal", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2t97.jpg", genre: "JRPG", genreTags: ["rpg", "jrpg"], minSession: 45, avgSession: 90, note: "Story-heavy, plan long sessions" },
    { name: "Elden Ring", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co4jni.jpg", genre: "Action RPG", genreTags: ["action", "rpg", "action rpg"], minSession: 30, avgSession: 60, note: "Open world exploration" },
    { name: "Portal 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1rs4.jpg", genre: "Puzzle", genreTags: ["puzzle"], minSession: 20, avgSession: 40, note: "Clever puzzles, quick chapters" },
    { name: "Disco Elysium", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1sfj.jpg", genre: "RPG", genreTags: ["rpg"], minSession: 30, avgSession: 60, note: "Dialogue-heavy detective RPG" },
    { name: "The Witcher 3", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1wyy.jpg", genre: "Action RPG", genreTags: ["action", "rpg", "action rpg"], minSession: 40, avgSession: 80, note: "Incredible world-building" },
    { name: "Cyberpunk 2077", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2mdf.jpg", genre: "Action RPG", genreTags: ["action", "rpg", "action rpg"], minSession: 30, avgSession: 60, note: "Futuristic open world" },
    { name: "Minecraft", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co49x5.jpg", genre: "Sandbox", genreTags: ["sim", "simulation"], minSession: 10, avgSession: 40, note: "Infinite possibilities" },
    { name: "Grand Theft Auto V", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1qx8.jpg", genre: "Action", genreTags: ["action"], minSession: 30, avgSession: 60, note: "Los Santos awaits" },
    { name: "God of War", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1r8h.jpg", genre: "Action", genreTags: ["action"], minSession: 30, avgSession: 60, note: "Cinematic combat" },
    { name: "Resident Evil 4", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co5v96.jpg", genre: "Horror", genreTags: ["action"], minSession: 20, avgSession: 45, note: "Survival horror at its best" },
    { name: "Dota 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1n00.jpg", genre: "MOBA", genreTags: ["moba", "action"], minSession: 35, avgSession: 50, note: "Intense team battles" },
    { name: "Among Us", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2nl0.jpg", genre: "Social Deduction", genreTags: ["puzzle"], minSession: 5, avgSession: 15, note: "Find the imposter" },
    { name: "Apex Legends", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2v6i.jpg", genre: "Battle Royale", genreTags: ["shooter", "action"], minSession: 15, avgSession: 30, note: "Fast-paced hero shooter" }
  ];

  let dashboardLibraryCache = null;

  async function getMyLibrary() {
    if (dashboardLibraryCache) return dashboardLibraryCache;
    try {
      const userId = currentUser && (currentUser._id || currentUser.id);
      if (!userId) return [];
      const res = await fetch('/api/library/' + userId, { credentials: 'include' });
      if (!res.ok) return [];
      const entries = await res.json();
      dashboardLibraryCache = entries.filter(e => e.gameId).map(e => ({
        name: e.gameId.name || 'Unknown',
        genre: (e.gameId.genres || []).join(' • ') || 'Game',
        cover: e.gameId.coverUrl || '',
        status: e.status,
        rating: e.rating || 0
      }));
      return dashboardLibraryCache;
    } catch (err) {
      console.error('[Dashboard] Library fetch error:', err);
      return [];
    }
  }

  async function getLibraryGames(totalMins) {
    const lib = await getMyLibrary();
    const playable = lib.filter(g => g.status === 'backlog' || g.status === 'playing');
    if (playable.length === 0) return null;
    return playable.map(g => ({
      name: g.name,
      img: g.cover || '',
      genre: g.genre || 'Game',
      avgSession: 30,
      minSession: 15,
      note: g.status === 'playing' ? 'Continue where you left off' : 'Sitting in your backlog',
      fromLibrary: true
    }));
  }

  async function getNewGames(totalMins) {
    const lib = await getMyLibrary();
    const libNames = lib.map(g => g.name.toLowerCase());
    return discoverGames.filter(g => !libNames.includes(g.name.toLowerCase()));
  }

  const planInput = document.getElementById("planMinutes");
  const planBtn = document.getElementById("planSuggestBtn");
  const planResult = document.getElementById("planResult");
  const planHours = document.getElementById("planHours");

  planBtn.addEventListener("click", suggestGame);
  planInput.addEventListener("keydown", (e) => { if (e.key === "Enter") suggestGame(); });
  planHours.addEventListener("keydown", (e) => { if (e.key === "Enter") suggestGame(); });

  async function suggestGame() {
    const hours = parseInt(planHours.value) || 0;
    const mins = parseInt(planInput.value) || 0;
    const totalMins = (hours * 60) + mins;
    const source = document.querySelector('input[name="planSource"]:checked').value;

    if (totalMins < 1) {
      planResult.innerHTML = `<p class="mb-0 small text-warning">Please enter at least 1 minute of available time.</p>`;
      return;
    }

    let pool;
    if (source === 'library') {
      pool = await getLibraryGames(totalMins);
      if (!pool || pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-warning">Your library is empty! Add some games first, or try "Try Something New".</p>`;
        return;
      }
    } else {
      pool = await getNewGames(totalMins);
      if (pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-info">You already have all our suggestions! Nice collection.</p>`;
        return;
      }
    }

    // Filter games that fit within the available time
    const fits = pool.filter(g => g.minSession <= totalMins);
    if (fits.length === 0) {
      planResult.innerHTML = `<p class="mb-0 small text-warning">No games fit in ${hours}h ${mins}m. Try adding more time!</p>`;
      return;
    }

    // Fisher-Yates Shuffle for true randomness
    const shuffle = (array) => {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    };

    const shuffled = shuffle([...fits]);
    const selected = shuffled.slice(0, 3);
    
    let html = '';
    selected.forEach((pick, index) => {
      const sessions = Math.max(1, Math.floor(totalMins / pick.avgSession));
      const imgTag = pick.img
        ? `<img src="${pick.img}" style="width:60px;height:85px;border-radius:4px;object-fit:cover;border:1px solid rgba(255,255,255,0.1);flex-shrink:0;" alt="${pick.name}" loading="lazy">`
        : `<div style="width:60px;height:85px;border-radius:4px;background:#2a3843;display:flex;align-items:center;justify-content:center;color:#6f7d8a;flex-shrink:0;"><i class="bi bi-controller"></i></div>`;

      const sourceLabel = pick.fromLibrary
        ? '<span class="badge bg-primary" style="font-size:0.55rem; padding: 2px 6px;">Lib</span>'
        : '<span class="badge bg-success" style="font-size:0.55rem; padding: 2px 6px;">New</span>';

      html += `
        <div class="suggestion-item" style="animation: fadeInScale 0.3s ease forwards ${index * 0.1}s; opacity:0; transform:scale(0.95);">
          ${imgTag}
          <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px;">
            <div style="min-width: 0;">
              <div style="display: flex; align-items: center; gap: 4px;">
                <p style="font-size: 0.8rem; font-weight: 700; color: var(--text); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${pick.name}</p>
                ${sourceLabel}
              </div>
              <small class="text-info" style="font-size:0.7rem; font-weight:600; display: block;">~${pick.avgSession}m · ${sessions > 1 ? sessions + 'x' : '1x'}</small>
            </div>
          </div>
        </div>
      `;
    });
    planResult.innerHTML = html;

    // Highlight animation
    planResult.classList.add("highlight");
    setTimeout(() => planResult.classList.remove("highlight"), 1200);
  }

  // ============================================================
  // Post Update — adds new feed items to the activity feed
  // ============================================================

  let currentUser = null;

  const typeLabels = {
    "session": "logged a session",
    "review": "reviewed a game",
    "completed": "completed a game",
    "playing": "started playing"
  };

  const updateType = document.getElementById("updateType");
  const ratingGroup = document.getElementById("ratingGroup");

  // Photo upload handling
  let selectedPhoto = null;
  const photoUploadArea = document.getElementById("photoUploadArea");
  const photoInput = document.getElementById("photoInput");
  const photoPreviewContainer = document.getElementById("photoPreviewContainer");

  photoUploadArea.addEventListener("click", () => photoInput.click());
  photoInput.addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        alert("Photo must be less than 5MB");
        return;
      }
      const reader = new FileReader();
      reader.onload = (event) => {
        selectedPhoto = event.target.result;
        photoUploadArea.classList.add("has-photo");
        photoUploadArea.innerHTML = `<img src="${selectedPhoto}" class="photo-preview-img" alt="Preview" loading="lazy">`;
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "btn btn-sm btn-outline-danger photo-remove-btn";
        removeBtn.textContent = "Remove Photo";
        removeBtn.style.alignSelf = "flex-end";
        removeBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          selectedPhoto = null;
          photoInput.value = "";
          photoUploadArea.classList.remove("has-photo");
          photoUploadArea.innerHTML = `<i class="bi bi-image" style="font-size: 1.5rem; color: #5383e8;"></i><p class="mb-0 mt-2 small">Click to upload a screenshot</p>`;
        });
        photoUploadArea.appendChild(removeBtn);
      };
      reader.readAsDataURL(file);
    }
  });

  // Show/hide rating when type changes
  updateType.addEventListener("change", () => {
    ratingGroup.style.display = updateType.value === "review" ? "block" : "none";
  });

  document.getElementById("submitUpdateBtn").addEventListener("click", async () => {
    const type = updateType.value;
    const game = document.getElementById("updateGame").value;
    const comment = document.getElementById("updateComment").value.trim();
    const rating = document.getElementById("updateRating").value;
    const errorEl = document.getElementById("updateError");
    const submitBtn = document.getElementById("submitUpdateBtn");

    if (!comment) {
      errorEl.textContent = "Please write a comment.";
      errorEl.style.display = "block";
      return;
    }

    errorEl.style.display = "none";
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Posting...';
    
    // Warn if photo is very large
    if (selectedPhoto && selectedPhoto.length > 10 * 1024 * 1024) {
      console.warn('Warning: Photo is very large (' + (selectedPhoto.length / 1024 / 1024).toFixed(2) + 'MB) - upload may take a while');
    }
    
    // Save to backend first
    try {
      const controller = new AbortController();
      const uploadTimeout = selectedPhoto ? 60000 : 15000; // 60s for photos, 15s for text
      const timeoutId = setTimeout(() => controller.abort(), uploadTimeout);
      
      const res = await fetch('/api/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        signal: controller.signal,
        body: JSON.stringify({
          title: `Logged a session${type === 'review' ? ' - Review' : type === 'completed' ? ' - Completed' : type === 'playing' ? ' - Now Playing' : ''}`,
          body: comment,
          game: game,
          flair: 'Progress',
          rating: type === 'review' ? parseInt(rating) : null,
          photo: selectedPhoto || null
        })
      });
      
      clearTimeout(timeoutId);

      if (!res.ok) {
        throw new Error('Failed to save post');
      }

      // Close modal and reset form
      const modal = bootstrap.Modal.getInstance(document.getElementById("postUpdateModal"));
      modal.hide();
      document.getElementById("updateComment").value = "";
      updateType.value = "session";
      ratingGroup.style.display = "none";

      // Reset photo
      selectedPhoto = null;
      photoInput.value = "";
      photoUploadArea.classList.remove("has-photo");
      photoUploadArea.innerHTML = `<i class="bi bi-image" style="font-size: 1.5rem; color: #5383e8;"></i><p class="mb-0 mt-2 small">Click to upload a screenshot</p>`;

      // Reload activity feed
      await loadActivityFeed(currentUserData);

      // Show success toast
      const toast = document.createElement('div');
      toast.style.cssText = `
        position: fixed; bottom: 20px; right: 20px;
        background: #10b981; color: white; padding: 12px 20px;
        border-radius: 8px; z-index: 10000; animation: slideIn 0.3s ease;
        font-weight: 600; font-size: 0.95rem;
      `;
      toast.textContent = 'Update posted!';
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
      
      // Restore button state
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Post Update';
    } catch (err) {
      console.error('Error posting update:', err);
      errorEl.textContent = "Failed to post update. Please try again.";
      errorEl.style.display = "block";
      
      // Restore button state on error
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Post Update';
    }
  });
</script>
