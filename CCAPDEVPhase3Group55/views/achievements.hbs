<!-- Achievements Guide Page -->

<style>
  :root {
    --bg-deep: #0b0e14;
    --bg-primary: #0f1419;
    --bg-secondary: #1a1f2e;
    --bg-tertiary: #242d3d;
    --accent: #5383e8;
    --accent-glow: rgba(83, 131, 232, 0.3);
    --blue-accent: #2dd4bf;
    --text-primary: #e4e6eb;
    --text-secondary: #9ca3af;
    --text-tertiary: #6b7280;
    --border: rgba(255, 255, 255, 0.08);
    --success: #34d399;
  }

  body {
    background-color: var(--bg-deep) !important;
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
  }

  .back-btn-container {
    max-width: 1200px;
    margin: 20px auto 0;
    padding: 0 20px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: rgba(83, 131, 232, 0.1);
    border: 1px solid rgba(83, 131, 232, 0.3);
    border-radius: 6px;
    color: #5383e8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .back-btn:hover {
    background: rgba(83, 131, 232, 0.2);
    border-color: rgba(83, 131, 232, 0.5);
  }

  .achievements-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .achievements-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .achievements-header h1 {
    font-size: 3rem;
    font-weight: 900;
    background: linear-gradient(135deg, #fff 0%, #c9c9ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 12px;
  }

  .achievements-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 28px;
  }

  .achievement-card {
    background: linear-gradient(135deg, rgba(83, 131, 232, 0.08) 0%, rgba(91, 127, 238, 0.08) 100%);
    border: 1px solid rgba(83, 131, 232, 0.3);
    border-radius: 16px;
    padding: 30px;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
  }

  .achievement-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent, rgba(255, 255, 255, 0.05), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .achievement-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(83, 131, 232, 0.15) 0%, rgba(91, 127, 238, 0.15) 100%);
    box-shadow: 0 20px 50px rgba(83, 131, 232, 0.25);
  }

  .achievement-card:hover::before {
    opacity: 1;
  }

  .achievement-icon-wrapper {
    font-size: 3rem;
    color: var(--accent);
    margin-bottom: 16px;
    display: inline-block;
  }

  .achievement-badge {
    background: rgba(83, 131, 232, 0.2);
    color: var(--accent);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-block;
    margin-bottom: 16px;
  }

  .achievement-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 12px;
  }

  .achievement-requirement {
    background: rgba(83, 131, 232, 0.1);
    border-left: 3px solid var(--accent);
    padding: 12px 16px;
    border-radius: 6px;
    margin-bottom: 16px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .achievement-requirement-label {
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .achievement-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .achievement-tips {
    background: rgba(45, 212, 191, 0.08);
    border-left: 3px solid #2dd4bf;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 0.9rem;
    color: #2dd4bf;
  }

  .achievement-tips strong {
    color: #fff;
  }

  .tier-section {
    margin-bottom: 50px;
  }

  .tier-title {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 3px solid rgba(83, 131, 232, 0.3);
    display: inline-block;
  }

  .tier-bronze .tier-title {
    color: #cd7f32;
  }

  .tier-silver .tier-title {
    color: #c0c0c0;
  }

  .tier-gold .tier-title {
    color: #ffd700;
  }

  .tier-diamond .tier-title {
    color: #2dd4bf;
  }

  .tier-bronze .achievement-card {
    border-color: rgba(205, 127, 50, 0.3);
  }

  .tier-bronze .achievement-icon-wrapper {
    color: #cd7f32;
  }

  .tier-silver .achievement-card {
    border-color: rgba(192, 192, 192, 0.3);
  }

  .tier-silver .achievement-icon-wrapper {
    color: #c0c0c0;
  }

  .tier-gold .achievement-card {
    border-color: rgba(255, 215, 0, 0.3);
  }

  .tier-gold .achievement-icon-wrapper {
    color: #ffd700;
  }

  .tier-diamond .achievement-card {
    border-color: rgba(45, 212, 191, 0.3);
  }

  .tier-diamond .achievement-icon-wrapper {
    color: #2dd4bf;
  }

  .xp-reward-badge {
    background: linear-gradient(135deg, #5383e8, #2dd4bf);
    color: #fff;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .achievements-header h1 {
      font-size: 2rem;
    }

    .achievements-grid {
      grid-template-columns: 1fr;
    }

    .tier-title {
      font-size: 1.4rem;
    }
  }
</style>

