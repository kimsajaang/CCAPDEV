  <script>
    // IMMEDIATE AUTH CHECK - runs synchronously before anything else
    // This controls the preview banner and runs FIRST
    let bannerHidden = false;
    
    (async () => {
      try {
        const res = await fetch('/api/auth/current', { credentials: 'include' });
        const banner = document.getElementById('preview-banner');
        
        if (res.ok) {
          // User IS logged in
          if (banner) banner.style.setProperty('display', 'none', 'important');
          bannerHidden = true;
          console.log('[Immediate Auth] LOGGED IN - banner hidden');
        } else {
          // User is NOT logged in (401/403)
          if (banner) banner.style.setProperty('display', 'flex', 'important');
          console.log('[Immediate Auth] NOT logged in - banner shown');
        }
      } catch (e) {
        // Network error - hide banner to not block user
        const banner = document.getElementById('preview-banner');
        if (banner) banner.style.setProperty('display', 'none', 'important');
        console.error('[Immediate Auth] Error:', e.message);
      }
    })();

    // ============================================================
    // Every is stored in MongoDB via backend API
    // ============================================================
    window.addEventListener('load', () => {

    // localStorage key — versioned so we can change the schema without breaking old data
    const STORAGE_KEY = "bh_community_posts_v1";

    // Track login status globally
    let isUserLoggedIn = false;
    let currentUsername = 'Gamer';
    let currentUserId = null;
    let currentUserAvatar = null;
    let authCheckComplete = false;

    // Single auth check - combines auth detection and community preview logic in one call
    async function checkAuthAndShowContent(retries = 1) {
      try {
        const response = await fetch('/api/auth/current', {
          method: 'GET',
          credentials: 'include'
        });

        if (response.ok) {
          isUserLoggedIn = true;
          const userData = await response.json();
          currentUserId = userData._id;
          currentUsername = userData.displayName || userData.username || 'Gamer';
          currentUserAvatar = userData.avatar;
          console.log('[Auth] SUCCESS - User logged in:', currentUsername);
        } else if (response.status === 401 || response.status === 403) {
          // Definitely not logged in
          isUserLoggedIn = false;
          window.limitCommunityPreview = true;
          console.log('[Auth] User not logged in (401/403)');
        } else {
          console.warn('[Auth] Server error:', response.status, '- retrying...');
          if (retries > 0) {
            await new Promise(r => setTimeout(r, 2000));
            return checkAuthAndShowContent(retries - 1);
          }
          // After retry still failing — assume logged in to avoid false logouts
          console.warn('[Auth] Server errors persisted, keeping current auth state');
          return;
        }

        const protectedSections = document.querySelectorAll('[data-auth-required="true"]');
        const previewSections = document.querySelectorAll('[data-preview-only="true"]');

        if (isUserLoggedIn) {
          protectedSections.forEach(el => el.style.display = '');
          previewSections.forEach(el => el.style.display = 'none');
          // Banner was already hidden by immediate check, don't override
        } else {
          protectedSections.forEach(el => el.style.display = 'none');
          previewSections.forEach(el => el.style.display = '');
          // Banner is controlled by immediate check only
        }
      } catch (err) {
        console.error('Auth check failed:', err);
        // Network error — retry once
        if (retries > 0) {
          await new Promise(r => setTimeout(r, 2000));
          return checkAuthAndShowContent(retries - 1);
        }
        // Don't change login state on persistent network errors
      } finally {
        authCheckComplete = true;
      }
    }

    // Check auth immediately (no delay) and hide banner if logged in
    checkAuthAndShowContent().then(() => {
      console.log('[Auth] Check complete, isUserLoggedIn =', isUserLoggedIn);
      // Explicitly hide banner for logged-in users
      const previewBanner = document.getElementById('preview-banner');
      if (previewBanner) {
        if (isUserLoggedIn) {
          previewBanner.style.setProperty('display', 'none', 'important');
        } else {
          previewBanner.style.setProperty('display', 'flex', 'important');
        }
      }
    });

    // Handle New Post button clicks - verify auth before opening modal
    document.querySelectorAll('#newPostTopBtn, #newPostEmptyBtn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (!isUserLoggedIn) {
          e.preventDefault();
          e.stopPropagation();
          // Double-check auth before redirecting (in case initial check failed due to cold start)
          try {
            const res = await fetch('/api/auth/current', { credentials: 'include' });
            if (res.ok) {
              isUserLoggedIn = true;
              const userData = await res.json();
              currentUserId = userData._id;
              currentUsername = userData.displayName || userData.username || 'Gamer';
              currentUserAvatar = userData.avatar;
              // Show protected elements and open modal
              document.querySelectorAll('[data-auth-required="true"]').forEach(el => el.style.display = '');
              document.querySelectorAll('[data-preview-only="true"]').forEach(el => el.style.display = 'none');
              const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('newPostModal'));
              modal.show();
              return;
            }
          } catch (_) {}
          // Truly not logged in
          window.location.href = '/login';
        }
      });
    });

    const nowIso = () => new Date().toISOString();
    const fmtTime = (iso) => {
      const d = new Date(iso);
      return d.toLocaleString(undefined, { year: "numeric", month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
    };
    const escapeHtml = (s) => (s || "").replace(/[&<>"']/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;" }[c]));

    // --- Data layer: backend API calls ---
    // --- CACHE & LAZY LOAD OPTIMIZATIONS ---
    let cachedPosts = null;
    let currentPage = 0;
    let isLoadingMore = false;
    let allPostsLoaded = false;
    const photoCache = new Map();
    const commentCache = new Map();

    async function loadPosts(retries = 1) {
      try {
        const page = currentPage;
        const res = await fetch(`/api/posts?page=${page}`, { credentials: 'include' });
        if (!res.ok) throw new Error('Fetch failed: ' + res.status);
        const newPosts = await res.json();
        
        if (newPosts.length < 20) allPostsLoaded = true;
        
        if (page === 0) {
          cachedPosts = newPosts;
        } else {
          cachedPosts = [...(cachedPosts || []), ...newPosts];
        }
        
        console.log(`[loadPosts] Loaded page ${page}: ${newPosts.length} posts`);
        return newPosts;
      } catch (e) {
        console.error('Failed to load posts:', e);
        if (retries > 0) {
          console.log('[loadPosts] Retrying in 2s...');
          await new Promise(r => setTimeout(r, 2000));
          return loadPosts(retries - 1);
        }
        return [];
      }
    }

    async function savePosts(postData) {
      // No longer used for saving everything at once, handled by create/vote/comment endpoints
    }

    // Migration helper — makes sure every post has an id, comments array, and vote counts.
    // Needed because early test data didn't have all fields and it was crashing
    function ensureIds(posts) {
      let changed = false;
      for (const p of posts) {
        if (!p.id) { p.id = crypto.randomUUID(); changed = true; }
        if (!Array.isArray(p.comments)) { p.comments = []; changed = true; }
        if (typeof p.up !== "number") { p.up = 0; changed = true; }
        if (typeof p.down !== "number") { p.down = 0; changed = true; }
      }
      if (changed) savePosts(posts);
      return posts;
    }

    function score(post) {
      // Support both optimized (upvoteCount/downvoteCount numbers) and legacy (upvotes/downvotes arrays)
      const up = typeof post.upvoteCount === 'number' ? post.upvoteCount
               : Array.isArray(post.upvotes) ? post.upvotes.length
               : (post.upvotes || 0);
      const down = typeof post.downvoteCount === 'number' ? post.downvoteCount
                 : Array.isArray(post.downvotes) ? post.downvotes.length
                 : (post.downvotes || 0);
      return up - down;
    }

    // Hot score algorithm — loosely based on Reddit's formula.
    // Divides net votes by age^0.7 so newer posts with fewer votes can still rank high
    function hotScore(post) {
      const v = score(post);
      const created = post.createdAt ? new Date(post.createdAt).getTime() : Date.now();
      const ageHours = Math.max(1, (Date.now() - created) / 36e5);
      return v / Math.pow(ageHours, 0.7);
    }

    function sortPosts(posts, mode) {
      const list = [...posts];
      if (mode === "new") {
        list.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
      } else if (mode === "top") {
        list.sort((a,b) => score(b) - score(a));
      } else {
        list.sort((a,b) => hotScore(b) - hotScore(a));
      }
      return list;
    }

    function matchesSearch(post, q) {
      if (!q) return true;
      const hay = (post.title + " " + (post.body||"") + " " + (post.game||"") + " " + (post.flair||"")).toLowerCase();
      return hay.includes(q.toLowerCase());
    }

    const feedEl = document.getElementById("feed");
    const emptyEl = document.getElementById("emptyState");
    const sortSelect = document.getElementById("sortSelect");
    const searchInput = document.getElementById("searchInput");

    // --- OPTIMIZED RENDER WITH CACHING ---
    async function render() {
      console.log('[RENDER] Starting render...');
      
      // Use cached posts if available, otherwise load fresh
      let posts = cachedPosts || (await loadPosts());
      if (!posts) posts = [];
      
      const mode = sortSelect.value;
      const q = searchInput.value.trim();

      // Apply filtering & sorting
      posts = sortPosts(posts, mode).filter(p => matchesSearch(p, q));

      feedEl.innerHTML = "";
      if (posts.length === 0) {
        if (isUserLoggedIn) {
          emptyEl.classList.remove("d-none");
        } else {
          emptyEl.classList.add("d-none");
        }
        return;
      }
      emptyEl.classList.add("d-none");

      // Only render posts (don't load photos yet)
      for (const post of posts) {
        feedEl.appendChild(postCard(post));
      }
      
      console.log('[RENDER] Render complete - ' + posts.length + ' posts');
      
      // Setup lazy loading for visible photos
      if (!('IntersectionObserver' in window)) return;

      const photoPlaceholders = document.querySelectorAll('[data-photo-id]');
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const postId = entry.target.dataset.photoId;
            loadAndShowPhoto(postId, entry.target);
            observer.unobserve(entry.target);
          }
        }
      }, { rootMargin: '100px' });

      photoPlaceholders.forEach(el => observer.observe(el));
    }

    // Load photo when visible
    async function loadAndShowPhoto(postId, placeholder) {
      if (photoCache.has(postId)) {
        const photoUrl = photoCache.get(postId);
        showPhotoInContainer(placeholder, photoUrl);
        return;
      }

      try {
        const res = await fetch(`/api/posts/${postId}/photo`);
        if (!res.ok) return;
        const data = await res.json();
        photoCache.set(postId, data.photo);
        showPhotoInContainer(placeholder, data.photo);
      } catch (err) {
        console.warn('[Photo lazy load] Error for post ' + postId, err);
      }
    }

    function showPhotoInContainer(container, photoUrl) {
      const parent = container.parentElement;
      const isVideo = photoUrl.startsWith('data:video/');
      
      if (isVideo) {
        const typeMatch = photoUrl.match(/data:([^;]+)/);
        const videoType = (typeMatch && typeMatch[1]) || 'video/mp4';
        const videoEl = document.createElement('video');
        videoEl.className = 'community-post-photo';
        videoEl.controls = true;
        videoEl.style.cssText = 'max-width:100%;width:100%;border-radius:8px;margin:12px 0;border:1px solid var(--border);';
        videoEl.innerHTML = `<source src="${photoUrl}" type="${videoType}">Your browser does not support video.`;
        container.replaceWith(videoEl);
      } else {
        container.src = photoUrl;
        container.style.opacity = '1';
        container.style.border = '1px solid var(--border)';
      }
    }

