        video.src = dataUrl;
        video.className = "community-photo-preview-img";
        video.controls = true;
        video.style.cssText = "max-width:100%;max-height:300px;background:#000;border-radius:8px;";
        previewContainer.appendChild(video);
      } else {
        const img = document.createElement("img");
        img.src = dataUrl;
        img.className = "community-photo-preview-img";
        img.alt = "Preview";
        previewContainer.appendChild(img);
      }
      
      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "btn btn-sm btn-outline-danger community-photo-remove-btn mt-2";
      removeBtn.innerHTML = '<i class="bi bi-trash3 me-1"></i>Remove Media';
      removeBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        editSelectedPhoto = null;
        document.getElementById("editPhotoPreviewContainer").style.display = "none";
        document.getElementById("editPhotoUploadArea").style.display = "block";
        document.getElementById("editPhotoInput").value = "";
      });
      previewContainer.appendChild(removeBtn);
    }

    const editPhotoInput = document.getElementById("editPhotoInput");
    const editPhotoUploadArea = document.getElementById("editPhotoUploadArea");
    
    editPhotoUploadArea.addEventListener("click", () => editPhotoInput.click());
    
    editPhotoInput.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const isVideo = file.type.startsWith('video/');
      const maxSize = 10 * 1024 * 1024; // 10MB

      if (isVideo && file.size > maxSize) {
        alert(`Video too large! Maximum is ${maxSize / (1024 * 1024).toFixed(0)}MB. Your video is ${(file.size / (1024 * 1024)).toFixed(1)}MB.`);
        return;
      }

      if (isVideo) {
        const reader = new FileReader();
        reader.onload = (event) => showEditMediaPreview(event.target.result, true);
        reader.readAsDataURL(file);
      } else {
        try {
          const compressed = await compressImage(file, 1200, 0.8);
          showEditMediaPreview(compressed, false);
        } catch (err) {
          const reader = new FileReader();
          reader.onload = (event) => showEditMediaPreview(event.target.result, false);
          reader.readAsDataURL(file);
        }
      }
    });

    communityPhotoInput.addEventListener("change", async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const isVideo = file.type.startsWith('video/');
      const maxSize = isVideo ? 10 * 1024 * 1024 : 10 * 1024 * 1024; // 10MB for both after compression

      if (isVideo && file.size > maxSize) {
        postError.style.display = "block";
        postError.className = "alert alert-danger alert-dismissible fade show mb-0";
        postError.innerHTML = `<i class="bi bi-exclamation-circle me-2"></i><strong>Video too large!</strong> Maximum video size is 10MB. Your video is ${(file.size / (1024 * 1024)).toFixed(1)}MB. Try a shorter clip or compress it first.<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        return;
      }

      if (isVideo) {
        // Read video as-is (already size-checked above)
        const reader = new FileReader();
        reader.onload = (event) => showMediaPreview(event.target.result, true);
        reader.readAsDataURL(file);
      } else {
        // Compress image client-side to reduce payload
        try {
          const compressed = await compressImage(file, 1200, 0.8);
          showMediaPreview(compressed, false);
        } catch (err) {
          // Fallback: read original file
          const reader = new FileReader();
          reader.onload = (event) => showMediaPreview(event.target.result, false);
          reader.readAsDataURL(file);
        }
      }
    });

    createPostBtn.addEventListener("click", () => {
      const title = postTitle.value.trim();
      const body = postBody.value.trim();
      const flair = postFlair.value;
      const game = postGame.value.trim();

      if (title.length < 3) {
        postError.style.display = "block";
        postError.textContent = "Title must be at least 3 characters.";
        return;
      }

      // Check payload size before sending — Render free tier & MongoDB have limits
      const postPayload = {
        title,
        body,
        flair,
        game,
        photo: communitySelectedPhoto
      };
      const payloadStr = JSON.stringify(postPayload);
      const payloadSizeMB = payloadStr.length / (1024 * 1024);
      
      if (payloadSizeMB > 15) {
        postError.style.display = "block";
        postError.className = "alert alert-danger alert-dismissible fade show mb-0";
        postError.innerHTML = `<i class="bi bi-exclamation-circle me-2"></i><strong>Media too large for upload!</strong> Total post size is ${payloadSizeMB.toFixed(1)}MB (max ~15MB). Try a smaller image or shorter video clip.<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
        return;
      }

      // Disable button while posting
      createPostBtn.disabled = true;
      createPostBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Posting...';

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 30000); // 30s timeout

      console.log('[COMMUNITY POST] Sending request:', { title, flair, game, hasPhoto: !!communitySelectedPhoto });

      fetch('/api/posts', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: payloadStr,
        signal: controller.signal
      })
      .then(res => {
        clearTimeout(timeoutId);
        console.log('[COMMUNITY POST] Response received:', res.status, res.statusText);
        if (!res.ok) {
          return res.json().then(err => {
            console.error('[COMMUNITY POST] Server error response:', err);
            return Promise.reject(err || { error: `Server error (${res.status})` });
          }).catch(parseErr => {
            console.error('[COMMUNITY POST] Could not parse error response:', parseErr);
            return Promise.reject({ error: `Server error (${res.status}). Check console for details.` });
          });
        }
        return res.json();
      })
      .then(post => {
        console.log('[COMMUNITY POST] Post created successfully:', post.id);
        postTitle.value = "";
        postBody.value = "";
        postGame.value = "";
        postFlair.value = "Discussion";
        postError.style.display = "none";
        postError.textContent = "";
        resetPhotoUpload();
        newPostModal.hide();
        location.hash = "post-" + post.id;
        
        // Update local cache to reflect changes instantly without manual refresh
        if (cachedPosts) {
          cachedPosts.unshift(post);
        } else {
          cachedPosts = [post];
        }
        
        render();
        
        // Immediately load photo for newly created post (don't wait for lazy loading)
        setTimeout(() => {
          const newPostCard = document.querySelector(`[data-post-id="${post.id}"]`);
          if (newPostCard) {
            const photoPlaceholder = newPostCard.querySelector('[data-photo-id]');
            if (photoPlaceholder) {
              console.log('[NEW POST] Loading photo immediately for new post:', post.id);
              loadAndShowPhoto(post.id, photoPlaceholder);
            }
          }
          updateSidebarStats();
        }, 100);
      })
      .catch(err => {
        clearTimeout(timeoutId);
        console.error('[COMMUNITY POST] Error:', err);
        postError.style.display = "block";
        postError.className = "alert alert-danger alert-dismissible fade show mb-0";
        let errMsg = err.error || err.message || 'Failed to create post.';
        
        // Check for specific error types
        if (err.name === 'AbortError') {
          errMsg = 'Request timeout (30s) — the server did not respond. Check if the server is running.';
        } else if (errMsg.includes('Unauthorized')) {
          errMsg = 'Not logged in. Please log in again.';
        } else if (errMsg.includes('Failed to fetch') || errMsg.includes('NetworkError')) {
          errMsg = 'Network error. Check if the server is running.';
        }
        postError.innerHTML = `<i class="bi bi-exclamation-circle me-2"></i>${errMsg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
      })
      .finally(() => {
        createPostBtn.disabled = false;
        createPostBtn.innerHTML = 'Post';
      });
    });

    document.getElementById("savePostEditBtn").addEventListener("click", savePostEdit);

    sortSelect.addEventListener("change", render);
    searchInput.addEventListener("input", () => {
      clearTimeout(window.__bhSearchT);
      window.__bhSearchT = setTimeout(render, 350);
    });

    // --- Auto-seed: pre-made sample posts seeded on first visit ---
    function seedDefaultPosts() {
      // Backend handles seeding or starts empty. 
    }

    seedDefaultPosts();

    // Update sidebar stats using lightweight stats endpoint
    async function updateSidebarStats() {
      try {
        const res = await fetch('/api/posts/stats', { credentials: 'include' });
        if (!res.ok) throw new Error('Stats fetch failed');
        const stats = await res.json();
        document.getElementById('statTotalPosts').textContent = stats.totalPosts || 0;
        document.getElementById('statTotalComments').textContent = stats.totalComments || 0;
        document.getElementById('statActiveMembers').textContent = stats.activeMembers || 0;
      } catch (e) {
        console.error('Failed to load stats:', e);
        // Fallback: compute from already-loaded feed posts
        const feedCards = document.querySelectorAll('[data-post-id]');
        document.getElementById('statTotalPosts').textContent = feedCards.length;
      }
    }

    // Deep-link handler — if URL has #post-<id>, scroll to that post and open its comments.
    // Used by the "Copy Link" share feature
    function openCommentsForHash() {
      if (!location.hash.startsWith("#post-")) return;
      const id = location.hash.replace("#post-", "");
      const card = document.querySelector(`[data-post-id="${id}"]`);
      if (!card) return;

      const commentsWrap = card.querySelector("[data-comments]");
      if (commentsWrap) commentsWrap.classList.remove("d-none");

      card.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    // Wait for auth check, then fire posts + stats in parallel for fastest initial load
    (async () => {
      // Wait for auth to be checked before rendering posts
      let waitCount = 0;
      while (!authCheckComplete && waitCount < 100) {
        await new Promise(r => setTimeout(r, 50));
        waitCount++;
      }
      console.log('[RENDER] Auth complete after', waitCount * 50, 'ms. isUserLoggedIn =', isUserLoggedIn);
      
      // Render with correct auth status
      await Promise.all([render(), updateSidebarStats()]);
      setTimeout(() => openCommentsForHash(), 150);
    })();

    // Logout function
    async function logout(event) {
      event.preventDefault();
      try {
          await fetch('/api/auth/logout', {
              method: 'POST',
              credentials: 'include'
          });
          window.location.href = '/login';
      } catch (err) {
          console.error('Logout failed:', err);
          window.location.href = '/login';
      }
    }

    // Smart home navigation - if logged in go to dashboard, else go to index
    async function smartHomeClick(e) {
      e.preventDefault();
      try {
        const res = await fetch('/api/auth/current', { credentials: 'include' });
        const dest = res.ok ? '/dashboard' : '/';
        document.body.classList.add('page-exit');
        setTimeout(() => window.location = dest, 300);
      } catch (err) {
        console.error('Auth check failed:', err);
        window.location = '/';
      }
    }

    // Page exit transition
    document.querySelectorAll('a[href]').forEach(a => {
      if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
        a.addEventListener('click', e => {
          e.preventDefault();
          const dest = a.href;
          document.body.classList.add('page-exit');
          setTimeout(() => window.location = dest, 300);
        });
      }
    });

    // Navbar scroll shadow (passive, cached)
    const _nav = document.querySelector('.navbar');
    let _scrollTick = false;
    window.addEventListener('scroll', () => {
      if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
    }, { passive: true });

    // Loader is now hidden by render().then() above — no need for a separate timer
    }); // End of window load
  </script>
