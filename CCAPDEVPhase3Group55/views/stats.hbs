    // --- Actions: vote, comment, delete, share ---
    const votingInFlight = new Set(); // Prevent double-click race conditions
    async function vote(postId, dir) {
      // Lock: skip if a vote request is already in progress for this post
      if (votingInFlight.has(postId)) return;
      votingInFlight.add(postId);
      try {
        const res = await fetch(`/api/posts/${postId}/vote`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ direction: dir > 0 ? 'up' : 'down' })
        });
        if (!res.ok) return;
        const data = await res.json();
        
        // Update local cache with counts
        if (cachedPosts) {
          const p = cachedPosts.find(x => x.id === postId || x._id === postId);
          if (p) {
            p.upvoteCount = data.upvotes;
            p.downvoteCount = data.downvotes;
          }
        }
        
        // In-place DOM update — don't re-render the whole feed (preserves videos/photos)
        const cardEl = document.querySelector(`[data-post-id="${postId}"]`);
        if (cardEl) {
          // Update individual vote counts
          const upCountEl = cardEl.querySelector('[data-upcount]');
          const downCountEl = cardEl.querySelector('[data-downcount]');
          if (upCountEl) upCountEl.textContent = data.upvotes;
          if (downCountEl) downCountEl.textContent = data.downvotes;
          // Update active vote button styling
          const upBtn = cardEl.querySelector('[data-act="up"]');
          const downBtn = cardEl.querySelector('[data-act="down"]');
          if (upBtn) upBtn.classList.toggle('active', data.userVote === 'up');
          if (downBtn) downBtn.classList.toggle('active', data.userVote === 'down');
          // Also update cached data for userVote so re-sorts work correctly
          if (cachedPosts) {
            const p = cachedPosts.find(x => x.id === postId || x._id === postId);
            if (p) p.userVote = data.userVote;
          }
        } else {
          // Fallback: full re-render if card not found
          render();
        }
      } catch (err) {
        console.error('Vote request error:', err);
      } finally {
        votingInFlight.delete(postId);
      }
    }

    async function toggleComments(cardEl) {
      const commentsWrap = cardEl.querySelector("[data-comments]");
      const postId = commentsWrap.dataset.postId;
      const isVisible = !commentsWrap.classList.contains("d-none");

      // If hiding, just toggle
      if (isVisible) {
        commentsWrap.classList.add("d-none");
        return;
      }

      // If showing and not yet loaded, load comments
      if (commentsWrap.dataset.commentsLoaded === "false") {
        await loadCommentsForPost(postId, cardEl);
        commentsWrap.dataset.commentsLoaded = "true";
      }
      
      commentsWrap.classList.remove("d-none");
    }

    // Load comments for a specific post from server
    async function loadCommentsForPost(postId, cardEl) {
      if (commentCache.has(postId)) {
        const comments = commentCache.get(postId);
        renderComments(cardEl, comments, postId);
        return;
      }

      try {
        const res = await fetch(`/api/posts/${postId}/comments`);
        if (!res.ok) throw new Error('Failed to load comments');
        const data = await res.json();
        const comments = data.comments || [];
        commentCache.set(postId, comments);
        renderComments(cardEl, comments, postId);
      } catch (err) {
        console.warn('[Comments lazy load] Error for post ' + postId, err);
      }
    }

    // Render comments into the card
    function renderComments(cardEl, comments, postId) {
      const commentList = cardEl.querySelector("[data-commentlist]");
      const noComments = cardEl.querySelector("[data-nocomments]");
      
      commentList.innerHTML = ""; // Clear placeholder
      
      if (comments.length === 0) {
        noComments.style.display = "block";
      } else {
        noComments.style.display = "none";
        for (const c of comments.sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt))) {
          commentList.appendChild(commentRow(postId, c));
        }
      }
    }

    async function addComment(postId, text) {
      try {
        const res = await fetch(`/api/posts/${postId}/comment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ text })
        });
        if (!res.ok) throw new Error('Comment failed');
        // Comment already shown optimistically, just silently confirm with server
      } catch (err) {
        console.error('Comment submission error:', err);
        // In case of error, a simple alert could be added, but for now errors are silent
      }
    }

    function copyLink(postId) {
      const url = new URL(window.location.href);
      url.hash = "post-" + postId;
      (navigator.clipboard?.writeText(url.toString()) || Promise.reject()).then(() => {
        const card = document.querySelector(`[data-post-id="${postId}"]`);
        const btn = card ? card.querySelector('[data-act="share"]') : null;
        if (!btn) return;
        const old = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => btn.textContent = old, 900);
      }).catch(() => {
        alert("Copy failed. You can manually copy the URL from the address bar.");
      });
    }

