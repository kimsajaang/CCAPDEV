    .vote-btn:hover { border-color: var(--border-hover); background: rgba(255,255,255,0.04); color: var(--text); }
    .vote-btn.active.vote-up { color: #10b981; border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.1); }
    .vote-btn.active.vote-down { color: #ef4444; border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1); }
    .vote-btn i { font-size: 1rem; transition: transform 0.2s ease; }
    .vote-btn:hover i { transform: scale(1.15); }
    .vote-btn .vote-count { min-width: 12px; text-align: center; }
    .vote-separator { color: var(--text-faint); font-size: 0.8rem; user-select: none; }
    /* Competitive community enhancements */
