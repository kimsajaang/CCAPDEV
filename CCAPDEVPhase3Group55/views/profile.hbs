<script>
  /* ── Constants ── */
  const AVATAR_FALLBACK = "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Crect width=%2280%22 height=%2280%22 fill=%22%231a1f2e%22/%3E%3Ccircle cx=%2240%22 cy=%2230%22 r=%2216%22 fill=%22%235383e8%22/%3E%3Cellipse cx=%2240%22 cy=%2272%22 rx=%2228%22 ry=%2220%22 fill=%22%235383e8%22/%3E%3C/svg%3E";

  const ACHIEVEMENTS_DEF = [
    // Bronze Tier
    { id: 'first_game', name: 'First Step', icon: 'bi-controller', max: 1, tier: 'Bronze' },
    { id: 'collector', name: 'Collector', icon: 'bi-collection-fill', max: 10, tier: 'Bronze' },
    { id: 'weekend_warrior', name: 'Weekend Warrior', icon: 'bi-hourglass-split', max: 10, tier: 'Bronze' },
    { id: 'social_butterfly', name: 'Social Butterfly', icon: 'bi-people-fill', max: 5, tier: 'Bronze' },
    { id: 'critic', name: 'Critic', icon: 'bi-star-fill', max: 5, tier: 'Bronze' },
    
    // Silver Tier
    { id: 'completionist_badge', name: 'Completionist', icon: 'bi-trophy-fill', max: 5, tier: 'Silver' },
    { id: 'devoted', name: 'Devoted', icon: 'bi-moon-stars-fill', max: 100, tier: 'Silver' },
    { id: 'game_connoisseur', name: 'Game Connoisseur', icon: 'bi-gem', max: 30, tier: 'Silver' },
    { id: 'influencer', name: 'Influencer', icon: 'bi-megaphone-fill', max: 20, tier: 'Silver' },
    { id: 'network_master', name: 'Network Master', icon: 'bi-diagram-3-fill', max: 20, tier: 'Silver' },
    
    // Gold Tier
    { id: 'gaming_legend', name: 'Gaming Legend', icon: 'bi-crown', max: 15, tier: 'Gold' },
    { id: 'marathon_runner', name: 'Marathon Runner', icon: 'bi-fire', max: 300, tier: 'Gold' },
    { id: 'master_collector', name: 'Master Collector', icon: 'bi-collection', max: 60, tier: 'Gold' },
    { id: 'critical_acclaim', name: 'Critical Acclaim', icon: 'bi-bar-chart-fill', max: 50, tier: 'Gold' },
    { id: 'community_leader', name: 'Community Leader', icon: 'bi-globe', max: 50, tier: 'Gold' },
    
    // Diamond Tier
    { id: 'gaming_god', name: 'Gaming God', icon: 'bi-lightning-fill', max: 30, tier: 'Diamond' },
    { id: 'time_master', name: 'Time Master', icon: 'bi-clock-fill', max: 500, tier: 'Diamond' },
    { id: 'legendary_collection', name: 'Legendary Collection', icon: 'bi-star', max: 100, tier: 'Diamond' },
    { id: 'gaming_prodigy', name: 'Gaming Prodigy', icon: 'bi-lightbulb-fill', max: 100, tier: 'Diamond' },
    { id: 'apex_network', name: 'Apex Network', icon: 'bi-diagram-2-fill', max: 100, tier: 'Diamond' },
    { id: 'ultimate_gamer', name: 'Ultimate Gamer', icon: 'bi-hearts', max: 1, tier: 'Diamond' }
  ];

  /* ── State ── */
  let currentUser = null;
  let profileUser = null;
  let isOwnProfile = true;
  let _profileStorageKey, _libraryStorageKey, _achievementsStorageKey;

  /* ── Initialization ── */
  async function initProfile() {
    const params = new URLSearchParams(window.location.search);
    const targetId = params.get('user');

    const dashboard = document.querySelector('.profile-dashboard');

    try {
      const authRes = await fetch('/api/auth/current', { credentials: 'include' });
      if (!authRes.ok) { window.location.href = '/login'; return; }
      currentUser = await authRes.json();

      if (targetId && targetId !== currentUser._id) {
        isOwnProfile = false;
        const uRes = await fetch('/api/users/' + targetId);
        if (uRes.ok) profileUser = await uRes.json();
        else { 
          dashboard.innerHTML = '<h4 class="text-center mt-5">User not found</h4>';
          return; 
        }
      } else {
        isOwnProfile = true;
        profileUser = currentUser;
      }

      initializeKeys(profileUser._id);
      const loader = document.getElementById('page-loader');
      if (loader) loader.classList.add('hidden');
      renderProfileView();
      await fetchStatsAndActivity();
    } catch (e) { 
      console.error("Init failed", e);
      const loader = document.getElementById('page-loader');
      if (loader) loader.classList.add('hidden');
      dashboard.innerHTML = '<h4 class="text-center mt-5">Error loading profile. Please refresh the page.</h4>';
    }
  }

  function initializeKeys(uid) {
    _profileStorageKey = `prfl_v1_${uid}`;
    _libraryStorageKey = `lib_v1_${uid}`;
    _achievementsStorageKey = `ach_v1_${uid}`;
  }

  /* ── UI Rendering ── */
  function renderProfileView() {
    const p = profileUser;
    document.getElementById('profileDisplayName').textContent = p.displayName || p.username;
    document.getElementById('profileHandle').textContent = `@${p.username}`;
    // Fix avatar: only use if it's a non-empty string
    const avatarSrc = (p.avatar && typeof p.avatar === 'string' && p.avatar.trim()) ? p.avatar : AVATAR_FALLBACK;
    document.getElementById('profileAvatar').src = avatarSrc;

    if (p.wallpaper) {
      document.getElementById('heroBanner').style.backgroundImage = `linear-gradient(110deg, rgba(11,14,20,1) 30%, rgba(11,14,20,0.65) 100%), url('${p.wallpaper}')`;
      document.getElementById('heroBanner').style.backgroundSize = 'cover';
      const pos = p.wallpaperPosition != null ? p.wallpaperPosition : 50;
      document.getElementById('heroBanner').style.backgroundPosition = `center ${pos}%`;
    }

    const bio = (p.bio && p.bio !== 'No bio yet') ? p.bio : (isOwnProfile ? "" : "Player has not set a bio yet.");
    document.getElementById('userBio').textContent = bio;

    if (isOwnProfile) document.getElementById('editProfileBtn').style.display = 'flex';
    else renderFriendButton(p._id);

    const createdDate = new Date(p.createdAt || Date.now());
    const monthDiff = Math.max(1, Math.floor((Date.now() - createdDate) / (1000 * 60 * 60 * 24 * 30)));
    document.getElementById('memberSince').textContent = `Member for ${monthDiff} month${monthDiff !== 1 ? 's' : ''}`;
    if (p.favoritePlatform) document.getElementById('userLocation').textContent = p.favoritePlatform;
  }

  // Calculate XP from stats - used for real-time updates
  function updateXPDisplay(stats) {
    const baseXP = stats.total * 150;                    // 150 XP per game in library
    const hoursXP = Math.round(stats.totalHours * 25);  // 25 XP per hour
    const completedXP = stats.completed * 500;          // 500 XP per completed game
    const exp = baseXP + hoursXP + completedXP;
    
    document.getElementById('totalExp').textContent = exp.toLocaleString();
    const level = Math.floor(exp / 1500) + 1;
    const progress = Math.min((exp % 1500) / 1500 * 100, 100);
    document.getElementById('userLevel').textContent = level;
    document.getElementById('lvlProgressBar').style.width = Math.max(5, progress) + '%';
  }

  // Expose function globally for real-time updates from other pages
  window.refreshProfileXP = async function() {
    if (!profileUser) return;
    const uid = profileUser._id;
    try {
      const res = await fetch('/api/library/' + uid);
      if (res.ok) {
        const entries = await res.json();
        const stats = {
          total: entries.length,
          completed: entries.filter(e => e.status === 'completed').length,
          totalHours: entries.reduce((s, e) => s + (e.playtime || 0), 0)
        };
        document.getElementById('totalGamesCount').textContent = stats.total;
        document.getElementById('completedCount').textContent = stats.completed;
        updateXPDisplay(stats);
      }
    } catch (e) { console.error('Error refreshing XP:', e); }
  };

  // Refresh achievements (can be called from other pages after rating/friend changes)
  window.refreshProfileAchievements = async function() {
    if (!profileUser) return;
    await fetchStatsAndActivity();
  };

  async function fetchStatsAndActivity() {
    const uid = profileUser._id;
    let stats = { total: 0, completed: 0, totalHours: 0, games: [], ratedCount: 0, friendCount: 0 };

    try {
      const res = await fetch('/api/library/' + uid);
      if (res.ok) {
        const entries = await res.json();
        stats.games = entries;
        stats.total = entries.length;
        stats.completed = entries.filter(e => e.status === 'completed').length;
        stats.totalHours = entries.reduce((s, e) => s + (e.playtime || 0), 0);
        stats.ratedCount = entries.filter(e => e.rating && e.rating > 0).length;
        
        // Debug logging
        console.log('[Profile] Total entries:', entries.length);
        console.log('[Profile] Completed:', stats.completed);
        console.log('[Profile] Rated count:', stats.ratedCount);
        if (entries.length > 0) {
          console.log('[Profile] Sample entry:', entries[0]);
          console.log('[Profile] All ratings:', entries.map(e => ({ gameId: e.gameId, rating: e.rating })));
        }
      }
    } catch (e) { console.error('[Profile] Library fetch error:', e); }

    // Refetch user data to get latest friend count
    try {
      let userRes;
      if (isOwnProfile) {
        // For own profile, use current auth
        userRes = await fetch('/api/auth/current', { credentials: 'include' });
      } else {
        // For other users, fetch their public profile
        userRes = await fetch('/api/users/' + uid);
      }
      
      if (userRes.ok) {
        const freshUser = await userRes.json();
        // API returns friendsCount, not friends array
        stats.friendCount = freshUser.friendsCount || 0;
        console.log('[Profile] API response for', uid, ':', freshUser);
        console.log('[Profile] Friend count extracted:', stats.friendCount);
      }
    } catch (e) { 
      console.error('[Profile] User fetch error:', e);
      stats.friendCount = 0;
    }

    // Local Achievements
    const unlockedIds = JSON.parse(localStorage.getItem(_achievementsStorageKey) || '[]');

    // Render Stats
    document.getElementById('totalGamesCount').textContent = stats.total;
    document.getElementById('completedCount').textContent = stats.completed;

    // Calculate XP with more rewarding system
    updateXPDisplay(stats);

    renderAccGid(profileUser, stats.games);
    renderAchievementsList(unlockedIds, stats);
    renderActivityList(stats.games);
    loadCommunityScores(stats.games);
    loadFriendRequests(); // Load friend requests for own profile
  }

  function renderAccGid(user, games) {
    const container = document.getElementById('accGrid');
    const favs = (user.favoriteGames || []).map(g => ({ name: g.name || g, cover: g.cover || g.coverUrl || '' }));

    const items = favs.slice(0, 5);
    if (!items.length) { container.innerHTML = '<div class="empty-state">No featured games yet. Edit your profile to feature your favorite games!</div>'; return; }

    container.innerHTML = items.map((i, idx) => `
    <div class="acc-card" style="animation: slideInUp 0.5s ease-out ${idx * 0.08}s both;">
      <div class="acc-icon"><img src="${i.cover}" alt="icon" onerror="this.src='/img/placeholder.jpg'"></div>
      <div class="acc-info"><h6>${i.name}</h6><small>Showcased Title</small></div>
    </div>
  `).join('');
  }

  function renderAchievementsList(unlockedIds, stats) {
    const container = document.getElementById('achievementsContainer');
    const badge = document.getElementById('achProgBadge');

    let earnedCount = 0;
    const html = ACHIEVEMENTS_DEF.map((a, idx) => {
      let current = 0;
      
      // Map achievement IDs to stat logic
      if (a.id === 'first_game' || a.id === 'collector' || a.id === 'game_connoisseur' || a.id === 'master_collector' || a.id === 'legendary_collection') {
        current = stats.total;
      }
      if (a.id === 'completionist_badge' || a.id === 'gaming_legend' || a.id === 'gaming_god') {
        current = stats.completed;
      }
      if (a.id === 'devoted' || a.id === 'weekend_warrior' || a.id === 'marathon_runner' || a.id === 'time_master') {
        current = stats.totalHours;
      }
      
      // Rating-based achievements
      if (a.id === 'critic' || a.id === 'influencer' || a.id === 'critical_acclaim' || a.id === 'gaming_prodigy') {
        current = stats.ratedCount;
      }
      
      // Friend-based achievements
      if (a.id === 'social_butterfly' || a.id === 'network_master' || a.id === 'community_leader' || a.id === 'apex_network') {
        current = stats.friendCount;
      }
      
      const isDone = current >= a.max || unlockedIds.includes(a.id);
      if (isDone) earnedCount++;

      return `
      <div class="ach-item" style="animation: slideInUp 0.5s ease-out ${idx * 0.08}s both; opacity: ${isDone ? 1 : 0.6}">
        <div class="ach-icon-box"><i class="bi ${a.icon}"></i></div>
        <div class="ach-name">${a.name}</div>
        <div style="margin-left: auto; display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 0.75rem; color: var(--text-tertiary); background: rgba(83, 131, 232, 0.1); padding: 3px 8px; border-radius: 3px;">${a.tier}</span>
          ${isDone ? '<div class="ach-status">ACHIEVED</div>' : `<div class="ach-prog-val">${Math.min(current, a.max)}/${a.max}</div>`}
        </div>
      </div>
    `;
    }).join('');

    container.innerHTML = html;
    badge.textContent = `${earnedCount}/${ACHIEVEMENTS_DEF.length}`;
  }

  function renderActivityList(games) {
    const container = document.getElementById('activityContainer');
    // Only show completed games, filter out "playing" status entirely
    const sorted = games.filter(g => g.gameId && g.status === 'completed').sort((a, b) => new Date(b.addedAt || 0) - new Date(a.addedAt || 0)).slice(0, 5);

    if (!sorted.length) { container.innerHTML = '<div class="empty-state">Nothing lately.</div>'; return; }

    container.innerHTML = sorted.map((g, idx) => {
      const status = 'Completed';
      return `
      <div class="act-item" style="animation: slideInUp 0.5s ease-out ${idx * 0.08}s both;">
        <div class="act-status">${status}</div>
        <div class="act-info">
          <span class="act-game-name">${g.gameId.name}</span>
          <span class="act-game-meta">${new Date(g.addedAt).toLocaleDateString()} • ${g.playtime}h played</span>
        </div>
        ${g.gameId.coverUrl ? `<img src="${g.gameId.coverUrl}" class="act-cover">` : ''}
      </div>
    `;
    }).join('');
  }

  // Load friend requests (only for own profile)
  async function loadFriendRequests() {
    if (!isOwnProfile) return;

    try {
      const res = await fetch('/api/friends/requests', { credentials: 'include' });
      if (!res.ok) return;

      const requests = await res.json();
      const container = document.getElementById('friendRequestsContainer');
      const titleContainer = document.getElementById('notificationsTitleContainer');
      const countBadge = document.getElementById('friendRequestCount');

      if (!requests.length) {
        container.style.display = 'none';
        titleContainer.style.display = 'none';
        return;
      }

      container.style.display = 'grid';
      titleContainer.style.display = 'flex';
      countBadge.textContent = requests.length;

      container.innerHTML = requests.map((req, idx) => {
        const from = req.from;
        const avatar = from.avatar || AVATAR_FALLBACK;
        const displayName = from.displayName || from.username;
        const requestId = req._id;

        return `
          <div class="friend-request-card" style="animation: slideInUp 0.5s ease-out ${idx * 0.08}s both;">
            <div class="friend-request-info">
              <div class="friend-request-avatar">
                <img src="${avatar && typeof avatar === 'string' && avatar.trim() ? avatar : AVATAR_FALLBACK}" alt="${displayName}" onerror="this.src='${AVATAR_FALLBACK}'">>
              </div>
              <div class="friend-request-details">
                <h6>${displayName}</h6>
                <small>Want to be friends</small>
              </div>
            </div>
            <div class="friend-request-actions">
              <button class="friend-request-btn friend-request-accept" onclick="acceptFriendRequest('${requestId}')">
                <i class="bi bi-check-lg"></i> Accept
              </button>
              <button class="friend-request-btn friend-request-reject" onclick="rejectFriendRequest('${requestId}')">
                <i class="bi bi-x-lg"></i> Reject
              </button>
            </div>
          </div>
        `;
      }).join('');
    } catch (err) {
      console.error('[Friend Requests] Load failed:', err);
    }
  }

  // Accept friend request
  async function acceptFriendRequest(requestId) {
    try {
      const res = await fetch('/api/friends/accept/' + requestId, { method: 'POST', credentials: 'include' });
      if (res.ok) {
        loadFriendRequests(); // Refresh the list
        await fetchStatsAndActivity(); // Update achievements
      }
    } catch (err) {
      console.error('[Accept Friend] Error:', err);
    }
  }

  // Reject friend request
  async function rejectFriendRequest(requestId) {
    try {
      const res = await fetch('/api/friends/reject/' + requestId, { method: 'POST', credentials: 'include' });
      if (res.ok) {
        loadFriendRequests(); // Refresh the list
        await fetchStatsAndActivity(); // Update achievements
      }
    } catch (err) {
      console.error('[Reject Friend] Error:', err);
    }
  }

  // Load user's game ratings
  function loadCommunityScores(games) {
    const container = document.getElementById('communityScoresContainer');
    
    try {
      // Filter games that have ratings
      const ratedGames = games.filter(g => g.rating && g.rating > 0 && g.gameId)
        .sort((a, b) => b.rating - a.rating);

      if (!ratedGames || ratedGames.length === 0) {
        container.innerHTML = '<div class="empty-state">No rated games yet.</div>';
        return;
      }

      let html = '';
      ratedGames.forEach((entry, idx) => {
        const rating = Math.floor(entry.rating);
        const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
        const gameName = entry.gameId.name || entry.gameId;

        html += `<div style="animation: fadeInUp 0.4s ease ${idx * 0.05}s both; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
          <div style="flex: 1; min-width: 0;">
            <div class="text-truncate fw-500" title="${gameName}" style="word-break: break-word;">${gameName}</div>
            <div style="font-size: 0.75rem; color: var(--text-tertiary); margin-top: 4px;">Personal rating</div>
          </div>
          <div style="font-weight: bold; white-space: nowrap; font-size: 1rem; color: #fbbf24; flex-shrink: 0;">${stars}</div>
        </div>`;
      });

      container.innerHTML = html;
    } catch (err) {
      console.error('[Game Ratings] Error:', err);
      container.innerHTML = '<div class="empty-state">Could not load ratings.</div>';
    }
  }

  /* Modals */
  /* (Group chat modals removed) */

  /* ── XP Tooltip Functions ── */
  let tooltipHideTimeout;

  // Smart tooltip positioning: default to bottom, always visible in viewport
  function showXpTooltip() {
    clearTimeout(tooltipHideTimeout);
    const tooltip = document.getElementById('xpTooltip');
    const wrapper = document.getElementById('xpTooltipWrapper');
    const OFFSET = 8; // Minimal offset for overlapping effect
    if (tooltip && wrapper) {
      tooltip.classList.remove('xp-tooltip-below');
      tooltip.style.top = '';
      tooltip.style.bottom = '';
      // Get bounding rects
      const wrapperRect = wrapper.getBoundingClientRect();
      const tooltipHeight = tooltip.offsetHeight;
      const spaceAbove = wrapperRect.top;
      const spaceBelow = window.innerHeight - wrapperRect.bottom;
      // Default: show below
      let showBelow = true;
      if (spaceBelow < tooltipHeight + OFFSET && spaceAbove > spaceBelow) {
        showBelow = false;
      }
      if (showBelow) {
        tooltip.classList.add('xp-tooltip-below');
        tooltip.style.top = (wrapper.offsetHeight + OFFSET) + 'px';
        tooltip.style.bottom = 'auto';
      } else {
        tooltip.classList.remove('xp-tooltip-below');
        tooltip.style.bottom = (wrapper.offsetHeight + OFFSET) + 'px';
        tooltip.style.top = 'auto';
      }
      tooltip.classList.add('show');
    }
  }

  function hideXpTooltip() {
    tooltipHideTimeout = setTimeout(() => {
      const tooltip = document.getElementById('xpTooltip');
      if (tooltip) {
        tooltip.classList.remove('show');
      }
    }, 200);
  }

  /* ── Friend Interactions ── */
  async function renderFriendButton(tid) {
    const container = document.getElementById('friendBtnContainer');
    try {
      const res = await fetch('/api/friends/status/' + tid);
      const d = await res.json();
      if (d.status === 'friends') container.innerHTML = '<button class="prof-btn btn-outline" disabled><i class="bi bi-person-check"></i> Friends</button>';
      else if (d.status === 'pending_sent') container.innerHTML = '<button class="prof-btn btn-outline" disabled><i class="bi bi-clock"></i> Sent</button>';
      else container.innerHTML = `<button class="prof-btn btn-primary" onclick="sendRequest('${tid}')"><i class="bi bi-person-plus"></i> Add Friend</button>`;
    } catch (e) { }
  }

  async function sendRequest(uid) {
    try {
      const res = await fetch('/api/friends/request/' + uid, { method: 'POST', credentials: 'include' });
      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json().catch(() => ({}));
        alert(err.error || 'Failed to send friend request');
      }
    } catch (e) {
      alert('Error sending friend request');
    }
  }

  /* ── Initialization Entry ── */
  document.addEventListener('DOMContentLoaded', function() {
    initProfile();
    
    // Add share button click handler
    const shareBtn = document.getElementById('shareProfileBtn');
    if (shareBtn) {
      shareBtn.addEventListener('click', function() {
        const profileUrl = `${window.location.origin}/profile?user=${profileUser._id}`;
        
        // Try modern Web Share API first
        if (navigator.share) {
          navigator.share({
            title: `${profileUser.displayName}'s Profile`,
            text: `Check out ${profileUser.displayName}'s gaming profile on Backlog Hero!`,
            url: profileUrl
          }).catch(err => {
            if (err.name !== 'AbortError') {
              console.error('Share failed:', err);
              fallbackShare(profileUrl);
            }
          });
        } else {
          // Fallback: copy to clipboard and show alert
          fallbackShare(profileUrl);
        }
      });
    }
    
    function fallbackShare(url) {
      navigator.clipboard.writeText(url).then(() => {
        alert('Profile link copied to clipboard!\n' + url);
      }).catch(() => {
        // Last resort: show prompt
        prompt('Copy this profile link:', url);
      });
    }
  });

  // Nav Exit Transition
  document.querySelectorAll('a[href]').forEach(link => {
    if (link.hostname === window.location.hostname && !link.hash && !link.getAttribute('href').startsWith('#')) {
      link.addEventListener('click', () => { document.body.classList.add('page-exit'); });
    }
  });

  // Hide loader when page fully loads (safety timeout)
  window.addEventListener('load', () => {
    const loader = document.getElementById('page-loader');
    if (loader && !loader.classList.contains('hidden')) {
      loader.classList.add('hidden');
    }
  });
</script>
