<!-- search.html — Game search & discovery page.
     Users can search through the game catalog and add titles to their library.
     The "Based on your library" recommendations are hardcoded for now. -->

<style>
    /* Page-specific: search overrides */
    .card-title {
      color: #dbe7ff;
    }

    .search-container {
      background: linear-gradient(180deg, rgba(20, 28, 36, 0.6) 0%, transparent 100%);
      padding: 50px 0 40px;
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .search-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 300px;
      background: radial-gradient(ellipse, rgba(83, 131, 232, 0.12), transparent 70%);
      pointer-events: none;
    }

    .game-cover {
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      transition: transform 0.4s var(--ease);
    }

    .card:hover .game-cover {
      transform: scale(1.06);
    }

    .card .card-img-top-wrap {
      overflow: hidden;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .animate-card {
      opacity: 0;
      animation: fadeInUp 0.5s var(--ease-out) forwards;
    }

    .animate-card:nth-child(1) {
      animation-delay: 0.05s;
    }

    .animate-card:nth-child(2) {
      animation-delay: 0.1s;
    }

    .animate-card:nth-child(3) {
      animation-delay: 0.15s;
    }

    .animate-card:nth-child(4) {
      animation-delay: 0.2s;
    }

    .animate-card:nth-child(5) {
      animation-delay: 0.25s;
    }

    .animate-card:nth-child(6) {
      animation-delay: 0.3s;
    }

    .animate-card:nth-child(7) {
      animation-delay: 0.35s;
    }

    .animate-card:nth-child(8) {
      animation-delay: 0.4s;
    }

    .animate-card:nth-child(9) {
      animation-delay: 0.45s;
    }

    .animate-card:nth-child(10) {
      animation-delay: 0.5s;
    }

    .search-input-wrap {
      position: relative;
    }

    .search-input-wrap .form-control {
      border-radius: var(--radius-lg);
      padding: 14px 20px 14px 48px;
      font-size: 1rem;
      border: 1px solid var(--border);
      background: var(--bg-input) !important;
      transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    }

    .search-input-wrap .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--primary-glow), 0 0 40px rgba(83, 131, 232, 0.1);
    }

    .search-input-wrap .search-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-faint);
      font-size: 1.1rem;
      transition: color 0.2s;
      z-index: 5;
    }

    .search-input-wrap:focus-within .search-icon {
      color: var(--primary);
    }

    .search-btn-hero {
      border-radius: var(--radius-lg);
      padding: 0 24px;
    }

    /* Card hover glow */
    .card::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient-primary);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .card:hover::after {
      opacity: 1;
    }

    .results-count {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    /* Skeleton Loading Animation - Search Games */
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }

    .skeleton-loader {
      background: linear-gradient(90deg, #1a1f2e 25%, #242d3d 50%, #1a1f2e 75%);
      background-size: 1000px 100%;
      animation: shimmer 2s infinite;
      border-radius: 8px;
    }

    .search-loading {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 16px;
      padding: 20px;
      opacity: 0.6;
    }

    .search-loading .skeleton-card {
      height: 280px;
      border-radius: 12px;
      overflow: hidden;
    }

    .search-loading .skeleton-cover {
      height: 200px;
      margin-bottom: 12px;
    }

    .search-loading .skeleton-title {
      height: 16px;
      margin-bottom: 8px;
      border-radius: 4px;
    }

    .search-loading .skeleton-text {
      height: 12px;
      border-radius: 4px;
      margin-bottom: 8px;
    }
  </style>

