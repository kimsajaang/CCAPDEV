        .profile-item { background: #151d24 !important; border: 1px solid var(--border) !important; border-radius: var(--radius-md); margin-bottom: 10px; }
        .tag { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; background: linear-gradient(135deg, rgba(83, 131, 232, 0.15), rgba(45, 212, 191, 0.08)); border: 1px solid rgba(83, 131, 232, 0.25); padding: 6px 12px; border-radius: var(--radius-sm); transition: border-color var(--duration) var(--ease), transform var(--duration) var(--ease), background var(--duration) var(--ease); }
        .tag:hover { border-color: var(--primary); background: linear-gradient(135deg, rgba(83, 131, 232, 0.25), rgba(45, 212, 191, 0.15)); transform: translateY(-2px); }
        .tag i { color: var(--primary); }
        .muted-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); margin: 20px 0; }
        /* Staggered reveal */
        .reveal-item { opacity: 0; transform: translateY(18px); animation: rise 0.7s var(--ease) forwards; }
        .stat-grid .stat-card:nth-child(1) { animation-delay: 0.08s; }
        .stat-grid .stat-card:nth-child(2) { animation-delay: 0.16s; }
        .stat-grid .stat-card:nth-child(3) { animation-delay: 0.24s; }
        .stat-grid .stat-card:nth-child(4) { animation-delay: 0.32s; }
        .section-grid .section-card:nth-child(1) { animation-delay: 0.2s; }
        .section-grid .section-card:nth-child(2) { animation-delay: 0.3s; }
        .section-card .highlight-item:nth-of-type(1) { animation-delay: 0.18s; }
        .section-card .highlight-item:nth-of-type(2) { animation-delay: 0.26s; }
        .section-card .highlight-item:nth-of-type(3) { animation-delay: 0.34s; }
        .section-card .activity-item:nth-of-type(1) { animation-delay: 0.18s; }
        .section-card .activity-item:nth-of-type(2) { animation-delay: 0.26s; }
        .section-card .activity-item:nth-of-type(3) { animation-delay: 0.34s; }
        @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        /* Section title */
        .section-title { font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .section-title::before { content: ''; width: 3px; height: 18px; background: linear-gradient(135deg, var(--primary), var(--accent)); border-radius: 2px; flex-shrink: 0; }
        /* Friends section */
        .friends-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; margin-top: 12px; }
        .friend-card { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: rgba(20,28,36,0.92); border: 1px solid var(--border); border-radius: var(--radius-md); transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease); cursor: pointer; text-decoration: none; color: inherit; }
        .friend-card:hover { border-color: var(--primary); transform: translateY(-4px) scale(1.02); box-shadow: 0 12px 28px rgba(83, 131, 232, 0.2); color: inherit; text-decoration: none; }
        .friend-card img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); transition: border-color 0.3s; }
        .friend-card:hover img { border-color: var(--primary); }
        .friend-card .friend-info { min-width: 0; }
        .friend-card .friend-name { font-weight: 600; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text); }
        .friend-card .friend-username { font-size: 0.72rem; color: var(--text-muted); }
        .friend-request-card { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: linear-gradient(135deg, rgba(21, 29, 36, 0.8), rgba(15, 21, 25, 0.9)); border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: 8px; transition: border-color 0.3s var(--ease); }
        .friend-request-card:hover { border-color: var(--primary); }
        .friend-request-card img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
        .friend-request-actions { margin-left: auto; display: flex; gap: 6px; }
        .pending-badge { display: inline-flex; align-items: center; justify-content: center; background: var(--danger); color: #fff; font-size: 0.65rem; font-weight: 700; width: 18px; height: 18px; border-radius: 50%; position: relative; top: -8px; left: -6px; }
        .friend-btn { font-size: 0.8rem; font-weight: 600; padding: 6px 14px; border-radius: var(--radius-sm); transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease); }
        .friend-btn.btn-success { background: linear-gradient(135deg, #34d399, #059669); border: none; }
        .friend-btn.btn-warning { background: linear-gradient(135deg, #febc2e, #d97706); border: none; color: #0f1519; }
        /* User search modal */
        .user-search-result { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: var(--radius-sm); cursor: pointer; transition: background 0.2s, transform 0.2s; }
        .user-search-result:hover { background: rgba(83,131,232,0.1); transform: translateX(4px); }
        .user-search-result img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }

        /* Responsive */
        @media (max-width: 991px) {
            .profile-grid { grid-template-columns: 1fr; }
            .profile-top { flex-direction: column; align-items: center; text-align: center; }
            .profile-header { flex-direction: column; align-items: center; text-align: center; }
            .profile-actions { justify-content: center; flex-wrap: wrap; }
            .profile-meta { justify-content: center; }
            .friends-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
            .avatar-img { margin-top: -24px; }
        }
    </style>{{> navbar-app activePage="profile"}}

