<script>
    /* Profile logic adapted for the new Dashboard layout */
    const PROFILE_STORAGE_KEY = 'bh_profile_v1';
    const LIBRARY_STORAGE_KEY = 'bh_library_v1';
    const ACHIEVEMENTS_STORAGE_KEY = 'bh_achievements_v1';

    const AVATAR_FALLBACK = "data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Crect width=%2280%22 height=%2280%22 fill=%22%23131a24%22/%3E%3Ccircle cx=%2240%22 cy=%2230%22 r=%2216%22 fill=%22%235383e8%22/%3E%3Cellipse cx=%2240%22 cy=%2272%22 rx=%2228%22 ry=%2220%22 fill=%22%235383e8%22/%3E%3C/svg%3E";

    const defaultProfile = {
        displayName: 'Gamer',
        username: 'gamer',
        bio: '',
        avatar: AVATAR_FALLBACK,
        createdAt: new Date()
    };

    let currentUser = null;
    let viewingUserId = null;
    let isOwnProfile = true;

    /* Achievement Logic */
    const ACHIEVEMENTS = [
        { id: 'first_game', name: 'First Step', icon: '<i class="bi bi-controller"></i>', description: 'Add your first game', condition: (games) => games.length >= 1 },
        { id: 'collector', name: 'Collector', icon: '<i class="bi bi-collection-fill"></i>', description: 'Add 10 games', condition: (games) => games.length >= 10 },
        { id: 'completionist_badge', name: 'Completionist', icon: '<i class="bi bi-trophy-fill"></i>', description: 'Complete 5 games', condition: (games) => games.filter(g => g.status === 'completed').length >= 5 },
        { id: 'no_life', name: 'Devoted', icon: '<i class="bi bi-moon-stars-fill"></i>', description: '1000+ hours playtime', condition: (games) => games.reduce((acc, g) => acc + (g.playtime || 0), 0) >= 1000 }
    ];

    function loadAchievements() {
        const stored = localStorage.getItem(ACHIEVEMENTS_STORAGE_KEY);
        return stored ? JSON.parse(stored) : [];
    }

    /* Core Render */
    async function renderProfile(profile) {
        profile = { ...defaultProfile, ...profile };
        const games = JSON.parse(localStorage.getItem(LIBRARY_STORAGE_KEY) || '[]');
        const unlockedAchievements = loadAchievements(); // Simplification

        // Header Data
        document.getElementById('profileName').textContent = profile.displayName || profile.username;
        document.getElementById('profileHandle').textContent = `@${profile.username}`;
        document.getElementById('profileAvatar').src = profile.avatar || defaultProfile.avatar;
        document.getElementById('memberSince').textContent = `Member since ${new Date(profile.createdAt).toLocaleDateString()}`;

        if (profile.wallpaper) {
            document.body.style.setProperty('--profile-bg', `url("${profile.wallpaper}")`);
        }

        // Actions
        const editBtn = document.getElementById('editProfileBtn');
        if (isOwnProfile) {
            if(editBtn) editBtn.style.display = '';
        } else {
            if(editBtn) editBtn.style.display = 'none';
            await renderFriendButton(profile);
        }

        const bioEl = document.getElementById('userBio');
        bioEl.innerHTML = (profile.bio && profile.bio !== 'No bio yet') 
            ? profile.bio.replace(/</g, '&lt;').replace(/>/g, '&gt;') 
            : (isOwnProfile ? 'No bio yet. <a href="/profile-edit">Add one now</a>' : 'No bio available.');

        // Metrics Fetch
        const userId = profile._id || profile.id;
        let stats = { completed: 0, backlog: 0, playing: 0, totalHours: 0, postsCount: 0, total: 0 };
        try {
            if (isOwnProfile) {
                const sr = await fetch('/api/auth/stats', { credentials: 'include' });
                if (sr.ok) stats = await sr.json();
            } else if (userId) {
                const lr = await fetch('/api/library/' + userId, { credentials: 'include' });
                if (lr.ok) {
                    const entries = await lr.json();
                    stats.completed = entries.filter(e => e.status === 'completed').length;
                    stats.totalHours = entries.reduce((s, e) => s + (e.playtime || 0), 0);
                    stats.total = entries.length;
                }
            }
        } catch (e) { }

        // Populate Core Metrics
        document.getElementById('totalGamesCount').textContent = stats.total || games.length;
        document.getElementById('totalHoursCount').textContent = (stats.totalHours || 0) + 'h';
        document.getElementById('completedCount').textContent = stats.completed || 0;
        document.getElementById('reviewsCount').textContent = stats.postsCount || 0;

        // Visual Layouts
        renderTrophies(profile, games);
        renderBadges(unlockedAchievements);
        renderRecentActivity(userId);
        
        await loadFriendsList(userId);
        if (isOwnProfile) await loadFriendRequests();
    }

    function renderTrophies(profile, games) {
        const grid = document.getElementById('itemShowcaseGrid');
        const countLbl = document.getElementById('itemCountLabel');

        const favs = (profile.favoriteGames || []).map(g => ({
            cover: typeof g === 'object' ? (g.cover || g.coverUrl || '') : '',
            name: typeof g === 'object' ? g.name : (g || '')
        }));
        const libGames = games.filter(g => g.gameId && g.gameId.coverUrl).map(g => ({
            cover: g.gameId.coverUrl, name: g.gameId.name
        }));
        const merged = [...favs, ...libGames];
        const unique = [];
        const seen = new Set();
        merged.forEach(i => { if(i.cover && !seen.has(i.name)) { seen.add(i.name); unique.push(i); } });
        const items = unique.slice(0, 8);

        if(countLbl) countLbl.textContent = items.length;
        if(items.length === 0) {
            grid.innerHTML = `<div class="empty-state col-12">
                <i class="bi bi-trophy"></i>
                <p>No games to showcase yet.</p>
                <a href="/library" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus me-1"></i>Add Games to Library</a>
            </div>`;
            return;
        }
        let html = '';
        items.forEach(i => {
            const safe = i.name.replace(/"/g,'&quot;');
            html += `<div class="trophy-item" title="${safe}" onclick="window.location='/search?q=${encodeURIComponent(i.name)}'">
                <img src="${i.cover}" alt="${safe}" onerror="this.parentElement.style.display='none'">
                <div class="trophy-label">${safe}</div>
            </div>`;
        });
        grid.innerHTML = html;
    }

    function renderBadges(achievements) {
        const cont = document.getElementById('achievementsContainer');
        const count = document.getElementById('achievementCount');
        const earned = ACHIEVEMENTS.filter(a => achievements.some(ua => ua.id === a.id));
        if(count) count.textContent = `${earned.length}/${ACHIEVEMENTS.length}`;

        if (earned.length === 0) {
            cont.innerHTML = `<div class="empty-state">
                <i class="bi bi-shield"></i>
                <p>No achievements yet. Add games to your library to earn them!</p>
                <a href="/library" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus me-1"></i>Go to Library</a>
            </div>`;
            return;
        }
        let html = '<div class="d-flex flex-wrap">';
        ACHIEVEMENTS.forEach(a => {
            const unlocked = achievements.some(ua => ua.id === a.id);
            html += `<div class="ach-badge" title="${a.name}: ${a.description}">
                <div class="ach-icon" style="${unlocked ? '' : 'filter:grayscale(1);opacity:0.35;'}">${a.icon}</div>
                <div class="ach-lbl">${a.name}</div>
            </div>`;
        });
        html += '</div>';
        cont.innerHTML = html;
    }

    async function renderRecentActivity(userId) {
        const cont = document.getElementById('activityContainer');
        try {
            if (!userId) {
                cont.innerHTML = '<div class="empty-state"><i class="bi bi-clock-history"></i><p>No recent activity.</p></div>';
                return;
            }
            const res = await fetch('/api/library/' + userId, { credentials: 'include' });
            if (res.ok) {
                const entries = await res.json();
                const valid = entries.filter(e => e.gameId).slice(0, 5);
                if (valid.length === 0) {
                    cont.innerHTML = `<div class="empty-state">
                        <i class="bi bi-clock-history"></i>
                        <p>No activity yet. Start building your library!</p>
                        <a href="/search" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i>Search Games</a>
                    </div>`;
                    return;
                }
                const statusLabel = { completed: '🏆 Completed', playing: '🎮 Playing', backlog: '📥 Added to backlog' };
                let html = '';
                valid.forEach(e => {
                    const cover = e.gameId.coverUrl || '';
                    const coverHtml = cover
                        ? `<img src="${cover}" class="activity-cover" onerror="this.style.display='none'">`
                        : `<div class="activity-cover d-flex align-items-center justify-content-center" style="background:#0f1519;border-radius:4px;"><i class="bi bi-controller"></i></div>`;
                    html += `<div class="activity-item">
                        ${coverHtml}
                        <div class="activity-info">
                            <div class="ai-title">${e.gameId.name.replace(/</g,'&lt;')}</div>
                            <div class="ai-sub">${statusLabel[e.status] || 'In library'}</div>
                        </div>
                        <div class="activity-date">${new Date(e.addedAt || e.createdAt).toLocaleDateString()}</div>
                    </div>`;
                });
                cont.innerHTML = html;
            }
        } catch(e) {
            cont.innerHTML = '<div class="empty-state"><i class="bi bi-clock-history"></i><p>Could not load activity.</p></div>';
        }
    }

    // Friend Button Management
    async function renderFriendButton(profile) {
        const container = document.getElementById('friendBtnContainer');
        const targetId = profile._id || profile.id;
        container.innerHTML = '<div class="text-muted small text-center py-1"><i class="bi bi-arrow-repeat spin-icon"></i> Loading...</div>';
        try {
            const res = await fetch('/api/friends/status/' + targetId, { credentials: 'include' });
            if (!res.ok) { container.innerHTML = ''; return; }
            const data = await res.json();
            container.innerHTML = '';

            if (data.status === 'friends') {
                const btn = document.createElement('div');
                btn.className = 'd-flex gap-2 mt-1';
                btn.innerHTML = `
                    <button class="btn btn-success btn-sm flex-fill" disabled>
                        <i class="bi bi-person-check me-1"></i> Friends
                    </button>
                    <button class="btn btn-outline-danger btn-sm" title="Remove Friend" onclick="removeFriend('${targetId}')">
                        <i class="bi bi-person-x"></i>
                    </button>`;
                container.appendChild(btn);
            } else if (data.status === 'pending_sent') {
                container.innerHTML = `<button class="btn btn-secondary btn-sm w-100 mt-1" disabled>
                    <i class="bi bi-hourglass me-1"></i> Request Sent
                </button>`;
            } else if (data.status === 'pending_received') {
                container.innerHTML = `<div class="d-flex gap-2 mt-1">
                    <button class="btn btn-success btn-sm flex-fill" onclick="acceptFriendReq('${data.requestId}')">
                        <i class="bi bi-check"></i> Accept
                    </button>
                    <button class="btn btn-outline-danger btn-sm" onclick="rejectFriendReq('${data.requestId}')">
                        <i class="bi bi-x"></i>
                    </button></div>`;
            } else {
                container.innerHTML = `<button class="btn btn-outline-primary btn-sm w-100 mt-1" onclick="sendFriendReq('${targetId}', this)">
                    <i class="bi bi-person-plus me-1"></i> Add Friend
                </button>`;
            }
        } catch(e) { container.innerHTML = ''; }
    }

    async function removeFriend(id) {
        if (!confirm('Remove this friend?')) return;
        await fetch('/api/friends/' + id, { method: 'DELETE', credentials: 'include' });
        location.reload();
    }
    async function sendFriendReq(id, btn) {
        btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass me-1"></i> Sending...';
        const r = await fetch('/api/friends/request/' + id, { method: 'POST', credentials: 'include' });
        if (r.ok) btn.innerHTML = '<i class="bi bi-check me-1"></i> Sent!';
        else { btn.disabled = false; btn.innerHTML = '<i class="bi bi-person-plus me-1"></i> Add Friend'; }
    }
    async function acceptFriendReq(reqId) {
        await fetch('/api/friends/accept/' + reqId, { method: 'POST', credentials: 'include' });
        location.reload();
    }
    async function rejectFriendReq(reqId) {
        await fetch('/api/friends/reject/' + reqId, { method: 'POST', credentials: 'include' });
        location.reload();
    }

    async function loadFriendsList(userId) {
        const container = document.getElementById('friendsListContainer');
        const countEl = document.getElementById('friendsCount');
        const findBtn = document.getElementById('findFriendsBtn');
        try {
            if (!isOwnProfile) {
                container.innerHTML = '<div class="empty-state"><i class="bi bi-lock"></i><p>Friends list is private.</p></div>';
                return;
            }
            if (findBtn) findBtn.style.display = '';

            const res = await fetch('/api/friends', { credentials: 'include' });
            if (!res.ok) { container.innerHTML = '<div class="text-muted small">Could not load friends.</div>'; return; }
            const friends = await res.json();
            countEl.textContent = friends.length;

            if (friends.length === 0) {
                container.innerHTML = `<div class="empty-state">
                    <i class="bi bi-people"></i>
                    <p>No friends yet. Use the Find button to connect!</p>
                </div>`;
                return;
            }
            let html = '';
            friends.forEach(f => {
                const img = f.avatar || AVATAR_FALLBACK;
                const name = (f.displayName || f.username).replace(/</g,'&lt;');
                html += `<a href="/profile?user=${f._id}" class="friend-card">
                    <img src="${img}" onerror="this.src='${AVATAR_FALLBACK}'">
                    <div><div class="fc-name">${name}</div><div class="fc-sub">@${f.username}</div></div>
                    <button class="fc-remove" title="Remove friend" onclick="event.preventDefault();event.stopPropagation();removeFriend('${f._id}')">
                        <i class="bi bi-person-x"></i>
                    </button>
                </a>`;
            });
            container.innerHTML = html;
        } catch(e) { container.innerHTML = '<div class="text-muted small">Could not load friends.</div>'; }
    }

    async function loadFriendRequests() {
        const contWrapper = document.getElementById('friendRequestsContainer');
        const cont = document.getElementById('friendRequestsList');
        const badge = document.getElementById('reqBadge');
        try {
            const res = await fetch('/api/friends/requests', { credentials: 'include' });
            if (!res.ok) return;
            const reqs = await res.json();
            if (reqs.length === 0) return;

            contWrapper.style.display = '';
            if (badge) badge.textContent = reqs.length;
            let html = '';
            reqs.forEach(r => {
                const from = r.from || {};
                const img = from.avatar || AVATAR_FALLBACK;
                const name = (from.displayName || from.username || '').replace(/</g,'&lt;');
                html += `<div class="req-card">
                    <img src="${img}" onerror="this.src='${AVATAR_FALLBACK}'">
                    <a href="/profile?user=${from._id}" class="req-name text-decoration-none">${name}<br><small style="color:#64748b">@${from.username||''}</small></a>
                    <button class="btn btn-sm btn-success py-0 px-2" onclick="acceptFriendReq('${r._id}')" title="Accept"><i class="bi bi-check"></i></button>
                    <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="rejectFriendReq('${r._id}')" title="Decline"><i class="bi bi-x"></i></button>
                </div>`;
            });
            cont.innerHTML = html;
        } catch(e) {}
    }

    // Share Btn
    document.getElementById('shareProfileBtn')?.addEventListener('click', () => {
        const url = `${window.location.origin}/profile?user=${viewingUserId}`;
        navigator.clipboard.writeText(url).then(() => {
            const btn = document.getElementById('shareProfileBtn');
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check2 me-2"></i> Copied!';
            btn.classList.add('btn-success');
            btn.classList.remove('btn-outline-secondary');
            setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('btn-success'); btn.classList.add('btn-outline-secondary'); }, 2000);
        });
    });

    // Find Friends modal search
    document.getElementById('friendSearchBtn')?.addEventListener('click', () => {
        const q = document.getElementById('friendSearchInput').value.trim();
        if (q.length < 2) return;
        searchFriends(q);
    });
    document.getElementById('friendSearchInput')?.addEventListener('keydown', e => {
        if (e.key === 'Enter') document.getElementById('friendSearchBtn').click();
    });

    async function searchFriends(q) {
        const results = document.getElementById('friendSearchResults');
        results.innerHTML = '<div class="text-muted small p-2"><i class="bi bi-arrow-repeat"></i> Searching...</div>';
        try {
            const res = await fetch('/api/users/search/friends?q=' + encodeURIComponent(q), { credentials: 'include' });
            if (!res.ok) throw new Error();
            const users = await res.json();
            if (!users.length) { results.innerHTML = '<div class="text-muted small p-2">No users found.</div>'; return; }
            let html = '';
            users.forEach(u => {
                const img = u.avatar || AVATAR_FALLBACK;
                const name = (u.displayName || u.username).replace(/</g,'&lt;');
                html += `<div class="d-flex align-items-center gap-2 p-2" style="border-bottom:1px solid rgba(255,255,255,0.05);">
                    <img src="${img}" style="width:32px;height:32px;border-radius:6px;object-fit:cover;" onerror="this.src='${AVATAR_FALLBACK}'">
                    <div style="flex:1"><div class="text-white small fw-bold">${name}</div><div style="color:#64748b;font-size:0.75rem">@${u.username}</div></div>
                    <button class="btn btn-sm btn-outline-primary py-0 px-2" onclick="sendFriendReq('${u._id}',this)"><i class="bi bi-person-plus"></i></button>
                    <a href="/profile?user=${u._id}" class="btn btn-sm btn-outline-secondary py-0 px-2"><i class="bi bi-eye"></i></a>
                </div>`;
            });
            results.innerHTML = html;
        } catch(e) { results.innerHTML = '<div class="text-danger small p-2">Search failed.</div>'; }
    }

    // Init
    async function initProfile() {
        const params = new URLSearchParams(window.location.search);
        const viewUserId = params.get('user');

        try {
            const res = await fetch('/api/auth/current', { method: 'GET', credentials: 'include' });
            if (res.ok) currentUser = await res.json();
        } catch (e) { }

        if (!currentUser) { window.location.href = '/login'; return; }

        if (viewUserId && viewUserId !== currentUser._id) {
            isOwnProfile = false;
            viewingUserId = viewUserId;
            try {
                const res = await fetch('/api/users/' + viewUserId, { credentials: 'include' });
                if (res.ok) renderProfile(await res.json());
                else document.querySelector('.profile-wrapper').innerHTML = '<h4 class="text-white mt-5 text-center">User not found</h4>';
            } catch(e) {}
        } else {
            isOwnProfile = true;
            viewingUserId = currentUser._id;
            renderProfile(currentUser);
        }
    }

    // Global transitions
    document.querySelectorAll('a[href]').forEach(a => {
        if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
            a.addEventListener('click', () => { document.body.classList.add('page-exit'); });
        }
    });

    window.addEventListener('load', initProfile);
</script>