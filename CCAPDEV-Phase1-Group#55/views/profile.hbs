        /* Profile action buttons */
        .profile-actions .btn { border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 700; padding: 8px 16px; transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease); text-transform: uppercase; letter-spacing: 0.5px; }
        .profile-actions .btn-primary { background: var(--gradient-primary); border: none; box-shadow: 0 4px 14px rgba(83, 131, 232, 0.35); }
        .profile-actions .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(83, 131, 232, 0.45); }
        .profile-actions .btn-outline-primary { border-width: 2px; }
