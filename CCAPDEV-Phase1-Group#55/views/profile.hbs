        .stat-value { font-size: 1.5rem; font-weight: 800; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .section-grid { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 16px; }
        .section-card { background: rgba(20,28,36,0.92); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease); position: relative; overflow: hidden; }
        .section-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--primary), var(--accent), transparent); opacity: 0; transition: opacity 0.3s; }
