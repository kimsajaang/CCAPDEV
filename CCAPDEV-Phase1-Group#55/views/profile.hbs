        .achievement-locked-text { font-size: 0.7rem; color: var(--text-faint); font-style: italic; }
        .unlock-badge { display: inline-block; background: linear-gradient(135deg, var(--warning), #ffa500); color: var(--bg-base); border-radius: 6px; padding: 3px 8px; font-size: 0.65rem; font-weight: 800; margin-top: 8px; text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(254, 188, 46, 0.25); animation: pulseGlow 2s ease-in-out infinite; will-change: box-shadow; }
