{{> navbar-app activePage="profile"}}

<style>
    /* ─── Modern Gaming Dashboard Aesthetics ─── */
    :root {
        --bg-deep: #0b0e13;
        --card-bg: rgba(22, 32, 45, 0.85);
        --card-border: rgba(255, 255, 255, 0.08);
        --primary: #5383e8;
        --primary-glow: rgba(83, 131, 232, 0.2);
    }

    body {
        background-color: var(--bg-deep) !important;
        background-image: 
            radial-gradient(at 0% 0%, rgba(30, 45, 60, 0.4) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(20, 30, 40, 0.3) 0px, transparent 50%),
            var(--profile-bg, none);
        background-size: cover;
        background-position: center top;
        background-attachment: fixed;
        color: #acb2b8;
    }

    .profile-wrapper {
        max-width: 1040px;
        margin: 40px auto;
        padding: 0 15px;
    }

    /* ─── Header ─── */
    .profile-header {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 30px;
        display: flex;
        gap: 30px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.4);
        position: relative;
        overflow: hidden;
    }
    
    .profile-header::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--primary), #a78bfa);
        opacity: 0.8;
    }

    .avatar-container {
        position: relative;
        width: 150px;
        height: 150px;
        flex-shrink: 0;
    }

    .modern-avatar {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        object-fit: cover;
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
        border: 2px solid rgba(255,255,255,0.05);
        background: #10151c;
    }

    .online-indicator {
        position: absolute;
        bottom: -6px;
        right: -6px;
        width: 32px;
        height: 32px;
        background: #10b981;
        border: 4px solid var(--card-bg);
        border-radius: 50%;
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
    }

    .header-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 2;
    }

    .display-name {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        font-size: 2.2rem;
        color: #fff;
        margin-bottom: 2px;
        letter-spacing: -0.02em;
    }

    .username {
        font-size: 0.95rem;
        color: var(--primary);
        font-weight: 600;
        margin-bottom: 12px;
    }

    .bio {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #94a3b8;
        max-width: 500px;
    }

    .header-actions {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        min-width: 140px;
        z-index: 2;
    }

    /* ─── Metrics Row ─── */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin: 25px 0;
    }

    .metric-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 10px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: transform 0.2s, border-color 0.2s;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255,255,255,0.2);
        cursor: pointer;
    }

    /* Trophy hover */
    .trophy-item {
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .trophy-item:hover {
        transform: translateY(-4px) scale(1.04);
        box-shadow: 0 8px 24px rgba(83,131,232,0.35);
        border-color: var(--primary) !important;
    }
    .trophy-item .trophy-label {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        background: linear-gradient(0deg, rgba(0,0,0,0.85), transparent);
        color: #fff;
        font-size: 0.62rem;
        padding: 6px 4px 3px;
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        opacity: 0;
        transition: opacity 0.2s;
        font-weight: 600;
    }
    .trophy-item:hover .trophy-label { opacity: 1; }
    .trophy-item { position: relative; }

    /* Friend card */
    .friend-card {
        display: flex; align-items: center;
        gap: 10px; padding: 8px 10px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s;
        margin-bottom: 6px;
    }
    .friend-card:hover { background: rgba(255,255,255,0.05); }
    .friend-card img { width:34px;height:34px;border-radius:8px;object-fit:cover;flex-shrink:0; }
    .friend-card .fc-name { color:#fff;font-weight:700;font-size:0.85rem;line-height:1.1; }
    .friend-card .fc-sub { color:#64748b;font-size:0.72rem; }
    .friend-card .fc-remove {
        margin-left:auto; background:transparent; border:none;
        color:#64748b; font-size:0.8rem; cursor:pointer;
        padding:4px 6px; border-radius:6px; transition:color 0.15s,background 0.15s;
    }
    .friend-card .fc-remove:hover { color:#ef4444; background:rgba(239,68,68,0.1); }

    /* Req card */
    .req-card { display:flex;align-items:center;gap:8px;margin-bottom:10px; }
    .req-card img { width:30px;height:30px;border-radius:6px;object-fit:cover; }
    .req-card .req-name { color:#fff;font-weight:600;font-size:0.82rem;flex:1; }

    /* Empty state */
    .empty-state { text-align:center;padding:28px 16px;color:#4b5563; }
    .empty-state i { font-size:2.2rem;display:block;margin-bottom:10px;opacity:0.5; }
    .empty-state p { font-size:0.85rem;margin-bottom:12px; }

    /* Pulse animation for online dot */
    @keyframes pulse-green {
        0%,100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.5); }
        50% { box-shadow: 0 0 0 6px rgba(16,185,129,0); }
    }
    .online-indicator { animation: pulse-green 2s infinite; }

    /* Activity item */
    .activity-item {
        display:flex;align-items:center;gap:12px;
        padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.04);
    }
    .activity-item:last-child{border-bottom:none;}
    .activity-cover{width:36px;height:48px;border-radius:4px;object-fit:cover;flex-shrink:0;}
    .activity-info{flex:1;min-width:0;}
    .activity-info .ai-title{color:#fff;font-weight:600;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .activity-info .ai-sub{color:#5383e8;font-size:0.75rem;margin-top:2px;}
    .activity-date{color:#4b5563;font-size:0.72rem;white-space:nowrap;}

    /* Achievement badge */
    .ach-badge{
        display:inline-flex;flex-direction:column;align-items:center;
        width:72px;text-align:center;margin:4px;
    }
    .ach-icon{
        width:52px;height:52px;border-radius:12px;
        background:linear-gradient(135deg,rgba(255,255,255,0.06),rgba(0,0,0,0.2));
        border:1px solid rgba(255,255,255,0.12);
        display:flex;align-items:center;justify-content:center;
        font-size:1.5rem;color:#fbbf24;
        transition:transform 0.2s,box-shadow 0.2s;
        cursor:default;
    }
    .ach-icon:hover{transform:scale(1.1);box-shadow:0 0 16px rgba(251,191,36,0.3);}
    .ach-lbl{font-size:0.62rem;color:#94a3b8;margin-top:4px;line-height:1.2;}

    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(255,255,255,0.03);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .metric-data {
        display: flex;
        flex-direction: column;
    }

    .metric-val {
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
    }

    .metric-lbl {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 4px;
        font-weight: 600;
    }

    /* ─── Dashboard Blocks ─── */
    .dash-block {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 10px;
        margin-bottom: 20px;
        overflow: hidden;
    }

    .dash-header {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        color: #fff;
    }

    .dash-body {
        padding: 20px;
    }

    /* Trophy Grid */
    .trophy-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
        gap: 12px;
    }

    .trophy-item {
        aspect-ratio: 3/4;
        background: #0f1519;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .trophy-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Badges */
    .badge-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(0,0,0,0.2));
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        font-size: 1.5rem;
        margin: 0 8px 8px 0;
        color: #fbbf24;
    }

    /* Sidebar Status */
    .status-panel {
        text-align: center;
        padding: 24px;
    }
    
    .status-text {
        font-size: 1.1rem;
        font-weight: 700;
        color: #10b981;
        margin-bottom: 8px;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .profile-header { flex-direction: column; text-align: center; align-items: center; }
        .metrics-grid { grid-template-columns: 1fr 1fr; }
    }
</style>

