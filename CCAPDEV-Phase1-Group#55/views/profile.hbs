        .avatar-img { width: 150px; height: 150px; border: 4px solid var(--bg-base); background: var(--bg-base); background-clip: padding-box; box-shadow: 0 0 0 3px var(--primary), 0 16px 40px rgba(0, 0, 0, 0.6); transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease); border-radius: 50%; flex-shrink: 0; margin-top: 20px;}
        .avatar-img:hover { box-shadow: 0 0 0 3px var(--accent), 0 0 50px rgba(45, 212, 191, 0.4), 0 0 70px rgba(83, 131, 232, 0.2); transform: scale(1.05); }
        .profile-header-text { margin-top: 90px; }
        .profile-name { font-weight: 900; letter-spacing: -0.04em; margin-bottom: 2px; font-size: 2.6rem; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1.1; }
        .profile-handle { color: var(--text-muted); font-size: 1.05rem; font-weight: 500; margin-bottom: 12px; }
        .profile-top { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.05); margin-bottom: 24px;}
        .profile-meta { display: flex; flex-wrap: wrap; gap: 16px; color: var(--text-secondary); font-size: 0.95rem; }
        .profile-meta i { color: var(--primary); }
        .stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 14px; }
        .stat-card { background: rgba(20,28,36,0.92); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 16px; text-align: center; transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease); position: relative; overflow: hidden; }
        .stat-card::before { content: ''; position: absolute; top: -50%; right: -50%; width: 100%; height: 100%; background: radial-gradient(circle, rgba(83, 131, 232, 0.06), transparent 70%); pointer-events: none; transition: opacity 0.3s; opacity: 0; }
        .stat-card:hover::before { opacity: 1; }
