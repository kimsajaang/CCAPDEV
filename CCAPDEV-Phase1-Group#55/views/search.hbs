<style>
        /* Page-specific: search overrides */
        .card-title { color: #dbe7ff; }
        .search-container { background: linear-gradient(180deg, rgba(20,28,36,0.6) 0%, transparent 100%); padding: 50px 0 40px; border-bottom: 1px solid var(--border); position: relative; }
        .search-container::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 600px; height: 300px; background: radial-gradient(ellipse, rgba(83,131,232,0.12), transparent 70%); pointer-events: none; }
        .game-cover { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: transform 0.4s var(--ease); }
        .card:hover .game-cover { transform: scale(1.06); }
        .card .card-img-top-wrap { overflow: hidden; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
        .animate-card { opacity: 0; animation: fadeInUp 0.5s var(--ease-out) forwards; }
        .animate-card:nth-child(1) { animation-delay: 0.05s; }
        .animate-card:nth-child(2) { animation-delay: 0.1s; }
        .animate-card:nth-child(3) { animation-delay: 0.15s; }
        .animate-card:nth-child(4) { animation-delay: 0.2s; }
        .animate-card:nth-child(5) { animation-delay: 0.25s; }
        .animate-card:nth-child(6) { animation-delay: 0.3s; }
        .animate-card:nth-child(7) { animation-delay: 0.35s; }
        .animate-card:nth-child(8) { animation-delay: 0.4s; }
        .animate-card:nth-child(9) { animation-delay: 0.45s; }
        .animate-card:nth-child(10) { animation-delay: 0.5s; }
        .search-input-wrap { position: relative; }
        .search-input-wrap .form-control { border-radius: var(--radius-lg); padding: 14px 20px 14px 48px; font-size: 1rem; border: 1px solid var(--border); background: var(--bg-input) !important; transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease); }
        .search-input-wrap .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-glow), 0 0 40px rgba(83,131,232,0.1); }
        .search-input-wrap .search-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-faint); font-size: 1.1rem; transition: color 0.2s; z-index: 5; }
        .search-input-wrap:focus-within .search-icon { color: var(--primary); }
        .search-btn-hero { border-radius: var(--radius-lg); padding: 0 24px; }
        /* Card hover glow */
        .card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--gradient-primary); opacity: 0; transition: opacity 0.3s ease; }
        .card:hover::after { opacity: 1; }
        .results-count { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem; }
    </style>{{> navbar-app activePage="search"}}

    <!-- Search bar section — centered large input with search button.
         Uses input-group-lg so it feels prominent.
         The placeholder text "400,000+ games" is just flavor text for now. -->
    <header class="search-container text-center">
        <div class="container">
            <h2 class="mb-2" style="font-weight:900;">Find your next <span class="gradient-text">adventure</span></h2>
            <p class="text-muted mb-4">Discover from 400,000+ games across every platform</p>
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="search-input-wrap" style="position: relative;">
                        <i class="bi bi-search search-icon"></i>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control" placeholder="Search games..." autocomplete="off" style="flex: 1;">
                            <button class="btn btn-primary search-btn-hero" type="button">Search</button>
                        </div>
                        <!-- Autocomplete dropdown -->
                        <div id="autocompleteDropdown" style="position: absolute; top: 100%; left: 0; right: 90px; background: #1c252e; border: 1px solid #2a3843; border-top: none; max-height: 300px; overflow-y: auto; display: none; z-index: 1000; border-radius: 0 0 0.25rem 0.25rem;"></div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Results grid — dynamically populated by search -->
    <main class="container my-5">
        <h4 class="mb-4 text-muted">Search for games above to get started</h4>
        <div class="row row-cols-1 row-cols-md-5 g-4"></div>
    </main>

    <!-- Toast -->
    <div style="position:fixed;bottom:20px;right:20px;z-index:1080">
        <div class="toast align-items-center border-0" id="searchToast" role="alert">
            <div class="d-flex"><div class="toast-body" id="searchToastMsg"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
        </div>
    </div>

    <!-- Game Detail Modal -->
    <div class="modal fade" id="gameDetailModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" style="background-color: #1c252e; border: 1px solid #2a3843;">
                <div class="modal-header" style="border-bottom: 1px solid #2a3843;">
                    <h5 class="modal-title" id="gameTitle" style="color: #dbe7ff;"></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Game Cover & Key Info -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <img id="gameCover" src="" alt="Game Cover" loading="lazy" style="width: 100%; border-radius: 0.5rem; border: 1px solid #2a3843;">
                        </div>
                        <div class="col-md-8">
                            <div class="mb-3">
                                <h6 class="text-muted mb-2">Rating</h6>
                                <div id="gameRating" style="font-size: 1.5rem; color: #febc2e;">★★★★★ 96/100</div>
                            </div>
                            <div class="mb-3">
                                <h6 class="text-muted mb-2">Release Date</h6>
                                <p id="gameReleaseDate" class="mb-0">-</p>
                            </div>
                            <div class="mb-3">
                                <h6 class="text-muted mb-2">Genres</h6>
                                <p id="gameGenres" class="mb-0">-</p>
                            </div>
                            <div class="mb-3">
                                <h6 class="text-muted mb-2">Platforms</h6>
                                <p id="gamePlatforms" class="mb-0">-</p>
                            </div>
                            <button class="btn btn-primary w-100" id="addFromDetailBtn">+ Add to Library</button>
                        </div>
                    </div>

                    <!-- Summary -->
                    <div class="mb-4">
                        <h6 class="text-muted mb-2">About</h6>
                        <p id="gameSummary" style="color: #a8c0e0; line-height: 1.6;">-</p>
                    </div>

                    <!-- Screenshots -->
                    <div class="mb-4" id="screenshotsSection" style="display: none;">
                        <h6 class="text-muted mb-3">Screenshots</h6>
                        <div class="row g-2" id="gameScreenshots"></div>
                    </div>

                    <!-- Companies/Developers -->
                    <div id="companiesSection" style="display: none;">
                        <h6 class="text-muted mb-2">Developer</h6>
                        <p id="gameDeveloper" class="mb-0">-</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- IGDB search integration script with autocomplete.
         Calls our Express proxy at /api/games/search.
         The proxy handles Twitch auth + IGDB API so we don't expose keys in the browser. -->
    <script>
      const searchInput = document.querySelector('.search-container input');
      const searchBtn = document.querySelector('.search-container .btn-primary');
      const resultsGrid = document.querySelector('main .row');
      const sectionTitle = document.querySelector('main h4');
      const autocompleteDropdown = document.getElementById('autocompleteDropdown');
      const detailModal = new bootstrap.Modal(document.getElementById('gameDetailModal'));

      let autocompleteCache = new Map();
      let autocompleteTimeout;
      let currentGameDetail = null;
      let isLoggedIn = false;
      let searchUserId = null;
      let searchUserLibrary = [];

      // Check authentication status
      async function checkAuth() {
        try {
          const response = await fetch('/api/auth/current', {
            method: 'GET',
            credentials: 'include'
          });
          isLoggedIn = response.ok;
          
          if (isLoggedIn) {
            const userData = await response.json();
            searchUserId = userData._id || userData.id;
            // Fetch server library for "already added" checks
            try {
              const libRes = await fetch('/api/library/' + searchUserId, { credentials: 'include' });
              if (libRes.ok) searchUserLibrary = await libRes.json();
            } catch (e) { /* ignore */ }
          }

          // Update ALL navbar visibility based on auth status
          if (isLoggedIn) {
            // Show auth-required elements, hide preview-only
            document.querySelectorAll('[data-auth-required="true"]').forEach(el => {
              el.style.display = '';
            });
            document.querySelectorAll('[data-preview-only="true"]').forEach(el => {
              el.style.display = 'none';
            });
          } else {
            // Hide auth-required elements, show preview-only
            document.querySelectorAll('[data-auth-required="true"]').forEach(el => {
              el.style.display = 'none';
            });
            document.querySelectorAll('[data-preview-only="true"]').forEach(el => {
              el.style.display = '';
            });
          }
        } catch (err) {
          isLoggedIn = false;
        }
      }

      // Initialize auth check
      window.addEventListener('load', () => {
        checkAuth();
      });

      // Check if coming from library with a search query
      const storedQuery = localStorage.getItem('bh_search_query');
      if (storedQuery) {
        searchInput.value = storedQuery;
        localStorage.removeItem('bh_search_query');
        // Auto-search after page loads
        setTimeout(() => searchGames(storedQuery), 300);
      }

      async function getAutocompleteSuggestions(query) {
        if (!query || query.length < 2) {
          autocompleteDropdown.style.display = 'none';
          return;
        }

        // Check cache first
        if (autocompleteCache.has(query)) {
          displayAutocompleteSuggestions(autocompleteCache.get(query), query);
          return;
        }

        try {
          const res = await fetch('/api/games/search', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: query.trim(), limit: 8 })
          });

          if (!res.ok) return;
          const games = await res.json();
          
          // Cache the results
          autocompleteCache.set(query, games);
          displayAutocompleteSuggestions(games, query);
        } catch (err) {
          console.error('Autocomplete failed:', err);
        }
      }

      function displayAutocompleteSuggestions(games, query) {
        if (!games || games.length === 0) {
          autocompleteDropdown.style.display = 'none';
          return;
        }

        const html = games.map(game => `
          <div class="dropdown-item" style="cursor: pointer; padding: 10px 15px; border-bottom: 1px solid #2a3843; color: #9e9e9e; transition: background-color 0.15s, color 0.15s;" onmouseover="this.style.backgroundColor='#2a3843'; this.style.color='#ffffff';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#9e9e9e';" onclick="selectGame('${game.name}')" data-name="${game.name}">
            <span>${game.name}</span>
            ${game.first_release_date ? `<span style="margin-left: 8px; font-size: 0.8rem; color: #6b7b8d;">(${new Date(game.first_release_date * 1000).getFullYear()})</span>` : ''}
          </div>
        `).join('');

        autocompleteDropdown.innerHTML = html;
        autocompleteDropdown.style.display = 'block';
      }

      function selectGame(gameName) {
        searchInput.value = gameName;
        autocompleteDropdown.style.display = 'none';
        searchGames(gameName);
      }

      // Fetch and display game details
      async function openGameDetail(game) {
        currentGameDetail = game;
        
        try {
          // Fetch full game details from IGDB
          const res = await fetch('/api/games/igdb/' + game.id, {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
          });
          
          if (res.ok) {
            const fullGame = await res.json();
            
            // Populate modal
            document.getElementById('gameTitle').textContent = game.name;
            
            // Cover image
            const coverUrl = game.cover
              ? 'https:' + game.cover.url.replace('t_thumb', 't_cover_big')
              : 'https://via.placeholder.com/264x352/1c252e/9e9e9e?text=No+Cover';
            document.getElementById('gameCover').src = coverUrl;
            
            // Rating (IGDB's rating is 0-100)
            const rating = game.rating ? Math.round(game.rating) : 0;
            const stars = Math.round(rating / 20);
            document.getElementById('gameRating').innerHTML = `${'★'.repeat(stars)}${'☆'.repeat(5-stars)} ${rating}/100`;
            
            // Release date
            if (game.first_release_date) {
              const date = new Date(game.first_release_date * 1000);
              document.getElementById('gameReleaseDate').textContent = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            }
            
            // Genres
            if (game.genres) {
              document.getElementById('gameGenres').textContent = game.genres.map(g => g.name).join(', ');
            }
            
            // Platforms
            if (fullGame.platforms) {
              document.getElementById('gamePlatforms').textContent = fullGame.platforms.map(p => p.name).join(', ');
            }
            
            // Summary
            if (game.summary) {
              document.getElementById('gameSummary').textContent = game.summary;
            } else {
              document.getElementById('gameSummary').textContent = 'No description available.';
            }
            
            // Screenshots
            if (fullGame.screenshots && fullGame.screenshots.length > 0) {
              const screenshotsHtml = fullGame.screenshots.slice(0, 4).map(ss => `
                <div class="col-6">
                  <img src="https:${ss.url.replace('t_thumb', 't_screenshot_big')}" alt="Screenshot" loading="lazy" style="width: 100%; border-radius: 0.5rem; border: 1px solid #2a3843; cursor: pointer;" onclick="window.open(this.src, '_blank')">
                </div>
              `).join('');
              document.getElementById('gameScreenshots').innerHTML = screenshotsHtml;
              document.getElementById('screenshotsSection').style.display = 'block';
            } else {
              document.getElementById('screenshotsSection').style.display = 'none';
            }
            
            // Developer
            if (fullGame.involved_companies) {
              const developers = fullGame.involved_companies
                .filter(c => c.developer)
                .map(c => c.company.name)
                .join(', ');
              if (developers) {
                document.getElementById('gameDeveloper').textContent = developers;
                document.getElementById('companiesSection').style.display = 'block';
              }
            }
            
            detailModal.show();
          }
        } catch (err) {
          console.error('Failed to fetch game details:', err);
          detailModal.show();
        }
      }

      // Autocomplete on input
      searchInput.addEventListener('input', (e) => {
        clearTimeout(autocompleteTimeout);
        autocompleteTimeout = setTimeout(() => {
          getAutocompleteSuggestions(e.target.value);
        }, 300);
      });

      // Hide dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.search-container')) {
          autocompleteDropdown.style.display = 'none';
        }
      });

      async function searchGames(query) {
        if (!query.trim()) {
          sectionTitle.textContent = 'Search for games above to get started';
          resultsGrid.innerHTML = '';
          autocompleteDropdown.style.display = 'none';
          return;
        }

        // show loading state
        sectionTitle.textContent = `Searching for "${query}"...`;
        resultsGrid.innerHTML = `
          <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-3">Searching IGDB...</p>
          </div>
        `;
        autocompleteDropdown.style.display = 'none';

        try {
          const res = await fetch('/api/games/search', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: query.trim(), limit: 20 })
          });

          if (!res.ok) throw new Error('Server error');
          let games = await res.json();

          // Sort by relevance — exact matches first
          const queryLower = query.trim().toLowerCase();
          games.sort((a, b) => {
            const aName = a.name.toLowerCase();
            const bName = b.name.toLowerCase();
            
            // Exact match has highest priority
            if (aName === queryLower) return -1;
            if (bName === queryLower) return 1;
            
            // Starts with query has second priority
            if (aName.startsWith(queryLower) && !bName.startsWith(queryLower)) return -1;
            if (bName.startsWith(queryLower) && !aName.startsWith(queryLower)) return 1;
            
            // Rating (higher rated games first)
            if (a.rating !== b.rating) {
              return (b.rating || 0) - (a.rating || 0);
            }
            
            return 0;
          });

          if (games.length === 0) {
            sectionTitle.textContent = `No results for "${query}"`;
            resultsGrid.innerHTML = `
              <div class="col-12 text-center py-5">
                <p class="text-muted">No games found. Try a different search term.</p>
              </div>
            `;
            return;
          }

          sectionTitle.textContent = `Results for "${query}" (${games.length} found)`;

          // IGDB cover URLs come as //images.igdb.com/... so we prepend https:
          // and swap t_thumb for t_cover_big to get quality (264x352px)

          resultsGrid.innerHTML = games.map(game => {
            const coverUrl = game.cover
              ? 'https:' + game.cover.url.replace('t_thumb', 't_cover_big')
              : 'https://via.placeholder.com/264x352/1c252e/9e9e9e?text=No+Cover';

            const year = game.first_release_date
              ? new Date(game.first_release_date * 1000).getFullYear()
              : 'TBA';

            const genres = game.genres
              ? game.genres.map(g => g.name).slice(0, 2).join(' • ')
              : 'Game';

            const rating = game.rating
              ? Math.round(game.rating) + '/100'
              : '';

          const alreadyAdded = searchUserLibrary.some(e => e.gameId && e.gameId.name && e.gameId.name.toLowerCase() === game.name.toLowerCase());

            return `
              <div class="col">
                <div class="card h-100 shadow-sm game-result-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" data-game='${JSON.stringify(game).replace(/'/g, "&#39;")}'>
                  <img src="${coverUrl}" class="card-img-top game-cover" alt="${game.name}" loading="lazy"
                       onerror="this.src='https://via.placeholder.com/264x352/1c252e/9e9e9e?text=No+Cover'">
                  <div class="card-body">
                    <h6 class="card-title">${game.name}</h6>
                    <p class="card-text small text-muted">${genres} • ${year} ${rating ? '• ' + rating : ''}</p>
                    <button class="btn btn-sm ${alreadyAdded ? 'btn-success disabled' : 'btn-outline-primary'} w-100 add-lib-btn"
                            data-name="${game.name}"
                            data-genre="${genres}"
                            data-year="${year}"
                            data-cover="${coverUrl}"
                            ${alreadyAdded ? 'disabled' : ''}>${alreadyAdded ? '✓ Already in Library' : '+ Add to Library'}</button>
                  </div>
                </div>
              </div>
            `;
          }).join('');

        } catch (err) {
          console.error('Search failed:', err);
          sectionTitle.textContent = 'Search unavailable';
          resultsGrid.innerHTML = `
            <div class="col-12 text-center py-5">
              <p class="text-muted">Could not connect to the game database.</p>
              <p class="text-muted small">Make sure the server is running: <code>npm start</code></p>
            </div>
          `;
        }
      }

      // Search on button click
      searchBtn.addEventListener('click', () => searchGames(searchInput.value));

      // Search on Enter key
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          searchGames(searchInput.value);
          autocompleteDropdown.style.display = 'none';
        }
      });

      /* ---- Add to Library integration (server API) ---- */
      async function addGameToServer(name, genres, year, coverUrl) {
        const genresArr = genres ? genres.split(' \u2022 ').map(g => g.trim()) : [];
        const yearNum = parseInt(year) || 0;
        const releaseDate = yearNum ? new Date(yearNum, 0, 1).toISOString() : null;

        // Create Game document
        const gameRes = await fetch('/api/games', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, coverUrl: coverUrl || '', genres: genresArr, releaseDate })
        });
        if (!gameRes.ok) throw new Error('Failed to create game');
        const { game } = await gameRes.json();

        // Add to library
        const libRes = await fetch('/api/library', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: searchUserId, gameId: game._id, status: 'backlog' })
        });
        if (!libRes.ok) throw new Error('Failed to add to library');

        // Refresh the cached library
        try {
          const lr = await fetch('/api/library/' + searchUserId, { credentials: 'include' });
          if (lr.ok) searchUserLibrary = await lr.json();
        } catch (e) { /* ignore */ }
      }

      function searchToast(msg, bg) {
        const el = document.getElementById('searchToast');
        el.className = 'toast align-items-center border-0 text-white ' + bg;
        document.getElementById('searchToastMsg').textContent = msg;
        bootstrap.Toast.getOrCreateInstance(el, { delay: 2500 }).show();
      }

      // Add from detail modal
      document.getElementById('addFromDetailBtn').addEventListener('click', async () => {
        if (!isLoggedIn) {
          searchToast('Please log in to add games to your library', 'bg-warning');
          setTimeout(() => {
            window.location.href = 'login.html';
          }, 1500);
          return;
        }

        if (!currentGameDetail) return;
        
        const name = currentGameDetail.name;
        const genres = currentGameDetail.genres
          ? currentGameDetail.genres.map(g => g.name).slice(0, 2).join(' • ')
          : 'Game';
        const year = currentGameDetail.first_release_date
          ? new Date(currentGameDetail.first_release_date * 1000).getFullYear()
          : 0;
        const cover = currentGameDetail.cover
          ? 'https:' + currentGameDetail.cover.url.replace('t_thumb', 't_cover_big')
          : '';
        
        if (searchUserLibrary.some(e => e.gameId && e.gameId.name && e.gameId.name.toLowerCase() === name.toLowerCase())) {
          searchToast(`"${name}" is already in your library!`, 'bg-warning');
          return;
        }
        
        try {
          await addGameToServer(name, genres, String(year), cover);
          document.getElementById('addFromDetailBtn').textContent = '✓ Added';
          document.getElementById('addFromDetailBtn').classList.add('btn-success', 'disabled');
          document.getElementById('addFromDetailBtn').classList.remove('btn-primary');
          document.getElementById('addFromDetailBtn').disabled = true;
          searchToast(`${name} added to Backlog!`, 'bg-success');
        } catch (err) {
          console.error('[Search] Add error:', err);
          searchToast('Failed to add game', 'bg-danger');
        }
      });

      document.addEventListener('click', async e => {
        // Handle Add to Library button
        const btn = e.target.closest('.add-lib-btn');
        if (btn) {
          e.stopPropagation();

          if (!isLoggedIn) {
            searchToast('Please log in to add games to your library', 'bg-warning');
            setTimeout(() => {
              window.location.href = 'login.html';
            }, 1500);
            return;
          }

          const name = btn.dataset.name;
          if (searchUserLibrary.some(e => e.gameId && e.gameId.name && e.gameId.name.toLowerCase() === name.toLowerCase())) {
            searchToast(`"${name}" is already in your library!`, 'bg-warning');
            return;
          }
          try {
            await addGameToServer(name, btn.dataset.genre || '', btn.dataset.year || '0', btn.dataset.cover || '');
            btn.textContent = '✓ Added';
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-success', 'disabled');
            searchToast(`${name} added to Backlog!`, 'bg-success');
          } catch (err) {
            console.error('[Search] Add error:', err);
            searchToast('Failed to add game', 'bg-danger');
          }
          return;
        }

        // Handle card click to open game detail
        const card = e.target.closest('.game-result-card');
        if (card) {
          try {
            const game = JSON.parse(card.dataset.game);
            openGameDetail(game);
          } catch (err) {
            console.error('Failed to parse game data:', err);
          }
        }
      });

      // Smart home navigation - if logged in go to dashboard, else go to index
      async function smartHomeClick(e) {
        e.preventDefault();
        try {
          const res = await fetch('/api/auth/current', { credentials: 'include' });
          const dest = res.ok ? 'dashboard.html' : 'index.html';
          document.body.classList.add('page-exit');
          setTimeout(() => window.location = dest, 300);
        } catch (err) {
          console.error('Auth check failed:', err);
          window.location = 'index.html';
        }
      }

      // Page exit transition
      document.querySelectorAll('a[href]').forEach(a => {
        if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
          a.addEventListener('click', e => {
            e.preventDefault();
            const dest = a.href;
            document.body.classList.add('page-exit');
            setTimeout(() => window.location = dest, 300);
          });
        }
      });

      // Logout function
      async function logout(event) {
        event.preventDefault();
        try {
            await fetch('/api/auth/logout', {
                method: 'POST',
                credentials: 'include'
            });
            window.location.href = 'login.html';
        } catch (err) {
            console.error('Logout failed:', err);
            window.location.href = 'login.html';
        }
      }

      // Reset modal button when closing
      document.getElementById('gameDetailModal').addEventListener('hidden.bs.modal', () => {
        const btn = document.getElementById('addFromDetailBtn');
        btn.textContent = '+ Add to Library';
        btn.classList.remove('btn-success', 'disabled');
        btn.classList.add('btn-primary');
        btn.disabled = false;
      });
    </script>
