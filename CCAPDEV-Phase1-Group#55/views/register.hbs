<style>
		body { background: radial-gradient(circle at 20% 20%, rgba(83, 131, 232, 0.15), transparent 30%), radial-gradient(circle at 80% 0%, rgba(167, 139, 250, 0.1), transparent 25%), radial-gradient(circle at 60% 90%, rgba(45, 212, 191, 0.06), transparent 30%), var(--bg-base); }
		.link-accent { color: var(--primary); text-decoration: none; }
		.link-accent:hover { color: var(--accent); }
		.badge-accent { background: linear-gradient(120deg, var(--accent), var(--primary)); color: #0d1217; }
		.strength-bar { height: 6px; border-radius: var(--radius-full); background: var(--border); overflow: hidden; }
		.strength-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #ff6b6b, #ffd166, #50d6b4, #5383e8); transition: width 0.25s var(--ease); }
		/* Competitive auth card enhancements */
		.auth-card { animation: fadeInScale 0.6s ease both; }
		@keyframes fadeInScale { from { opacity: 0; transform: scale(0.96) translateY(16px); } to { opacity: 1; transform: scale(1) translateY(0); } }
		.auth-card h3 { background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
	</style>{{> navbar-auth activePage="register"}}

	<div class="auth-wrapper">
		<div class="container">
			<div class="row justify-content-center">
				<!-- Registration card — wider than login (col-lg-6) to fit the 2-column form layout.
				     The "Free" badge is just a visual touch -->
				<div class="col-md-8 col-lg-6">
					<div class="auth-card p-4 p-md-5">
						<div class="d-flex align-items-start justify-content-between mb-4">
							<div>
								<p class="text-uppercase text-muted small mb-1">Create your space</p>
								<h3 class="fw-bold mb-1">Join Backlog Hero</h3>
								<p class="text-muted small mb-0">Track, prioritize, and finish your games.</p>
							</div>
								<span class="badge badge-accent rounded-pill px-3 py-2">Free</span>
						</div>

						<!-- Registration form — connects to backend API.
						     2-column grid layout for better UX -->
						<form id="registerForm">
							<div id="errorAlert" class="alert alert-danger d-none" role="alert"></div>
							<div id="successAlert" class="alert alert-success d-none" role="alert"></div>

							<div class="row g-3">
								<div class="col-md-6">
									<label class="form-label">Username</label>
									<input type="text" class="form-control" id="username" placeholder="gaminglead" required>
									<small class="text-muted">3+ characters, letters/numbers only</small>
								</div>
								<div class="col-md-6">
									<label class="form-label">Email</label>
									<input type="email" class="form-control" id="email" placeholder="you@example.com" required>
								</div>
								<div class="col-md-6">
									<label class="form-label">Password</label>
									<input id="password" type="password" class="form-control" placeholder="Create a strong password" required>
									<div class="strength-bar mt-2"><div id="strengthFill" class="strength-fill"></div></div>
									<small class="text-muted">Use 10+ characters with numbers and symbols.</small>
								</div>
								<div class="col-md-6">
									<label class="form-label">Confirm Password</label>
									<input id="confirm" type="password" class="form-control" placeholder="Repeat password" required>
								</div>
								<div class="col-md-12">
									<label class="form-label">Display Name (Optional)</label>
									<input type="text" class="form-control" id="displayName" placeholder="Your Full Name">
								</div>
							</div>

							<!-- Terms checkbox — required before submitting -->
							<div class="form-check mt-4 mb-3">
								<input class="form-check-input" type="checkbox" value="" id="terms" required>
								<label class="form-check-label text-muted" for="terms">I agree to the Backlog Hero terms and privacy.</label>
							</div>

							<div class="d-grid mb-3">
								<button type="submit" class="btn btn-primary py-2" id="registerBtn">Create Account</button>
							</div>
							<p class="text-center text-muted mb-0">Already have an account? <a class="link-accent" href="login.html">Log in</a></p>
						</form>
					</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Password validation and registration API script -->
	<script>
		// Get references to form elements
		const passwordInput = document.getElementById('password');
		const confirmInput = document.getElementById('confirm');
		const strengthFill = document.getElementById('strengthFill');
		const registerForm = document.getElementById('registerForm');

		// Function to calculate password strength based on criteria
		function updateStrength(value) {
			let score = 0;
			if (value.length >= 10) score += 25;
			if (/[A-Z]/.test(value)) score += 25;
			if (/[0-9]/.test(value)) score += 25;
			if (/[^A-Za-z0-9]/.test(value)) score += 25;
			strengthFill.style.width = `${score}%`;
		}

		// Update strength meter in real-time
		if (passwordInput) {
			passwordInput.addEventListener('input', (e) => updateStrength(e.target.value));
		}

		// Password confirmation validation
		if (confirmInput && passwordInput) {
			confirmInput.addEventListener('input', () => {
				const match = confirmInput.value === passwordInput.value;
				confirmInput.classList.toggle('is-valid', match && confirmInput.value.length > 0);
				confirmInput.classList.toggle('is-invalid', !match && confirmInput.value.length > 0);
			});
		}

		// Register form submission to backend
		if (registerForm) {
			registerForm.addEventListener('submit', async (e) => {
				e.preventDefault();

				const username = document.getElementById('username').value;
				const email = document.getElementById('email').value;
				const password = document.getElementById('password').value;
				const confirm = document.getElementById('confirm').value;
				const displayName = document.getElementById('displayName').value || username;
				const registerBtn = document.getElementById('registerBtn');
				const errorAlert = document.getElementById('errorAlert');
				const successAlert = document.getElementById('successAlert');

				// Reset alerts
				errorAlert.classList.add('d-none');
				successAlert.classList.add('d-none');

				// Validate password match
				if (password !== confirm) {
					errorAlert.textContent = '✗ Passwords do not match';
					errorAlert.classList.remove('d-none');
					return;
				}

				// Disable button during submission
				registerBtn.disabled = true;
				registerBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Creating account...';

				try {
					console.log('[Register] Submitting registration...');
					const response = await fetch('/api/users/register', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						credentials: 'include',
						body: JSON.stringify({ username, email, password, displayName })
					});

					console.log('[Register] Response status:', response.status);
					
					const data = await response.json();

					if (!response.ok) {
						throw new Error(data.error || 'Registration failed');
					}

					console.log('[Register] Account created successfully:', data.displayName);

					// Show success message
					successAlert.innerHTML = '✓ Account created! Redirecting to dashboard...';
					successAlert.classList.remove('d-none');

					// Redirect to dashboard
					setTimeout(() => {
						window.location.href = 'dashboard.html';
					}, 1500);

				} catch (err) {
					errorAlert.textContent = '✗ ' + err.message;
					errorAlert.classList.remove('d-none');
					registerBtn.disabled = false;
					registerBtn.innerHTML = 'Create Account';
				}
			});
		}
	</script>
	<script>
		// Page transition animation
		document.querySelectorAll('a[href]').forEach(a => {
			if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
				a.addEventListener('click', e => {
					e.preventDefault();
					const dest = a.href;
					document.body.classList.add('page-exit');
					setTimeout(() => window.location = dest, 300);
				});
			}
		});

		// Navbar scroll shadow (passive, cached)
		const _nav = document.querySelector('.navbar');
		let _scrollTick = false;
		window.addEventListener('scroll', () => {
			if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
		}, { passive: true });
	</script>