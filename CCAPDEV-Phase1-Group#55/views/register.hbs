<!-- Password validation and registration API script -->
<script>
	// Get references to form elements
	const passwordInput = document.getElementById('password');
	const confirmInput = document.getElementById('confirm');
	const strengthFill = document.getElementById('strengthFill');
	const registerForm = document.getElementById('registerForm');

	// Function to calculate password strength based on criteria
	function updateStrength(value) {
		let score = 0;
		if (value.length >= 10) score += 25;
		if (/[A-Z]/.test(value)) score += 25;
		if (/[0-9]/.test(value)) score += 25;
		if (/[^A-Za-z0-9]/.test(value)) score += 25;
		strengthFill.style.width = `${score}%`;
	}

	// Update strength meter in real-time
	if (passwordInput) {
		passwordInput.addEventListener('input', (e) => updateStrength(e.target.value));
	}

	// Password confirmation validation
	if (confirmInput && passwordInput) {
		confirmInput.addEventListener('input', () => {
			const match = confirmInput.value === passwordInput.value;
			confirmInput.classList.toggle('is-valid', match && confirmInput.value.length > 0);
			confirmInput.classList.toggle('is-invalid', !match && confirmInput.value.length > 0);
		});
	}

	// Register form submission to backend
	if (registerForm) {
		registerForm.addEventListener('submit', async (e) => {
			e.preventDefault();

			const username = document.getElementById('username').value;
			const email = document.getElementById('email').value;
			const password = document.getElementById('password').value;
			const confirm = document.getElementById('confirm').value;
			const displayName = document.getElementById('displayName').value || username;
			const registerBtn = document.getElementById('registerBtn');
			const errorAlert = document.getElementById('errorAlert');
			const successAlert = document.getElementById('successAlert');

			// Reset alerts
			errorAlert.classList.add('d-none');
			successAlert.classList.add('d-none');

			// Validate password match
			if (password !== confirm) {
				errorAlert.textContent = '✗ Passwords do not match';
				errorAlert.classList.remove('d-none');
				return;
			}

			// Disable button during submission
			registerBtn.disabled = true;
			registerBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Creating account...';

			try {
				console.log('[Register] Submitting registration...');
				const response = await fetch('/api/users/register', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					credentials: 'include',
					body: JSON.stringify({ username, email, password, displayName })
				});

				console.log('[Register] Response status:', response.status);

				const data = await response.json();

				if (!response.ok) {
					throw new Error(data.error || 'Registration failed');
				}

				console.log('[Register] Account created successfully:', data.displayName);

				// Show success message
				successAlert.innerHTML = '✓ Account created! Redirecting to dashboard...';
				successAlert.classList.remove('d-none');

				// Redirect to dashboard
				setTimeout(() => {
					window.location.href = '/dashboard';
				}, 1500);

			} catch (err) {
				errorAlert.textContent = '✗ ' + err.message;
				errorAlert.classList.remove('d-none');
				
				// If email already exists, suggest login
				if (err.message.includes('Email already exists')) {
					setTimeout(() => {
						errorAlert.innerHTML = '✗ ' + err.message + ' <a href="/login" class="link-accent ms-2" style="text-decoration: underline;">Log in instead</a>';
					}, 500);
				}
				
				registerBtn.disabled = false;
				registerBtn.innerHTML = 'Create Account';
			}
		});
	}

	// SSO provider button handler
	if (document.getElementById('googleRegisterBtn')) {
		document.getElementById('googleRegisterBtn').addEventListener('click', () => {
			window.location.href = '/auth/google/register';
		});
	}
</script>
<script>
	// Page transition animation
	document.querySelectorAll('a[href]').forEach(a => {
		if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
			a.addEventListener('click', e => {
				e.preventDefault();
				const dest = a.href;
				document.body.classList.add('page-exit');
				setTimeout(() => window.location = dest, 300);
			});
		}
	});

	// Navbar scroll shadow (passive, cached)
	const _nav = document.querySelector('.navbar');
	let _scrollTick = false;
	window.addEventListener('scroll', () => {
		if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
	}, { passive: true });
</script>