<style>
        /* Page-specific: library overrides */
        .card-title { color: #dbe7ff; }
        .cover-placeholder i { font-size: 3rem; color: var(--primary); }
        .status-badge { position: absolute; top: 10px; right: 10px; z-index: 2; }
        .remove-btn { position: absolute; top: 10px; left: 10px; z-index: 2; opacity: 0.55; transition: opacity 0.2s var(--ease), background 0.2s var(--ease), transform 0.2s; background: rgba(220,53,69,0.18); border: none; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; color: #dc3545; font-size: 1.1rem; line-height: 1; cursor: pointer; }
        .remove-btn:hover { opacity: 1; background: rgba(220,53,69,0.75); color: #fff; transform: scale(1.1); }
        /* Tabs */
        .nav-pills .nav-link { color: var(--text-muted); transition: color 0.25s var(--ease), background 0.25s var(--ease), box-shadow 0.25s var(--ease); border-radius: var(--radius-full); padding: 6px 16px; }
        .nav-pills .nav-link:hover { color: var(--text); background: rgba(83,131,232,0.08); }
        .nav-pills .nav-link.active { background: var(--gradient-primary); color: white; box-shadow: 0 4px 16px rgba(83,131,232,0.25); }
        .tab-count { background: rgba(255,255,255,0.15); border-radius: 10px; padding: 0 7px; font-size: 0.7rem; margin-left: 6px; }
        .nav-pills .nav-link.active .tab-count { background: rgba(255,255,255,0.25); }
        /* Star rating */
        .star-rating { display: inline-flex; gap: 2px; }
        .star-rating i { cursor: pointer; font-size: 1rem; color: var(--border); transition: color 0.15s, transform 0.15s; }
        .star-rating i.active { color: var(--warning); }
        .star-rating i:hover, .star-rating i:hover ~ i { color: var(--warning); }
        .star-rating i:hover { transform: scale(1.2); }
        /* Card animation */
        @keyframes cardFadeIn { from { opacity: 0; transform: translateY(24px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .game-card-anim { animation: cardFadeIn 0.5s var(--ease-out) both; }
        /* Cover hover zoom */
        .card .game-cover, .card .cover-placeholder { transition: transform 0.4s var(--ease); }
        .card:hover .game-cover, .card:hover .cover-placeholder { transform: scale(1.06); }
        .card .card-img-top-wrap { overflow: hidden; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
        /* Empty state */
        .empty-state { text-align: center; padding: 80px 20px; }
        .empty-state i { font-size: 4rem; background: var(--gradient-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 1rem; }
        .empty-state h5 { color: #a8c0e0; }
        .empty-state p { color: var(--text-faint); }
        /* Toast */
        .toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 1080; }
        /* Add game button */
        .add-game-btn { border: 2px dashed var(--border); background: transparent; color: var(--primary); border-radius: var(--radius-lg); transition: border-color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease), box-shadow 0.3s var(--ease); cursor: pointer; min-height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
        .add-game-btn:hover { border-color: rgba(83,131,232,0.5); background: rgba(83,131,232,0.06); transform: translateY(-3px); box-shadow: 0 0 30px rgba(83,131,232,0.08); }
        .add-game-btn i { font-size: 2.5rem; }
        /* Library header */
        .library-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
        .library-header h2 { font-weight: 900; letter-spacing: -0.02em; margin: 0; }
        /* Card hover glow line */
        .card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--gradient-primary); opacity: 0; transition: opacity 0.3s ease; }
        .card:hover::after { opacity: 1; }
    </style>

{{> navbar-app activePage="library"}}

    <div class="container my-5">
        <!-- Header: title + filter tabs + search -->
        <div class="library-header">
            <h2><i class="bi bi-collection me-2" style="color:var(--primary);"></i>My <span class="gradient-text">Collection</span></h2>
            <div style="flex: 1; max-width: 250px;">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--text-faint);font-size:0.8rem;"></i>
                    <input type="text" class="form-control form-control-sm" id="librarySearch" placeholder="Search your library..." style="padding-left:32px;">
                </div>
            </div>
            <ul class="nav nav-pills" id="libraryTabs">
                <li class="nav-item"><a class="nav-link active" href="#" data-filter="all">All Games <span class="tab-count" id="count-all">0</span></a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-filter="backlog">Backlog <span class="tab-count" id="count-backlog">0</span></a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-filter="playing">Playing <span class="tab-count" id="count-playing">0</span></a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-filter="completed">Completed <span class="tab-count" id="count-completed">0</span></a></li>
            </ul>
        </div>

        <!-- Suggested games section (shown above library when searching) -->
        <div id="suggestedSection" style="display: none; margin-bottom: 2rem;">
            <h5 class="text-muted mb-3">Suggested for you</h5>
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4" id="suggestedGrid"></div>
        </div>

        <!-- Game grid — dynamically rendered -->
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-4" id="libraryGrid"></div>
    </div>

    <!-- Add Game Modal -->
    <div class="modal fade" id="addGameModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Game to Library</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Game Title *</label>
                        <input type="text" class="form-control" id="addGameName" placeholder="e.g. Elden Ring" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Status *</label>
                        <select class="form-select" id="addGameStatus">
                            <option value="backlog">Backlog</option>
                            <option value="playing">Playing</option>
                            <option value="completed">Completed</option>
                        </select>
                    </div>
                    <div class="mb-0" id="addRatingWrap" style="display:none;">
                        <label class="form-label small text-muted">Rating</label>
                        <div class="star-rating" id="addGameRating">
                            <i class="bi bi-star-fill" data-val="1"></i>
                            <i class="bi bi-star-fill" data-val="2"></i>
                            <i class="bi bi-star-fill" data-val="3"></i>
                            <i class="bi bi-star-fill" data-val="4"></i>
                            <i class="bi bi-star-fill" data-val="5"></i>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="addGameSave"><i class="bi bi-plus-lg me-1"></i>Add to Library</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirm Remove Modal -->
    <div class="modal fade" id="removeGameModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content text-center" style="border-color:#dc3545; margin: auto;">
                <div class="modal-body pt-4 pb-2">
                    <div style="width:56px;height:56px;border-radius:50%;background:rgba(220,53,69,0.12);display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px;">
                        <i class="bi bi-trash3" style="font-size:1.5rem;color:#dc3545;"></i>
                    </div>
                    <h6 class="mb-1">Remove Game</h6>
                    <p class="text-muted small mb-0" id="removeGameText">Are you sure?</p>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0 pb-4" style="gap:10px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger px-4" id="confirmRemoveBtn"><i class="bi bi-trash3 me-1"></i>Remove</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast for notifications -->
    <div class="toast-container">
        <div class="toast align-items-center border-0" id="libToast" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="libToastMsg"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
    <script>
    /* ======================================================================
       AUTH & PAGE INITIALIZATION
    ====================================================================== */
    
    // Check if user is logged in with retry logic
    async function initializePage() {
      try {
        let retries = 5;
        while (retries > 0) {
          try {
            // Use AbortController for proper timeout
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 5000); // 5 second timeout
            
            const res = await fetch('/api/auth/current', {
              method: 'GET',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              signal: controller.signal
            });
            
            clearTimeout(timeoutId);

            console.log('[Library] Auth response:', res.status);

            if (res.ok) {
              const userData = await res.json();
              currentUserId = userData._id || userData.id;
              console.log('[Library] User authenticated, id:', currentUserId);
              return true;
            } else if (res.status === 401 || res.status === 403) {
              // Explicit auth failure - don't retry
              console.error('[Library] Unauthorized (' + res.status + ') - redirecting to login');
              setTimeout(() => {
                window.location.href = 'login';
              }, 500);
              return false;
            }
            // Other status codes (5xx, etc) - try again
          } catch (err) {
            console.warn('[Library] Auth attempt ' + (6 - retries) + ' failed:', err.message);
            // Network errors are temporary - retry
          }
          retries--;
          if (retries > 0) {
            await new Promise(r => setTimeout(r, 500)); // Longer wait before retry
          }
        }
        
        console.error('[Library] Auth check failed after all retries - redirecting');
        setTimeout(() => {
          window.location.href = 'login';
        }, 500);
        return false;
      } catch (err) {
        console.error('[Library] Failed to initialize:', err);
        setTimeout(() => {
          window.location.href = 'login';
        }, 500);
        return false;
      }
    }

    // Initialize on page load
    let pageInitComplete = false;
    let currentUserId = null;
    window.addEventListener('load', async () => {
      if (!pageInitComplete) {
        pageInitComplete = true;
        const authOk = await initializePage();
        if (authOk) {
          await fetchLibrary();
          render();
          checkAchievements();
        }
      }
    });

    /* ======================================================================
       Library — localStorage-backed game collection with full CRUD
       Key: bh_library_v1
    ====================================================================== */
    const ACHIEVEMENTS_STORAGE_KEY = 'bh_achievements_v1';
    let libraryCache = [];
    const grid = document.getElementById('libraryGrid');
    const searchInput = document.getElementById('librarySearch');
    const suggestedSection = document.getElementById('suggestedSection');
    const suggestedGrid = document.getElementById('suggestedGrid');
    let currentFilter = 'all';
    let currentSearch = '';
    let addRating = 0;
    let suggestSuggestions = [];

    /* Achievement checking */
    function loadAchievements() {
        const stored = localStorage.getItem(ACHIEVEMENTS_STORAGE_KEY);
        return stored ? JSON.parse(stored) : [];
    }

    function saveAchievements(achievements) {
        localStorage.setItem(ACHIEVEMENTS_STORAGE_KEY, JSON.stringify(achievements));
    }

    function checkAchievements() {
        const games = loadLibrary();
        const unlockedAchievements = loadAchievements();
        
        const conditions = [
            { id: 'first_game', condition: games.length >= 1 },
            { id: 'collector', condition: games.length >= 10 },
            { id: 'hoarder', condition: games.length >= 25 },
            { id: 'completionist_badge', condition: games.filter(g => g.status === 'completed').length >= 5 },
            { id: 'platinum', condition: games.filter(g => g.status === 'completed').length >= 10 },
            { id: 'grandmaster', condition: games.filter(g => g.status === 'completed').length >= 50 },
            { id: 'backlog_master', condition: games.filter(g => g.status === 'backlog').length >= 20 },
            { id: 'indecisive', condition: games.filter(g => g.status === 'backlog').length >= 50 },
            { id: 'multitasker', condition: games.filter(g => g.status === 'playing').length >= 5 },
            { id: 'reviewer', condition: games.filter(g => g.status === 'completed' && g.rating > 0).length >= 5 },
            { id: 'ultimate_critic', condition: games.filter(g => g.status === 'completed' && g.rating > 0).length >= 50 },
            { id: 'hybrid', condition: games.filter(g => g.status === 'backlog').length > 0 && games.filter(g => g.status === 'playing').length > 0 && games.filter(g => g.status === 'completed').length > 0 },
            { id: 'legendary', condition: games.filter(g => g.status === 'completed' && g.rating === 5).length >= 20 },
            { id: 'no_life', condition: games.reduce((acc, g) => acc + (g.playtime || 0), 0) >= 1000 },
            { id: 'retro_appreciator', condition: games.filter(g => g.year && g.year < 2010).length >= 10 }
        ];

        conditions.forEach(ach => {
            if (!unlockedAchievements.some(a => a.id === ach.id) && ach.condition) {
                unlockedAchievements.push({ id: ach.id, unlockedAt: new Date().toISOString() });
            }
        });

        saveAchievements(unlockedAchievements);
    }

    /* ---------- server-backed library helpers ---------- */
    function mapEntry(entry) {
        const g = entry.gameId || {};
        return {
            id: String(entry._id),
            gameDbId: g._id ? String(g._id) : null,
            name: g.name || 'Unknown',
            genre: (g.genres || []).join(' \u2022 ') || 'Game',
            year: g.releaseDate ? new Date(g.releaseDate).getFullYear() : 0,
            status: entry.status || 'backlog',
            cover: g.coverUrl || '',
            rating: entry.rating || 0,
            playtime: entry.playtime || 0,
            addedAt: entry.addedAt ? new Date(entry.addedAt).getTime() : Date.now()
        };
    }

    async function fetchLibrary() {
        if (!currentUserId) return [];
        try {
            const res = await fetch('/api/library/' + currentUserId, { credentials: 'include' });
            if (!res.ok) return libraryCache;
            const entries = await res.json();
            libraryCache = entries.filter(e => e.gameId).map(mapEntry);
            // Deduplicate by game name (safety net)
            const seen = new Set();
            libraryCache = libraryCache.filter(g => {
                const key = g.name.toLowerCase();
                if (seen.has(key)) return false;
                seen.add(key);
                return true;
            });
        } catch (err) {
            console.error('[Library] Fetch failed:', err);
        }
        return libraryCache;
    }

    function loadLibrary() {
        return libraryCache;
    }

    /* ---------- toast ---------- */
    function showToast(msg, bg = 'bg-success') {
        const el = document.getElementById('libToast');
        el.className = 'toast align-items-center border-0 text-white ' + bg;
        document.getElementById('libToastMsg').textContent = msg;
        bootstrap.Toast.getOrCreateInstance(el, { delay: 2500 }).show();
    }

    /* ---------- status helpers ---------- */
    const statusLabel = { backlog: 'Backlog', playing: 'Playing', completed: 'Completed' };
    const statusBg    = { backlog: 'bg-secondary', playing: 'bg-warning text-dark', completed: 'bg-success' };

    function renderStars(rating) {
        let s = '';
        for (let i = 1; i <= 5; i++) s += `<i class="bi bi-star-fill ${i <= rating ? 'active' : ''}" style="color:${i <= rating ? '#febc2e' : '#2a3843'}; font-size:0.8rem;"></i>`;
        return s;
    }

    /* ---------- render grid ---------- */
    function render() {
        const games = loadLibrary();
        
        // Filter by status
        let filtered = currentFilter === 'all' ? games : games.filter(g => g.status === currentFilter);
        
        // Filter by search query
        if (currentSearch.trim()) {
            filtered = filtered.filter(g => 
                g.name.toLowerCase().includes(currentSearch.toLowerCase()) || 
                g.genre.toLowerCase().includes(currentSearch.toLowerCase())
            );
        }

        // update tab counts
        document.getElementById('count-all').textContent = games.length;
        document.getElementById('count-backlog').textContent = games.filter(g => g.status === 'backlog').length;
        document.getElementById('count-playing').textContent = games.filter(g => g.status === 'playing').length;
        document.getElementById('count-completed').textContent = games.filter(g => g.status === 'completed').length;

        // Show suggested games section if searching
        if (currentSearch.trim() && suggestSuggestions.length > 0) {
            suggestedSection.style.display = 'block';
            suggestedGrid.innerHTML = suggestSuggestions.slice(0, 5).map(game => {
                const coverUrl = game.cover
                    ? 'https:' + game.cover.url.replace('t_thumb', 't_cover_big')
                    : 'https://via.placeholder.com/264x352/1c252e/9e9e9e?text=No+Cover';

                const year = game.first_release_date
                    ? new Date(game.first_release_date * 1000).getFullYear()
                    : 'TBA';

                const genres = game.genres
                    ? game.genres.map(g => g.name).slice(0, 1).join(' • ')
                    : 'Game';

                const alreadyAdded = libraryCache.some(g => g.name.toLowerCase() === game.name.toLowerCase());
                const gameId = `add-igdb-${game.id || game.name.replace(/\s+/g, '-')}`;

                return `
                  <div class="col">
                    <div class="card h-100 shadow-sm" style="border-color: #5383e8; border-width: 2px;">
                      <img src="${coverUrl}" class="card-img-top game-cover" alt="${game.name}" loading="lazy"
                           onerror="this.src='https://via.placeholder.com/264x352/1c252e/9e9e9e?text=No+Cover'">
                      <div class="card-body">
                        <h6 class="card-title">${game.name}</h6>
                        <p class="card-text small text-muted">${genres} • ${year}</p>
                        <button class="btn btn-sm ${alreadyAdded ? 'btn-success disabled' : 'btn-outline-primary'} w-100 add-igdb-btn"
                                id="${gameId}"
                                data-name="${game.name}"
                                data-genre="${genres}"
                                data-year="${year}"
                                data-cover="${coverUrl}"
                                data-game-id="${game.id}"
                                ${alreadyAdded ? 'disabled' : ''}>
                                ${alreadyAdded ? '✓ In Library' : '+ Add to Library'}
                        </button>
                      </div>
                    </div>
                  </div>
                `;
            }).join('');
        } else {
            suggestedSection.style.display = 'none';
        }

        // empty state
        if (filtered.length === 0) {
            const filterName = currentFilter === 'all' ? 'library' : statusLabel[currentFilter].toLowerCase() + ' list';
            grid.innerHTML = `
                <div class="col-12 empty-state">
                    <i class="bi bi-controller d-block"></i>
                    <h5>No games in your ${filterName}</h5>
                    <p>Click the <strong>+ Add Game</strong> card or add games from the <a href="search" class="text-decoration-none" style="color:#5383e8">Search</a> page.</p>
                </div>`;
            // still add the "add game" card
            grid.innerHTML += addGameCard();
            return;
        }

        let html = '';
        filtered.forEach((game, i) => {
            const displayName = game.name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            const coverHtml = game.cover
                ? `<div class="card-img-top-wrap position-relative" style="aspect-ratio:3/4; overflow:hidden;">
                     <img src="${game.cover}" class="card-img-top game-cover" alt="${displayName}" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';">
                     <div class="cover-placeholder" style="display:none; height:100%; width:100%; align-items:center; justify-content:center; background:#1c252e;">
                        <i class="bi bi-controller" style="font-size: 3rem; color: var(--primary);"></i>
                     </div>
                   </div>`
                : `<div class="cover-placeholder" style="aspect-ratio:3/4; display:flex; align-items:center; justify-content:center; background:#1c252e;"><i class="bi bi-controller" style="font-size: 3rem; color: var(--primary);"></i></div>`;

            html += `
            <div class="col game-card-anim" style="animation-delay:${i * 0.06}s" data-id="${game.id}">
                <div class="card h-100 position-relative">
                    <button class="remove-btn lib-remove-btn" data-entry-id="${game.id}" onclick="removeGame('${game.id}')" title="Remove from library">&times;</button>
                    <span class="badge ${statusBg[game.status]} status-badge">${statusLabel[game.status]}</span>
                    ${coverHtml}
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title mb-1 lib-game-link" data-game-name="${displayName}" style="cursor: pointer; color: #5383e8; transition: color 0.2s;">${displayName}</h6>
                        <p class="text-muted small mb-2">${game.genre || 'Game'}${game.year ? ' • ' + game.year : ''}</p>
                        ${game.status === 'completed' && game.rating ? `<div class="mb-2">${renderStars(game.rating)}</div>` : ''}
                        <div class="mt-auto">
                            <select class="form-select form-select-sm status-select lib-status-select" data-entry-id="${game.id}">
                                <option value="backlog" ${game.status === 'backlog' ? 'selected' : ''}>Backlog</option>
                                <option value="playing" ${game.status === 'playing' ? 'selected' : ''}>Playing</option>
                                <option value="completed" ${game.status === 'completed' ? 'selected' : ''}>Completed</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>`;
        });

        // "Add Game" card at the end
        html += addGameCard();
        grid.innerHTML = html;
    }

    function addGameCard() {
        return `
        <div class="col game-card-anim" style="animation-delay:0s">
            <div class="add-game-btn h-100" onclick="window.location.href='search'">
                <i class="bi bi-plus-circle"></i>
                <span class="fw-semibold">Add Game</span>
            </div>
        </div>`;
    }

    function openAddModal() {
        document.getElementById('addGameName').value = '';
        document.getElementById('addGameStatus').value = 'backlog';
        addRating = 0;
        updateAddStars();
        addRatingWrap.style.display = 'none';
        new bootstrap.Modal(document.getElementById('addGameModal')).show();
    }

    /* ---------- change status ---------- */
    async function changeStatus(id, newStatus) {
        const game = libraryCache.find(g => g.id === id);
        if (!game) return;
        const body = { status: newStatus };
        if (newStatus === 'completed' && !game.rating) body.rating = 4;
        if (newStatus !== 'completed') body.rating = 0;
        try {
            const res = await fetch('/api/library/' + id, {
                method: 'PUT', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            if (!res.ok) throw new Error('Update failed');
            await fetchLibrary();
            checkAchievements();
            showToast(`${game.name} moved to ${statusLabel[newStatus]}`, 'bg-primary');
            render();
        } catch (err) {
            console.error('[Library] Status update error:', err);
            showToast('Failed to update status', 'bg-danger');
        }
    }

    /* ---------- event delegation for card actions ---------- */
    document.getElementById('libraryGrid').addEventListener('click', e => {
        const removeBtn = e.target.closest('.lib-remove-btn');
        if (removeBtn) {
            e.stopPropagation();
            removeGame(removeBtn.dataset.entryId);
            return;
        }
        const gameLink = e.target.closest('.lib-game-link');
        if (gameLink) {
            goToSearch(gameLink.dataset.gameName);
            return;
        }
    });
    document.getElementById('libraryGrid').addEventListener('change', e => {
        const sel = e.target.closest('.lib-status-select');
        if (sel) changeStatus(sel.dataset.entryId, sel.value);
    });

    /* ---------- remove game ---------- */
    let pendingRemoveId = null;
    const removeModal = () => bootstrap.Modal.getOrCreateInstance(document.getElementById('removeGameModal'));

    function removeGame(id) {
        const game = libraryCache.find(g => String(g.id) === String(id));
        if (!game) { console.error('[Library] removeGame: no game found for id', id); return; }
        pendingRemoveId = id;
        document.getElementById('removeGameText').innerHTML = `<strong>${game.name}</strong> will be removed from your library.`;
        removeModal().show();
    }

    document.getElementById('confirmRemoveBtn').addEventListener('click', async () => {
        if (!pendingRemoveId) return;
        const game = libraryCache.find(g => g.id === pendingRemoveId);
        const name = game ? game.name : 'Game';
        try {
            const res = await fetch('/api/library/' + pendingRemoveId, {
                method: 'DELETE', credentials: 'include'
            });
            if (!res.ok) throw new Error('Delete failed');
            await fetchLibrary();
            checkAchievements();
            pendingRemoveId = null;
            removeModal().hide();
            showToast(`${name} removed`, 'bg-danger');
            render();
        } catch (err) {
            console.error('[Library] Remove error:', err);
            showToast('Failed to remove game', 'bg-danger');
        }
    });

    /* ---------- tab filtering ---------- */
    document.querySelectorAll('#libraryTabs .nav-link').forEach(tab => {
        tab.addEventListener('click', e => {
            e.preventDefault();
            document.querySelectorAll('#libraryTabs .nav-link').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            currentFilter = tab.dataset.filter;
            render();
        });
    });

    /* ---------- library search ---------- */
    let searchTimeout;
    searchInput.addEventListener('input', async (e) => {
        currentSearch = e.target.value;
        
        // Get IGDB suggestions if search has text
        if (currentSearch.trim().length > 2) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(async () => {
                try {
                    const res = await fetch('/api/games/search', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ query: currentSearch.trim(), limit: 10 })
                    });
                    if (res.ok) {
                        suggestSuggestions = await res.json();
                    }
                } catch (err) {
                    console.error('IGDB suggestion fetch failed:', err);
                }
            }, 400);
        } else {
            suggestSuggestions = [];
        }
        
        render();
    });

    // Clear search on focus (optional)
    document.getElementById('librarySearch').addEventListener('focus', function() {
        if (!this.value) render();
    });

    /* ---------- redirect to search with game name ---------- */
    function goToSearch(gameName) {
        localStorage.setItem('bh_search_query', gameName);
        window.location.href = 'search';
    }

    /* ---------- add game modal ---------- */
    const addStatusSel = document.getElementById('addGameStatus');
    const addRatingWrap = document.getElementById('addRatingWrap');
    addStatusSel.addEventListener('change', () => {
        addRatingWrap.style.display = addStatusSel.value === 'completed' ? 'block' : 'none';
    });

    // Star rating in modal
    function updateAddStars() {
        document.querySelectorAll('#addGameRating i').forEach(star => {
            star.classList.toggle('active', parseInt(star.dataset.val) <= addRating);
        });
    }
    document.querySelectorAll('#addGameRating i').forEach(star => {
        star.addEventListener('click', () => { addRating = parseInt(star.dataset.val); updateAddStars(); });
    });

    document.getElementById('addGameSave').addEventListener('click', async () => {
        const name = document.getElementById('addGameName').value.trim();
        if (!name) { document.getElementById('addGameName').classList.add('is-invalid'); return; }
        document.getElementById('addGameName').classList.remove('is-invalid');

        if (libraryCache.some(g => g.name.toLowerCase() === name.toLowerCase())) {
            showToast(`"${name}" is already in your library!`, 'bg-warning');
            return;
        }

        const status = document.getElementById('addGameStatus').value;
        const rating = addStatusSel.value === 'completed' ? (addRating || 0) : 0;

        try {
            // Create Game document
            const gameRes = await fetch('/api/games', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            if (!gameRes.ok) throw new Error('Failed to create game');
            const { game } = await gameRes.json();

            // Add to library
            const libRes = await fetch('/api/library', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: currentUserId, gameId: game._id, status })
            });
            if (!libRes.ok) throw new Error('Failed to add to library');

            if (rating) {
                const entry = await libRes.json();
                await fetch('/api/library/' + entry.entry._id, {
                    method: 'PUT', credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating })
                });
            }

            await fetchLibrary();
            checkAchievements();
            bootstrap.Modal.getInstance(document.getElementById('addGameModal')).hide();
            showToast(`${name} added to ${statusLabel[status]}!`, 'bg-success');
            render();
        } catch (err) {
            console.error('[Library] Add game error:', err);
            showToast('Failed to add game', 'bg-danger');
        }
    });

    // Allow Enter to submit modal
    document.getElementById('addGameName').addEventListener('keydown', e => {
        if (e.key === 'Enter') document.getElementById('addGameSave').click();
    });

    /* ---------- add suggested games from IGDB ---------- */
    document.addEventListener('click', async e => {
        const btn = e.target.closest('.add-igdb-btn');
        if (!btn) return;
        
        const name = btn.dataset.name;
        
        if (libraryCache.some(g => g.name.toLowerCase() === name.toLowerCase())) {
            showToast(`"${name}" is already in your library!`, 'bg-warning');
            return;
        }

        try {
            const genres = btn.dataset.genre ? btn.dataset.genre.split(' \u2022 ').map(g => g.trim()) : [];
            const year = parseInt(btn.dataset.year) || 0;
            const coverUrl = btn.dataset.cover || '';
            const releaseDate = year ? new Date(year, 0, 1).toISOString() : null;

            // Create Game document
            const gameRes = await fetch('/api/games', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, coverUrl, genres, releaseDate })
            });
            if (!gameRes.ok) throw new Error('Failed to create game');
            const { game } = await gameRes.json();

            // Add to library
            const libRes = await fetch('/api/library', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId: currentUserId, gameId: game._id, status: 'backlog' })
            });
            if (!libRes.ok) throw new Error('Failed to add to library');

            await fetchLibrary();
            checkAchievements();
        
        // Update button state immediately in DOM and re-render
        btn.textContent = '✓ In Library';
        btn.classList.add('btn-success', 'disabled');
        btn.classList.remove('btn-outline-primary');
        btn.disabled = true;
        
        // Also update any other instances of this game button in suggested section
        document.querySelectorAll(`.add-igdb-btn[data-name="${name}"]`).forEach(otherBtn => {
            otherBtn.textContent = '✓ In Library';
            otherBtn.classList.add('btn-success', 'disabled');
            otherBtn.classList.remove('btn-outline-primary');
            otherBtn.disabled = true;
        });
        
        showToast(`${name} added to Backlog!`, 'bg-success');
        render();
        } catch (err) {
            console.error('[Library] IGDB add error:', err);
            showToast('Failed to add game', 'bg-danger');
        }
    });

    // Logout function
    async function logout(event) {
        event.preventDefault();
        try {
            await fetch('/api/auth/logout', {
                method: 'POST',
                credentials: 'include'
            });
            window.location.href = 'login';
        } catch (err) {
            console.error('Logout failed:', err);
            window.location.href = 'login';
        }
    }

    // Smart home navigation - if logged in go to dashboard, else go to index
    async function smartHomeClick(e) {
        e.preventDefault();
        try {
            const res = await fetch('/api/auth/current', { credentials: 'include' });
            const dest = res.ok ? 'dashboard' : 'index';
            document.body.classList.add('page-exit');
            setTimeout(() => window.location = dest, 300);
        } catch (err) {
            console.error('Auth check failed:', err);
            window.location = 'index';
        }
    }

    /* ---------- page-exit transitions ---------- */
    document.addEventListener('click', e => {
        const a = e.target.closest('a[href]');
        if (!a) return;
        if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
            e.preventDefault();
            const dest = a.href;
            document.body.classList.add('page-exit');
            setTimeout(() => window.location = dest, 300);
        }
    });
    </script>
