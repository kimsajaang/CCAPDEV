  <script>
    // ============================================================
    // Every is stored in MongoDB via backend API
    // ============================================================
    window.addEventListener('load', () => {

    // localStorage key — versioned so we can change the schema without breaking old data
    const STORAGE_KEY = "bh_community_posts_v1";

    // Track login status globally
    let isUserLoggedIn = false;
    let currentUsername = 'Gamer';
    let currentUserId = null;

    // Check authentication status and show/hide content accordingly
    async function checkAuthAndShowContent() {
      try {
        const response = await fetch('/api/auth/current', {
          method: 'GET',
          credentials: 'include'
        });

        isUserLoggedIn = response.ok;
        if (isUserLoggedIn) {
          const userData = await response.json();
          currentUserId = userData._id;
          currentUsername = userData.displayName || userData.username || 'Gamer';
        }
        const protectedSections = document.querySelectorAll('[data-auth-required="true"]');
        const previewSections = document.querySelectorAll('[data-preview-only="true"]');

        if (isUserLoggedIn) {
          protectedSections.forEach(el => el.style.display = '');
          previewSections.forEach(el => el.style.display = 'none');
        } else {
          protectedSections.forEach(el => el.style.display = 'none');
          previewSections.forEach(el => el.style.display = '');
        }
      } catch (err) {
        console.error('Auth check failed:', err);
        isUserLoggedIn = false;
        document.querySelectorAll('[data-auth-required="true"]').forEach(el => el.style.display = 'none');
        document.querySelectorAll('[data-preview-only="true"]').forEach(el => el.style.display = '');
      }
    }

    // Check auth for community page
    async function checkCommunityAuth() {
      try {
        const res = await fetch('/api/auth/current', { credentials: 'include' });
        const isLoggedIn = res.ok;
        if (!isLoggedIn) {
          // Limit posts to 3 and show login prompt
          window.limitCommunityPreview = true;
          document.getElementById('communityLoginPrompt').style.display = '';
        }
      } catch (err) {
        window.limitCommunityPreview = true;
        document.getElementById('communityLoginPrompt').style.display = '';
      }
    }

    // Check auth on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAuthAndShowContent);
      checkCommunityAuth();
    } else {
      checkAuthAndShowContent();
      checkCommunityAuth();
    }

    // Handle New Post button clicks - redirect to login if not logged in
    document.querySelectorAll('#newPostTopBtn, #newPostEmptyBtn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (!isUserLoggedIn) {
          e.preventDefault();
          e.stopPropagation();
          // Close modal if it was about to open
          const modal = bootstrap.Modal.getInstance(document.getElementById('newPostModal'));
          if (modal) modal.hide();
          // Redirect to login
          window.location.href = '/login';
        }
      });
    });

    const nowIso = () => new Date().toISOString();
    const fmtTime = (iso) => {
      const d = new Date(iso);
      return d.toLocaleString(undefined, { year: "numeric", month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });
    };
    const escapeHtml = (s) => (s || "").replace(/[&<>"']/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;" }[c]));

    // --- Data layer: backend API calls ---
    async function loadPosts() {
      try {
        const res = await fetch('/api/posts');
        if (!res.ok) throw new Error('Fetch failed');
        return await res.json();
      } catch (e) {
        console.error('Failed to load posts:', e);
        return [];
      }
    }

    async function savePosts(postData) {
      // No longer used for saving everything at once, handled by create/vote/comment endpoints
    }

    // Migration helper — makes sure every post has an id, comments array, and vote counts.
    // Needed because early test data didn't have all fields and it was crashing
    function ensureIds(posts) {
      let changed = false;
      for (const p of posts) {
        if (!p.id) { p.id = crypto.randomUUID(); changed = true; }
        if (!Array.isArray(p.comments)) { p.comments = []; changed = true; }
        if (typeof p.up !== "number") { p.up = 0; changed = true; }
        if (typeof p.down !== "number") { p.down = 0; changed = true; }
      }
      if (changed) savePosts(posts);
      return posts;
    }

    function score(post) {
      const up = Array.isArray(post.upvotes) ? post.upvotes.length : (post.up || 0);
      const down = Array.isArray(post.downvotes) ? post.downvotes.length : (post.down || 0);
      return up - down;
    }

    // Hot score algorithm — loosely based on Reddit's formula.
    // Divides net votes by age^0.7 so newer posts with fewer votes can still rank high
    function hotScore(post) {
      const v = score(post);
      const created = post.createdAt ? new Date(post.createdAt).getTime() : Date.now();
      const ageHours = Math.max(1, (Date.now() - created) / 36e5);
      return v / Math.pow(ageHours, 0.7);
    }

    function sortPosts(posts, mode) {
      const list = [...posts];
      if (mode === "new") {
        list.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
      } else if (mode === "top") {
        list.sort((a,b) => score(b) - score(a));
      } else {
        list.sort((a,b) => hotScore(b) - hotScore(a));
      }
      return list;
    }

    function matchesSearch(post, q) {
      if (!q) return true;
      const hay = (post.title + " " + (post.body||"") + " " + (post.game||"") + " " + (post.flair||"")).toLowerCase();
      return hay.includes(q.toLowerCase());
    }

    const feedEl = document.getElementById("feed");
    const emptyEl = document.getElementById("emptyState");
    const sortSelect = document.getElementById("sortSelect");
    const searchInput = document.getElementById("searchInput");

    // --- Main render function ---
    async function render() {
      let posts = await loadPosts();
      const mode = sortSelect.value;
      const q = searchInput.value.trim();

      posts = sortPosts(posts, mode).filter(p => matchesSearch(p, q));

      feedEl.innerHTML = "";
      if (posts.length === 0) {
        // Only show empty state if user is logged in
        if (isUserLoggedIn) {
          emptyEl.classList.remove("d-none");
        } else {
          emptyEl.classList.add("d-none");
        }
        return;
      }
      emptyEl.classList.add("d-none");

      for (const post of posts) {
        feedEl.appendChild(postCard(post));
      }
    }

    // Builds one post card element with vote buttons, comments toggle, delete, share.
    // This function is large because each card has a lot of interactive parts.
    function postCard(post) {
      const wrapper = document.createElement("div");
      wrapper.className = "card shadow-sm";
      wrapper.dataset.postId = post.id;

      const pAuth = post.author || { username: 'deleted', displayName: 'Deleted User' };
      const flairBadge = `<span class="badge bg-secondary">${escapeHtml(post.flair || "Discussion")}</span>`;
      const gameTag = post.game ? `<span class="badge bg-info text-dark ms-2">${escapeHtml(post.game)}</span>` : "";
      let mediaHtml = "";
      if (post.photo) {
        // Check if it's a video by looking at the MIME type in the data URL
        const isVideo = post.photo.startsWith("data:video/");
        console.log("DEBUG: Checking post.photo - isVideo:", isVideo, "- first 50 chars:", post.photo.substring(0, 50));
        if (isVideo) {
          // Extract video MIME type (e.g., "data:video/mp4;base64,..." -> "video/mp4")
          const typeMatch = post.photo.match(/data:([^;]+)/);
          const videoType = (typeMatch && typeMatch[1]) || 'video/mp4';
          console.log("DEBUG: Video detected with type:", videoType);
          mediaHtml = `<video class="community-post-photo" controls style="max-width:100%;width:100%;border-radius:8px;margin-top:12px;background:#000;">
            <source src="${post.photo}" type="${videoType}">
            Your browser does not support the video tag.
          </video>`;
        } else {
          mediaHtml = `<img src="${post.photo}" class="community-post-photo" alt="Post media" loading="lazy">`;
        }
      }

      wrapper.innerHTML = `
        <div class="card-body">
          <div class="d-flex gap-3">
            <div class="text-center" style="width:72px;">
              <button class="btn btn-outline-success btn-sm w-100 mb-1" data-act="up">▲</button>
              <div class="fw-bold" data-score>${score(post)}</div>
              <button class="btn btn-outline-danger btn-sm w-100 mt-1" data-act="down">▼</button>
            </div>

            <div class="flex-grow-1">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                ${flairBadge}
                ${gameTag}
                <span class="text-muted small d-flex align-items-center gap-1">
                  <span class="comment-avatar" style="background:${getAuthorColor(pAuth.username)};color:${['#febc2e'].includes(getAuthorColor(pAuth.username)) ? '#0d1217' : '#fff'};width:22px;height:22px;font-size:0.55rem;">${getInitials(pAuth.displayName || pAuth.username)}</span>
                  <strong class="text-white">${escapeHtml(pAuth.displayName || pAuth.username)}</strong> · ${fmtTime(post.createdAt)}
                </span>
              </div>

              <h5 class="mt-2 mb-1">${escapeHtml(post.title)}</h5>

              ${post.body ? `<div class="text-muted">${escapeHtml(post.body).replace(/\n/g, "<br/>")}</div>` : ""}

              ${mediaHtml}

              <div class="mt-3 d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-primary btn-sm" data-act="toggleComments">
                  Comments <span class="badge bg-light text-dark ms-1" data-commentcount>${(post.comments||[]).length}</span>
                </button>
                <button class="btn btn-outline-secondary btn-sm" data-act="share">Copy Link</button>
                ${currentUserId && post.author && String(post.author._id) === String(currentUserId) ? `
                  <button class="btn btn-outline-warning btn-sm" data-act="edit">Edit</button>
                  <button class="btn btn-outline-danger btn-sm" data-act="delete">Delete</button>
                ` : ""}
              </div>

              <div class="mt-3 d-none" data-comments>
                <div class="comment-panel p-3">
                  <div class="comment-input-wrap d-flex align-items-center gap-2 mb-3">
                    <div class="comment-avatar" style="background:#5383e8;">${getInitials(currentUsername)}</div>
                    <input class="form-control flex-grow-1" maxlength="300" placeholder="Write a comment..."/>
                    <button class="btn btn-primary" data-act="addComment" style="width:40px;height:40px;padding:0;display:flex;align-items:center;justify-content:center;">→</button>
                  </div>

                  <div class="d-grid gap-2" data-commentlist></div>
                  <div class="text-muted small mt-2 text-center" data-nocomments style="display:none;">No comments yet. Be the first to reply.</div>
                </div>
              </div>

            </div>
          </div>
        </div>
      `;

      wrapper.querySelector('[data-act="up"]').addEventListener("click", () => vote(post.id, +1));
      wrapper.querySelector('[data-act="down"]').addEventListener("click", () => vote(post.id, -1));
      wrapper.querySelector('[data-act="toggleComments"]').addEventListener("click", () => toggleComments(wrapper));
      wrapper.querySelector('[data-act="share"]').addEventListener("click", () => copyLink(post.id));

      const editBtn = wrapper.querySelector('[data-act="edit"]');
      if (editBtn) {
        editBtn.addEventListener("click", () => openEditModal(post));
      }

      const deleteBtn = wrapper.querySelector('[data-act="delete"]');
      if (deleteBtn) {
        deleteBtn.addEventListener("click", () => deletePost(post.id));
      }

      const addBtn = wrapper.querySelector('[data-act="addComment"]');
      addBtn.addEventListener("click", () => {
        const input = addBtn.parentElement.querySelector("input");
        const text = input.value.trim();
        if (!text) return;
        
        // Show comment instantly with proper styling
        const commentList = wrapper.querySelector("[data-commentlist]");
        const commentEl = document.createElement("div");
        commentEl.className = "comment-item";
        const initials = getInitials(currentUsername || "You");
        const color = getAuthorColor(currentUsername || "Gamer");
        const textColor = ["#febc2e"].includes(color) ? "#0d1217" : "#fff";
        
        commentEl.innerHTML = `
          <div class="d-flex gap-2">
            <div class="comment-avatar" style="background:${color};color:${textColor};">${initials}</div>
            <div class="flex-grow-1">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="comment-author" style="color:${color};">${escapeHtml(currentUsername || "You")}</span>
                <span class="comment-time">now</span>
              </div>
              <div class="comment-text">${escapeHtml(text).replace(/\n/g, "<br/>")}</div>
            </div>
          </div>
        `;
        commentList.appendChild(commentEl);
        input.value = "";
        
        // Post to server in background (don't wait)
        addComment(post.id, text);
      });

      const commentList = wrapper.querySelector("[data-commentlist]");
      const noComments = wrapper.querySelector("[data-nocomments]");
      const comments = post.comments || [];
      if (comments.length === 0) {
        noComments.style.display = "block";
      } else {
        noComments.style.display = "none";
        for (const c of comments.slice().sort((a,b) => new Date(a.createdAt) - new Date(b.createdAt))) {
          commentList.appendChild(commentRow(post.id, c));
        }
      }

      return wrapper;
    }

    // Author-to-color map for consistent avatar colors across the page
    const authorColors = {
      "Kane_Joshua": "#5383e8",
      "Justin_Ice": "#2dd4bf",
      "Seanne_C": "#e85383",
      "MarcusRPG": "#febc2e",
      "NightOwlAria": "#a78bfa"
    };

    function getInitials(name) {
      if (!name) return "??";
      return name.split(/[_\s]+/).map(w => w[0]).join("").toUpperCase().slice(0, 2);
    }

    function getAuthorColor(name) {
      return authorColors[name] || "#5383e8";
    }

    function commentRow(postId, comment) {
      const row = document.createElement("div");
      row.className = "comment-item";
      const authorName = comment.author.displayName || comment.author.username;
      const initials = getInitials(authorName);
      const color = getAuthorColor(comment.author.username);
      const textColor = ["#febc2e"].includes(color) ? "#0d1217" : "#fff";
      row.innerHTML = `
        <div class="d-flex gap-2">
          <div class="comment-avatar" style="background:${color};color:${textColor};">${initials}</div>
          <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="comment-author" style="color:${color};">${escapeHtml(authorName)}</span>
              <span class="comment-time">${fmtTime(comment.createdAt)}</span>
            </div>
            <div class="comment-text">${escapeHtml(comment.text).replace(/\n/g, "<br/>")}</div>
          </div>
        </div>
      `;

      return row;
    }

    // --- Actions: vote, comment, delete, share ---
    // No auth yet so anyone can vote unlimited times.
    async function vote(postId, dir) {
      try {
        const res = await fetch(`/api/posts/${postId}/vote`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ direction: dir > 0 ? 'up' : 'down' })
        });
        if (!res.ok) throw new Error('Vote failed');
        render();
      } catch (err) {
        console.error(err);
      }
    }

    function toggleComments(cardEl) {
      const commentsWrap = cardEl.querySelector("[data-comments]");
      commentsWrap.classList.toggle("d-none");
    }

    async function addComment(postId, text) {
      try {
        const res = await fetch(`/api/posts/${postId}/comment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ text })
        });
        if (!res.ok) throw new Error('Comment failed');
        // Comment already shown optimistically, just silently confirm with server
      } catch (err) {
        console.error('Comment submission error:', err);
        // In case of error, a simple alert could be added, but for now errors are silent
      }
    }

    function copyLink(postId) {
      const url = new URL(window.location.href);
      url.hash = "post-" + postId;
      (navigator.clipboard?.writeText(url.toString()) || Promise.reject()).then(() => {
        const card = document.querySelector(`[data-post-id="${postId}"]`);
        const btn = card ? card.querySelector('[data-act="share"]') : null;
        if (!btn) return;
        const old = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => btn.textContent = old, 900);
      }).catch(() => {
        alert("Copy failed. You can manually copy the URL from the address bar.");
      });
    }

    // Edit modal state
    let editingPostId = null;

    function openEditModal(post) {
      editingPostId = post.id;
      document.getElementById("editPostTitle").value = post.title || "";
      document.getElementById("editPostBody").value = post.body || "";
      document.getElementById("editPostFlair").value = post.flair || "Discussion";
      document.getElementById("editPostGame").value = post.game || "";
      const editModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("editPostModal"));
      editModal.show();
    }

    async function deletePost(postId) {
      document.getElementById("confirmDeletePostId").value = postId;
      const deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("deletePostModal"));
      deleteModal.show();
    }

    document.getElementById("confirmDeleteBtn").addEventListener("click", async () => {
      const postId = document.getElementById("confirmDeletePostId").value;
      try {
        const res = await fetch(`/api/posts/${postId}`, {
          method: 'DELETE',
          credentials: 'include'
        });
        if (!res.ok) throw new Error('Delete failed');
        const deleteModal = bootstrap.Modal.getInstance(document.getElementById("deletePostModal"));
        deleteModal.hide();
        render();
      } catch (err) {
        console.error('Delete error:', err);
        alert("Failed to delete post");
      }
    });

    async function savePostEdit() {
      const title = document.getElementById("editPostTitle").value.trim();
      const body = document.getElementById("editPostBody").value.trim();
      const flair = document.getElementById("editPostFlair").value;
      const game = document.getElementById("editPostGame").value.trim();

      if (!title) {
        alert("Title is required");
        return;
      }

      try {
        const res = await fetch(`/api/posts/${editingPostId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ title, body, flair, game: game || undefined })
        });
        if (!res.ok) throw new Error('Update failed');
        const editModal = bootstrap.Modal.getInstance(document.getElementById("editPostModal"));
        editModal.hide();
        render();
      } catch (err) {
        console.error('Edit error:', err);
        alert("Failed to update post");
      }
    }

    const postTitle = document.getElementById("postTitle");
    const postBody = document.getElementById("postBody");
    const postFlair = document.getElementById("postFlair");
    const postGame = document.getElementById("postGame");
    const postError = document.getElementById("postError");
    const createPostBtn = document.getElementById("createPostBtn");
    const newPostModalEl = document.getElementById("newPostModal");
    const newPostModal = bootstrap.Modal.getOrCreateInstance(newPostModalEl);

    // Photo upload handling for community posts
    let communitySelectedPhoto = null;
    const communityPhotoUploadArea = document.getElementById("communityPhotoUploadArea");
    const communityPhotoInput = document.getElementById("communityPhotoInput");
    const communityPhotoPreviewContainer = document.getElementById("communityPhotoPreviewContainer");

    function resetPhotoUpload() {
      communitySelectedPhoto = null;
      communityPhotoInput.value = "";
      communityPhotoUploadArea.classList.remove("has-photo");
      communityPhotoUploadArea.innerHTML = "";
      const icon = document.createElement("i");
      icon.className = "bi bi-image";
      icon.style.cssText = "font-size: 1.5rem; color: #5383e8;";
      const p = document.createElement("p");
      p.className = "mb-0 mt-2 small";
      p.textContent = "Click to upload a screenshot or photo";
      communityPhotoUploadArea.appendChild(icon);
      communityPhotoUploadArea.appendChild(p);
      communityPhotoUploadArea.appendChild(communityPhotoInput);
    }

    communityPhotoUploadArea.addEventListener("click", (e) => {
      if (e.target.closest(".community-photo-remove-btn")) return;
      if (!communitySelectedPhoto) communityPhotoInput.click();
    });

    communityPhotoInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (file) {
        if (file.size > 100 * 1024 * 1024) {
          postError.style.display = "block";
          postError.className = "alert alert-danger alert-dismissible fade show mb-0";
          postError.innerHTML = `<i class="bi bi-exclamation-circle me-2"></i><strong>File too large!</strong> Maximum file size is 100MB. Your file is ${(file.size / (1024 * 1024)).toFixed(1)}MB.<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
          return;
        }
        const isVideo = file.type.startsWith('video/');
        const reader = new FileReader();
        reader.onload = (event) => {
          communitySelectedPhoto = event.target.result;
          communityPhotoUploadArea.classList.add("has-photo");
          communityPhotoUploadArea.innerHTML = "";
          
          if (isVideo) {
            const video = document.createElement("video");
            video.src = communitySelectedPhoto;
            video.className = "community-photo-preview-img";
            video.controls = true;
            video.style.cssText = "max-width:100%;max-height:300px;background:#000;";
            communityPhotoUploadArea.appendChild(video);
          } else {
            const img = document.createElement("img");
            img.src = communitySelectedPhoto;
            img.className = "community-photo-preview-img";
            img.alt = "Preview";
            communityPhotoUploadArea.appendChild(img);
          }
          
          communityPhotoUploadArea.appendChild(communityPhotoInput);
          const removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.className = "btn btn-sm btn-outline-danger community-photo-remove-btn";
          removeBtn.textContent = "Remove Media";
          removeBtn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            resetPhotoUpload();
          });
          communityPhotoUploadArea.appendChild(removeBtn);
          postError.style.display = "none";
        };
        reader.readAsDataURL(file);
      }
    });

    createPostBtn.addEventListener("click", () => {
      const title = postTitle.value.trim();
      const body = postBody.value.trim();
      const flair = postFlair.value;
      const game = postGame.value.trim();

      if (title.length < 3) {
        postError.style.display = "block";
        postError.textContent = "Title must be at least 3 characters.";
        return;
      }

      fetch('/api/posts', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          body,
          flair,
          game,
          photo: communitySelectedPhoto
        })
      })
      .then(res => {
        if (!res.ok) {
          return res.json().then(err => Promise.reject(err));
        }
        return res.json();
      })
      .then(post => {
        postTitle.value = "";
        postBody.value = "";
        postGame.value = "";
        postFlair.value = "Discussion";
        postError.style.display = "none";
        postError.textContent = "";
        resetPhotoUpload();
        newPostModal.hide();
        location.hash = "post-" + post.id;
        render();
        updateSidebarStats();
      })
      .catch(err => {
        console.error('Post creation error:', err);
        postError.style.display = "block";
        postError.textContent = "Error: " + (err.error || err.message || "Failed to create post. Try again.");
      });
    });

    document.getElementById("savePostEditBtn").addEventListener("click", savePostEdit);

    sortSelect.addEventListener("change", render);
    searchInput.addEventListener("input", () => {
      clearTimeout(window.__bhSearchT);
      window.__bhSearchT = setTimeout(render, 350);
    });

    // --- Auto-seed: pre-made sample posts seeded on first visit ---
    function seedDefaultPosts() {
      // Backend handles seeding or starts empty. 
    }

    seedDefaultPosts();

    // Update sidebar stats dynamically from post data
    async function updateSidebarStats() {
      const posts = await loadPosts();
      const totalPosts = posts.length;
      const totalComments = posts.reduce((sum, p) => sum + (p.comments || []).length, 0);
      
      const authors = new Set();
      posts.forEach(p => {
        if (p.author) authors.add(p.author.username);
        (p.comments || []).forEach(c => { if (c.author) authors.add(c.author.username); });
      });

      document.getElementById('statTotalPosts').textContent = totalPosts;
      document.getElementById('statTotalComments').textContent = totalComments;
      document.getElementById('statActiveMembers').textContent = authors.size;

      const membersList = document.getElementById('activeMembersList');
      
      // Load backlog members from API
      try {
        const membersRes = await fetch('/api/community/backlog-members');
        if (!membersRes.ok) throw new Error('Failed to fetch members');
        const backlogMembers = await membersRes.json();

        if (backlogMembers.length === 0) {
          membersList.innerHTML = '<div class="text-muted small">No members with backlog yet.</div>';
          document.getElementById('statActiveMembers').textContent = '0';
          return;
        }

        // Update active members count
        document.getElementById('statActiveMembers').textContent = backlogMembers.length;

        // Render backlog members
        const avatarColors = ['#5383e8','#2dd4bf','#e85383','#febc2e','#a78bfa'];
        let html = '';
        backlogMembers.forEach((user, idx) => {
          const name = user.displayName || 'Anonymous';
          const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
          const color = avatarColors[idx % avatarColors.length];
          const textColor = ['#febc2e'].includes(color) ? '#0d1217' : '#fff';
          html += `
            <div class="d-flex align-items-center justify-content-between gap-2">
              <div class="d-flex align-items-center gap-2">
                <div class="comment-avatar" style="background:${color};color:${textColor};width:28px;height:28px;font-size:0.6rem;">${initials}</div>
                <div>
                  <div class="small" style="font-weight: 600; color: #dbe7ff;">${escapeHtml(name)}</div>
                  <div class="text-muted" style="font-size: 0.7rem;">${user.backlogCount} game${user.backlogCount !== 1 ? 's' : ''}</div>
                </div>
              </div>
            </div>
          `;
        });
        membersList.innerHTML = html;
      } catch (err) {
        console.error('Failed to load backlog members:', err);
        membersList.innerHTML = '<div class="text-muted small">Unable to load members.</div>';
        document.getElementById('statActiveMembers').textContent = '0';
      }
    }

    // Deep-link handler — if URL has #post-<id>, scroll to that post and open its comments.
    // Used by the "Copy Link" share feature
    function openCommentsForHash() {
      if (!location.hash.startsWith("#post-")) return;
      const id = location.hash.replace("#post-", "");
      const card = document.querySelector(`[data-post-id="${id}"]`);
      if (!card) return;

      const commentsWrap = card.querySelector("[data-comments]");
      if (commentsWrap) commentsWrap.classList.remove("d-none");

      card.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    render().then(() => {
      updateSidebarStats();
      setTimeout(() => openCommentsForHash(), 150);
    });

    // Logout function
    async function logout(event) {
      event.preventDefault();
      try {
          await fetch('/api/auth/logout', {
              method: 'POST',
              credentials: 'include'
          });
          window.location.href = '/login';
      } catch (err) {
          console.error('Logout failed:', err);
          window.location.href = '/login';
      }
    }

    // Smart home navigation - if logged in go to dashboard, else go to index
    async function smartHomeClick(e) {
      e.preventDefault();
      try {
        const res = await fetch('/api/auth/current', { credentials: 'include' });
        const dest = res.ok ? '/dashboard' : '/';
        document.body.classList.add('page-exit');
        setTimeout(() => window.location = dest, 300);
      } catch (err) {
        console.error('Auth check failed:', err);
        window.location = '/';
      }
    }

    // Page exit transition
    document.querySelectorAll('a[href]').forEach(a => {
      if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
        a.addEventListener('click', e => {
          e.preventDefault();
          const dest = a.href;
          document.body.classList.add('page-exit');
          setTimeout(() => window.location = dest, 300);
        });
      }
    });

    // Navbar scroll shadow (passive, cached)
    const _nav = document.querySelector('.navbar');
    let _scrollTick = false;
    window.addEventListener('scroll', () => {
      if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
    }, { passive: true });
    }); // End of window load
  </script>
