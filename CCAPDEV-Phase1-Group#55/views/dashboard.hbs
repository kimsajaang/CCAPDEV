<!-- Page scripts:
     1) Fake loader — hides after 1.2s timeout
     2) Scroll reveal — uses IntersectionObserver to fade in cards as they enter viewport
     The threshold 0.12 means the animation triggers when 12% of the card is visible -->
<script>
  window.addEventListener("load", () => {
    const loader = document.getElementById("page-loader");
    setTimeout(() => {
      loader.classList.add("hidden");
      document.body.classList.remove("loading");
    }, 1200);
  });
  const revealItems = document.querySelectorAll(".reveal");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  revealItems.forEach((item) => observer.observe(item));

  // ============================================================
  // What's the Plan — backlog suggestion engine
  // ============================================================
  const discoverGames = [
    { name: "Black Myth: Wukong", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co5wex.jpg", genre: "Action RPG", minSession: 30, avgSession: 60, note: "Boss fights require focus" },
    { name: "Red Dead Redemption 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1q1f.jpg", genre: "Open World", minSession: 45, avgSession: 90, note: "Great for long sessions" },
