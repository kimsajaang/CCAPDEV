<style>
  /* Page-specific: dashboard overrides */
  body.loading {
    overflow: hidden;
  }

  .spin-icon {
    display: inline-block;
    animation: spin 0.8s linear infinite;
  }

  .user-post-item {
    border-left: 4px solid var(--primary) !important;
  }

  .photo-upload-area {
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), background var(--duration) var(--ease);
    background: rgba(83, 131, 232, 0.05);
  }

  .photo-upload-area:hover {
    border-color: var(--primary);
    background: rgba(83, 131, 232, 0.1);
  }

  .photo-upload-area.has-photo {
    border: 1px solid var(--border);
    padding: 8px;
    background: transparent;
  }

  .photo-preview-img {
    max-width: 100%;
    max-height: 300px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin-bottom: 10px;
  }

  .photo-remove-btn {
    font-size: 0.8rem;
    padding: 4px 8px;
  }

  .feed-photo {
    width: 100%;
    max-height: 400px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin: 10px 0;
    border: 1px solid var(--border);
  }

  /* Particle canvas */
  #particleCanvas {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* Trending section */
  .trending-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .trending-header h5 {
    margin: 0;
  }

  .trending-date {
    opacity: 0.55;
    white-space: nowrap;
  }

  .trending-header .btn {
    margin-left: auto;
  }

  .trending-scroll-wrap {
    position: relative;
  }

  .trending-scroll-wrap .scroll-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(10, 14, 19, 0.95);
    border: 1px solid var(--border);
    color: var(--text);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .trending-scroll-wrap .scroll-btn:hover {
    background: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(83, 131, 232, 0.3);
  }

  .trending-scroll-wrap .scroll-left {
    left: -12px;
  }

  .trending-scroll-wrap .scroll-right {
    right: -12px;
  }

  /* Top 50 modal */
  .top50-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }

  .top50-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .top50-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .top50-card img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }

  .top50-card .top50-rank {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
