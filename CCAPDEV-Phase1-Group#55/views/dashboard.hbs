<style>
  /* Page-specific: dashboard overrides */
  body.loading {
    overflow: hidden;
  }


  .user-post-item {
    border-left: 4px solid var(--primary) !important;
  }

  .photo-upload-area {
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease), background var(--duration) var(--ease);
    background: rgba(83, 131, 232, 0.05);
  }

  .photo-upload-area:hover {
    border-color: var(--primary);
    background: rgba(83, 131, 232, 0.1);
  }

  .photo-upload-area.has-photo {
    border: 1px solid var(--border);
    padding: 8px;
    background: transparent;
  }

  .photo-preview-img {
    max-width: 100%;
    max-height: 300px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin-bottom: 10px;
  }

  .photo-remove-btn {
    font-size: 0.8rem;
    padding: 4px 8px;
  }

  .feed-photo {
    width: 100%;
    max-height: 400px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin: 10px 0;
    border: 1px solid var(--border);
  }


  /* Trending section */
  .trending-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .trending-header h5 {
    margin: 0;
  }

  .trending-date {
    opacity: 0.55;
    white-space: nowrap;
  }

  .trending-header .btn {
    margin-left: auto;
  }

  .trending-scroll-wrap {
    position: relative;
  }

  .trending-scroll-wrap .scroll-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(10, 14, 19, 0.95);
    border: 1px solid var(--border);
    color: var(--text);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .trending-scroll-wrap .scroll-btn:hover {
    background: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(83, 131, 232, 0.3);
  }

  .trending-scroll-wrap .scroll-left {
    left: -12px;
  }

  .trending-scroll-wrap .scroll-right {
    right: -12px;
  }

  /* Top 50 modal */
  .top50-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }

  .top50-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .top50-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .top50-card img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }

  .top50-card .top50-rank {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
  }

  .top50-card .top50-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 8px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }

  .top50-card .top50-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .top50-card .top50-rating {
    font-size: 0.7rem;
    color: #fb923c;
  }

  /* Trailers section */
  .trailers-card {
    background: var(--bg-card);
    border: 1px solid var(--border) !important;
  }

  .trailers-scroll {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  .trailers-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .trailers-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  .trailer-item {
    flex: 0 0 280px;
    border-radius: var(--radius-md);
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .trailer-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .trailer-thumb {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
  }

  .trailer-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .trailer-item:hover .trailer-play-icon {
    opacity: 1;
  }

  .trailer-play-icon i {
    font-size: 2.4rem;
    color: #fff;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
  }

  /* --- Game Suggestion Highlight --- */
  .highlight {
    animation: highlightGlow 1.2s ease-out;
  }

  @keyframes highlightGlow {
    0% {
      background: rgba(83, 131, 232, 0);
      box-shadow: 0 0 0 rgba(83, 131, 232, 0);
    }
    15% {
      background: rgba(83, 131, 232, 0.15);
      box-shadow: 0 0 30px rgba(83, 131, 232, 0.3);
      transform: scale(1.02);
    }
    100% {
      background: rgba(83, 131, 232, 0);
      box-shadow: 0 0 0 rgba(83, 131, 232, 0);
      transform: scale(1);
    }
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .trailer-name {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 10px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Trailer modal */
  .trailer-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .trailer-modal.active {
    opacity: 1;
    pointer-events: all;
  }

  .trailer-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  .trailer-modal-content {
    position: relative;
    width: 90vw;
    max-width: 900px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0a0e13;
    border: 1px solid var(--border);
    transform: scale(0.92);
    transition: transform 0.3s ease;
  }

  .trailer-modal.active .trailer-modal-content {
    transform: scale(1);
  }

  .trailer-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .trailer-modal-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
  }

  .trailer-modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: color 0.2s, background 0.2s;
  }

  .trailer-modal-close:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  .trailer-modal-body {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
  }

  .trailer-modal-body iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Completion ring */
  .completion-ring {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4);
    background: rgba(10, 14, 19, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .completion-ring-text {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .completion-ring-text strong {
    color: var(--text);
    font-weight: 700;
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .suggestion-item {
    transition: background 0.2s ease, transform 0.2s ease;
    border-radius: var(--radius-md);
    padding: 8px;
    margin: -8px; /* Offset the padding for the container */
  }

  .suggestion-item:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(4px);
  }

  .suggest-result.highlight {
    border-color: var(--primary) !important;
    box-shadow: 0 0 20px rgba(83, 131, 232, 0.2);
  }
</style>


<!-- Fake loading screen -->
<div id="page-loader" class="loader" aria-label="Loading">
  <div class="loader-card">
    <div class="loader-icon-wrap">
      <i class="bi bi-controller"></i>
      <div class="loader-glow"></div>
    </div>
    <div>
      <div class="loader-text">Loading Dashboard<span class="loading-dots"></span></div>
      <div class="loader-sub">Warming up your backlog recommendations</div>
    </div>
  </div>
</div>{{> navbar-app activePage="dashboard"}}

<div class="container my-5">
  <!-- Welcome hero card with user stats -->
  <div class="hero hero-compact mb-4 reveal">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h2 class="mb-2" id="welcomeTitle"
          style="font-size:clamp(1.8rem, 4vw, 2.8rem); font-weight:900; letter-spacing:-0.03em; line-height:1.1;">
          Play smarter, <span class="gradient-text">finish more.</span>
        </h2>
        <p class="hero-sub mb-4 opacity-75" style="font-size: 1.1rem;">Your personal command center for game tracking
          and discovery.</p>

        <div class="d-flex flex-wrap gap-3">
          <a class="btn btn-premium" href="/search">
            <i class="bi bi-search me-2"></i>Find Games
          </a>
          <a class="btn btn-premium-outline" href="/library">
            <i class="bi bi-collection-play me-2"></i>My Library
          </a>
        </div>
      </div>

      <div class="col-lg-6 d-flex gap-4 justify-content-lg-end align-items-center mt-4 mt-lg-0">
        
        <div class="hero-stats justify-content-lg-end">
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-check-circle-fill"></i>Completed</div>
            <div class="hero-stat-value counter-animate" id="statCompleted">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-controller"></i>Collection</div>
            <div class="hero-stat-value counter-animate" id="statTotal">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-hourglass-split"></i>Backlog</div>
            <div class="hero-stat-value counter-animate" id="statBacklog">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-play-fill"></i>Playing</div>
            <div class="hero-stat-value counter-animate" id="statPlaying">0</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-label"><i class="bi bi-clock-history"></i>Hours</div>
            <div class="hero-stat-value counter-animate" id="statHours">0</div>
          </div>
        </div>

        <div id="steamLiveCard" style="display:none; width: 160px; flex-shrink: 0; animation: fadeInScale 0.4s ease forwards;">
            <div style="font-size: 0.8rem; color: #4ab76b; font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                <span class="dot-live" style="width:7px; height:7px; background:#4ab76b; border-radius:50%; box-shadow: 0 0 10px #4ab76b; animation: pulseLive 2s infinite; display: inline-block;"></span>
                Playing
            </div>
            <div class="game-card" style="border-radius: 12px; overflow: hidden; position: relative; border: 1px solid rgba(74, 183, 107, 0.4); box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 20px rgba(74, 183, 107, 0.2); cursor: pointer;" onclick="window.location.href='/library'">
                <img id="steamLiveGameCover" src="" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block;" alt="Game Cover" onerror="this.onerror=null;this.src='https://via.placeholder.com/300x400/1a2634/5383e8?text=Playing';">
                <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,0.95), transparent); padding: 30px 10px 10px;">
                    <span id="steamLiveGameNameCard" style="font-size: 0.95rem; font-weight: 800; color: #fff; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 2px 4px rgba(0,0,0,0.9);">Game Name</span>
                </div>
            </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Trending Games -->
  <div class="trending-section mb-4 reveal">
    <div class="trending-header">
      <h5><i class="bi bi-fire me-2" style="color:#fb923c;"></i>Trending <span class="gradient-text">Right Now</span>
      </h5>

      <button class="btn btn-sm btn-outline-primary" id="seeAllBtn">See All</button>
    </div>
    <div class="trending-scroll-wrap">
      <button class="scroll-btn scroll-left"
        onclick="document.getElementById('trendingScroll').scrollBy({left:-340,behavior:'smooth'})"><i
          class="bi bi-chevron-left"></i></button>
      <div class="trending-scroll" id="trendingScroll">
        <div class="text-muted small p-3">Loading trending games...</div>
      </div>
      <button class="scroll-btn scroll-right"
        onclick="document.getElementById('trendingScroll').scrollBy({left:340,behavior:'smooth'})"><i
          class="bi bi-chevron-right"></i></button>
    </div>
  </div>

  <div class="row g-4 reveal">
    <div class="col-md-3">
      <!-- Backlog suggestion tool — user enters available minutes, gets a game pick.
     Right now the recommendation is hardcoded
     based on the user's actual library and avg session lengths. -->
      <div class="card mb-4 reveal">
        <div class="card-body">
          <h5 class="card-title"><i class="bi bi-magic me-2"></i>What's the Plan?</h5>
          <p class="text-muted small">Pick a source, choose genres, and enter your time.</p>
          <div class="btn-group w-100 mb-3 plan-source-group" role="group">
            <input type="radio" class="btn-check" name="planSource" id="planSourceLibrary" value="library" checked>
            <label class="btn btn-sm btn-plan-toggle" for="planSourceLibrary"><i class="bi bi-collection me-1"></i>My
              Library</label>
            <input type="radio" class="btn-check" name="planSource" id="planSourceNew" value="new">
            <label class="btn btn-sm btn-plan-toggle" for="planSourceNew"><i class="bi bi-stars me-1"></i>Try Something
              New</label>
          </div>
          <div class="mb-3">
            <label class="form-label small text-muted mb-1">Genres <span
                class="text-secondary">(optional)</span></label>
            <div class="genre-chips" id="genreChips">
              <input type="checkbox" class="btn-check" id="gAction" value="Action"><label class="genre-chip"
                for="gAction">Action</label>
              <input type="checkbox" class="btn-check" id="gRPG" value="RPG"><label class="genre-chip"
                for="gRPG">RPG</label>
              <input type="checkbox" class="btn-check" id="gShooter" value="Shooter"><label class="genre-chip"
                for="gShooter">Shooter</label>
              <input type="checkbox" class="btn-check" id="gMOBA" value="MOBA"><label class="genre-chip"
                for="gMOBA">MOBA</label>
              <input type="checkbox" class="btn-check" id="gRoguelike" value="Roguelike"><label class="genre-chip"
                for="gRoguelike">Roguelike</label>
              <input type="checkbox" class="btn-check" id="gPuzzle" value="Puzzle"><label class="genre-chip"
                for="gPuzzle">Puzzle</label>
              <input type="checkbox" class="btn-check" id="gOpenWorld" value="Open World"><label class="genre-chip"
                for="gOpenWorld">Open World</label>
              <input type="checkbox" class="btn-check" id="gPlatformer" value="Platformer"><label class="genre-chip"
                for="gPlatformer">Platformer</label>
              <input type="checkbox" class="btn-check" id="gSim" value="Sim"><label class="genre-chip"
                for="gSim">Sim</label>
            </div>
          </div>
          <div class="input-group mb-3">
            <input id="planHours" type="number" min="0" inputmode="numeric"
              class="form-control bg-dark text-white border-secondary" placeholder="Hours">
            <input id="planMinutes" type="number" min="0" max="59" inputmode="numeric"
              class="form-control bg-dark text-white border-secondary" placeholder="Minutes">
            <button id="planSuggestBtn" class="btn btn-primary" type="button">Suggest</button>
          </div>
          <div id="planResult" class="suggest-result p-3 rounded bg-dark border border-secondary">
            <p class="mb-0 small text-muted">Pick a source and hit Suggest!</p>
          </div>
        </div>
      </div>

      <!-- Latest Game Trailers -->
      <div class="card border-0 mb-4 reveal trailers-card">
        <div class="card-body p-3">
          <h6 class="mb-3"><i class="bi bi-play-circle me-1" style="color:var(--accent)"></i>Latest Trailers</h6>
          <div class="trailers-scroll" id="trailersScroll">
            <div class="text-muted small p-2">Loading trailers...</div>
          </div>
        </div>
      </div>

      <!-- Community ratings sidebar -->
      <div class="card reveal">
        <div class="card-body">
          <h6 class="mb-3">Community Quality Scores</h6>
          <div id="communityScores">
            <p class="text-muted small mb-0">Loading scores...</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-5">
      <!-- Friend Activity Feed -->
      <div class="d-flex justify-content-between align-items-center mb-4 reveal">
        <h4><i class="bi bi-broadcast me-2" style="color:var(--accent);"></i>Friend Activity <span
            class="gradient-text-accent">Feed</span></h4>
        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#postUpdateModal"><i
            class="bi bi-plus-lg me-1"></i>Post Update</button>
      </div>

      <div class="list-group shadow-sm" id="activityFeed">
        <div class="list-group-item p-3 text-center text-muted">Loading activity feed...</div>
      </div>
    </div>

    <!-- CHAT SIDEBAR -->
    <div class="col-md-4">
      <div class="card" style="position: sticky; top: 80px; height: calc(100vh - 120px); display: flex; flex-direction: column; overflow: hidden;">
        <div class="card-header d-flex align-items-center justify-content-between py-2 px-3" style="border-bottom: 1px solid var(--border);">
          <h6 class="mb-0 d-flex align-items-center gap-2"><i class="bi bi-people-fill" style="color:var(--accent);"></i>
            <select id="chatGroupSelect" onchange="switchChatGroup(this.value)" class="form-select form-select-sm bg-dark text-white border-secondary" style="width: auto; font-size: 0.82rem; font-family: inherit;">
              <!-- Populated via JS -->
            </select>
          </h6>
          <div class="d-flex gap-1">
            <button class="btn btn-sm btn-link p-1" id="addMemberBtn" onclick="openInviteModal()" style="color:var(--text-muted); display:none;" title="Invite Members"><i class="bi bi-person-plus-fill"></i></button>
            <button class="btn btn-sm btn-link p-1" onclick="openCreateGroupModal()" style="color:var(--accent);" title="Create Group"><i class="bi bi-plus-circle-fill"></i></button>
          </div>
        </div>
        <div id="chatMessages" style="flex: 1; overflow-y: auto; padding: 12px;">
          <div class="text-center text-muted small py-5"><i class="bi bi-chat-dots" style="font-size:2rem; display:block; margin-bottom:10px; opacity:0.15;"></i>Loading chat...</div>
        </div>
        <div class="card-footer p-2" style="border-top: 1px solid var(--border);">
          <input type="text" id="chatInput" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Send a message..." onkeypress="handleChatInput(event)" style="font-size: 0.85rem;">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Floating Feedback Button -->
<a href="/feedback" class="btn btn-primary rounded-pill shadow-lg d-flex align-items-center gap-2" 
   style="position: fixed; bottom: 22px; left: 22px; z-index: 1050; padding: 12px 22px; transition: transform 0.2s, box-shadow 0.2s;"
   onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 25px rgba(83,131,232,0.5)'"
   onmouseout="this.style.transform='none'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,.15)'">
  <i class="bi bi-chat-left-text-fill fs-5"></i>
  <span class="fw-bold">Feedback</span>
</a>

<!-- Post Update Modal -->
<div class="modal fade" id="postUpdateModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Post Update</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label small">What type of update?</label>
          <select id="updateType" class="form-select">
            <option value="session">Question</option>
            <option value="session">Logged a session</option>
            <option value="review">Reviewed a game</option>
            <option value="completed">Completed a game</option>
            <option value="playing">Started playing</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label small">Game</label>
          <select id="updateGame" class="form-select">
            <option value="">Loading games...</option>
