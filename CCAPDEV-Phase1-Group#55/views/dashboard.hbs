<!-- Page scripts:
     1) Fake loader — hides after 1.2s timeout
     2) Scroll reveal — uses IntersectionObserver to fade in cards as they enter viewport
     The threshold 0.12 means the animation triggers when 12% of the card is visible -->
<script>
  window.addEventListener("load", () => {
    const loader = document.getElementById("page-loader");
    setTimeout(() => {
      loader.classList.add("hidden");
      document.body.classList.remove("loading");
    }, 1200);
  });
  const revealItems = document.querySelectorAll(".reveal");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  revealItems.forEach((item) => observer.observe(item));

  // ============================================================
  // What's the Plan — backlog suggestion engine
  // ============================================================
  const discoverGames = [
    { name: "Black Myth: Wukong", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co5wex.jpg", genre: "Action RPG", minSession: 30, avgSession: 60, note: "Boss fights require focus" },
    { name: "Red Dead Redemption 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1q1f.jpg", genre: "Open World", minSession: 45, avgSession: 90, note: "Great for long sessions" },
    { name: "Far Cry 5", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1nic.jpg", genre: "Action", minSession: 20, avgSession: 45, note: "Quick outpost runs" },
    { name: "Valorant", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2mvt.jpg", genre: "Tactical Shooter", minSession: 15, avgSession: 35, note: "One comp match ~30 min" },
    { name: "League of Legends", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co49wj.jpg", genre: "MOBA", minSession: 25, avgSession: 40, note: "ARAM for quick games" },
    { name: "Hades", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2qx5.jpg", genre: "Roguelike", minSession: 15, avgSession: 25, note: "Perfect for short runs" },
    { name: "Stardew Valley", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/xrpmydnu9rpxvxfjkiu7.jpg", genre: "Farming Sim", minSession: 15, avgSession: 30, note: "Relaxed pace, save anytime" },
    { name: "Balatro", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co7kaq.jpg", genre: "Roguelike Deckbuilder", minSession: 10, avgSession: 20, note: "One run = one sitting" },
    { name: "Hollow Knight", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1rgi.jpg", genre: "Metroidvania", minSession: 20, avgSession: 45, note: "Bench saves are frequent" },
    { name: "Slay the Spire", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1iyf.jpg", genre: "Deckbuilder", minSession: 15, avgSession: 30, note: "Turn-based, pause anytime" },
    { name: "Celeste", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co3byy.jpg", genre: "Platformer", minSession: 15, avgSession: 30, note: "Short chapters, tight controls" },
    { name: "Persona 5 Royal", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2t97.jpg", genre: "JRPG", minSession: 45, avgSession: 90, note: "Story-heavy, plan long sessions" },
    { name: "Elden Ring", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co4jni.jpg", genre: "Action RPG", minSession: 30, avgSession: 60, note: "Open world exploration" },
    { name: "Portal 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1rs4.jpg", genre: "Puzzle", minSession: 20, avgSession: 40, note: "Clever puzzles, quick chapters" },
    { name: "Disco Elysium", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1sfj.jpg", genre: "RPG", minSession: 30, avgSession: 60, note: "Dialogue-heavy detective RPG" }
  ];

  let dashboardLibraryCache = null;

  async function getMyLibrary() {
    if (dashboardLibraryCache) return dashboardLibraryCache;
    try {
      const userId = currentUser && (currentUser._id || currentUser.id);
      if (!userId) return [];
      const res = await fetch('/api/library/' + userId, { credentials: 'include' });
      if (!res.ok) return [];
      const entries = await res.json();
      dashboardLibraryCache = entries.filter(e => e.gameId).map(e => ({
        name: e.gameId.name || 'Unknown',
        genre: (e.gameId.genres || []).join(' • ') || 'Game',
        cover: e.gameId.coverUrl || '',
        status: e.status,
        rating: e.rating || 0
      }));
      return dashboardLibraryCache;
    } catch (err) {
      console.error('[Dashboard] Library fetch error:', err);
      return [];
    }
  }

  async function getLibraryGames(totalMins) {
    const lib = await getMyLibrary();
    const playable = lib.filter(g => g.status === 'backlog' || g.status === 'playing');
    if (playable.length === 0) return null;
    return playable.map(g => ({
      name: g.name,
      img: g.cover || '',
      genre: g.genre || 'Game',
      avgSession: 30,
      minSession: 15,
      note: g.status === 'playing' ? 'Continue where you left off' : 'Sitting in your backlog',
      fromLibrary: true
    }));
  }

  async function getNewGames(totalMins) {
    const lib = await getMyLibrary();
    const libNames = lib.map(g => g.name.toLowerCase());
    return discoverGames.filter(g => !libNames.includes(g.name.toLowerCase()));
  }

  const planInput = document.getElementById("planMinutes");
  const planBtn = document.getElementById("planSuggestBtn");
  const planResult = document.getElementById("planResult");
  const planHours = document.getElementById("planHours");

  planBtn.addEventListener("click", suggestGame);
  planInput.addEventListener("keydown", (e) => { if (e.key === "Enter") suggestGame(); });
  planHours.addEventListener("keydown", (e) => { if (e.key === "Enter") suggestGame(); });

  async function suggestGame() {
    const hours = parseInt(planHours.value) || 0;
    const mins = parseInt(planInput.value) || 0;
    const totalMins = (hours * 60) + mins;
    const source = document.querySelector('input[name="planSource"]:checked').value;

    if (totalMins < 1) {
      planResult.innerHTML = `<p class="mb-0 small text-warning">Please enter at least 1 minute of available time.</p>`;
      return;
    }

    // Collect selected genre filters
    const selectedGenres = [...document.querySelectorAll('#genreChips input:checked')].map(c => c.value.toLowerCase());

    let pool;
    if (source === 'library') {
      pool = await getLibraryGames(totalMins);
      if (!pool || pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-warning">Your library is empty! Add some games first, or try "Try Something New".</p>`;
        return;
      }
    } else {
      pool = await getNewGames(totalMins);
      if (pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-info">You already have all our suggestions! Nice collection.</p>`;
        return;
      }
    }

    // Filter by selected genres (if any selected)
    if (selectedGenres.length > 0) {
      pool = pool.filter(g => {
        const gGenre = (g.genre || '').toLowerCase();
        return selectedGenres.some(sg => gGenre.includes(sg));
      });
      if (pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-warning">No games match those genres. Try selecting different ones!</p>`;
        return;
      }
    }

    // Filter games that fit within the available time
    const fits = pool.filter(g => g.minSession <= totalMins);
    if (fits.length === 0) {
      planResult.innerHTML = `<p class="mb-0 small text-warning">No games fit in ${hours}h ${mins}m. Try adding more time!</p>`;
      return;
    }

    // Pick random from fitting games
    const pick = fits[Math.floor(Math.random() * fits.length)];
    const sessions = Math.max(1, Math.floor(totalMins / pick.avgSession));
    const imgTag = pick.img
      ? `<img src="${pick.img}" style="width:42px;height:56px;border-radius:6px;object-fit:cover;border:1px solid #2a3843;" alt="${pick.name}" loading="lazy">`
      : `<div style="width:42px;height:56px;border-radius:6px;background:#2a3843;display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:#6f7d8a;"><i class="bi bi-controller"></i></div>`;

    const sourceLabel = source === 'library'
      ? '<span class="badge bg-primary">From Library</span>'
      : '<span class="badge bg-success">New Discovery</span>';

    planResult.innerHTML = `
            <div class="d-flex align-items-center gap-3">
              ${imgTag}
              <div>
                <p class="mb-0 small"><strong>Recommended:</strong> ${pick.name} ${sourceLabel}</p>
                <small class="text-info">~${pick.avgSession} mins/session · ${sessions > 1 ? sessions + ' sessions fit' : '1 session'}</small><br/>
                <small class="text-muted">${pick.genre} · ${pick.note}</small>
              </div>
            </div>
          `;

    // Highlight animation
    planResult.classList.add("highlight");
    setTimeout(() => planResult.classList.remove("highlight"), 1200);
  }

  // ============================================================
  // Post Update — adds new feed items to the activity feed
  // ============================================================

  let currentUser = null;

  const typeLabels = {
    "session": "logged a session",
    "review": "reviewed a game",
    "completed": "completed a game",
    "playing": "started playing"
  };

  const updateType = document.getElementById("updateType");
  const ratingGroup = document.getElementById("ratingGroup");

  // Photo upload handling
  let selectedPhoto = null;
  const photoUploadArea = document.getElementById("photoUploadArea");
  const photoInput = document.getElementById("photoInput");
  const photoPreviewContainer = document.getElementById("photoPreviewContainer");

  photoUploadArea.addEventListener("click", () => photoInput.click());
  photoInput.addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        alert("Photo must be less than 5MB");
        return;
      }
      const reader = new FileReader();
      reader.onload = (event) => {
        selectedPhoto = event.target.result;
        photoUploadArea.classList.add("has-photo");
        photoUploadArea.innerHTML = `<img src="${selectedPhoto}" class="photo-preview-img" alt="Preview" loading="lazy">`;
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "btn btn-sm btn-outline-danger photo-remove-btn";
        removeBtn.textContent = "Remove Photo";
        removeBtn.addEventListener("click", (e) => {
          e.preventDefault();
          selectedPhoto = null;
          photoInput.value = "";
          photoUploadArea.classList.remove("has-photo");
          photoUploadArea.innerHTML = `<i class="bi bi-image" style="font-size: 1.5rem; color: #5383e8;"></i><p class="mb-0 mt-2 small">Click to upload a screenshot</p>`;
        });
        photoUploadArea.appendChild(removeBtn);
      };
      reader.readAsDataURL(file);
    }
  });

  // Show/hide rating when type changes
  updateType.addEventListener("change", () => {
    ratingGroup.style.display = updateType.value === "review" ? "block" : "none";
  });

  document.getElementById("submitUpdateBtn").addEventListener("click", () => {
    const type = updateType.value;
    const game = document.getElementById("updateGame").value;
    const comment = document.getElementById("updateComment").value.trim();
    const rating = document.getElementById("updateRating").value;
    const errorEl = document.getElementById("updateError");

    if (!comment) {
      errorEl.textContent = "Please write a comment.";
      errorEl.style.display = "block";
      return;
    }

    errorEl.style.display = "none";
    const cover = document.getElementById("updateGame").value; // Just use the game name for now
    const stars = "★".repeat(parseInt(rating)) + "☆".repeat(5 - parseInt(rating));

    let extraHTML = "";
    if (type === "review") {
      extraHTML = `<div class="text-warning mb-1 extra-small">${stars}</div>`;
    } else if (type === "completed") {
      extraHTML = `<span class="badge bg-success extra-small">COMPLETED</span>`;
    } else if (type === "playing") {
      extraHTML = `<span class="badge bg-info text-dark extra-small">NOW PLAYING</span>`;
    }

    const now = new Date();
    const timeStr = now.toLocaleString(undefined, { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });

    const newItem = document.createElement("div");
    newItem.className = "list-group-item p-3 user-post-item";
    newItem.style.opacity = "0";
    newItem.style.transform = "translateY(-10px)";
    newItem.style.transition = "opacity 0.4s ease, transform 0.4s ease";

    let photoHTML = "";
    if (selectedPhoto) {
      photoHTML = `<img src="${selectedPhoto}" class="feed-photo" alt="Session screenshot" loading="lazy">`;
    }

    // Get user avatar or use default
    const userAvatar = currentUser?.avatar || "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%235383e8'%3E%3Ccircle cx='12' cy='8' r='4'/%3E%3Cpath d='M12 14c-6 0-8 3-8 3v6h16v-6s-2-3-8-3z'/%3E%3C/svg%3E";

    newItem.innerHTML = `
            <div class="d-flex align-items-center mb-2">
              <img src="${userAvatar}" class="rounded-circle me-2 avatar-sm" alt="User" style="width: 32px; height: 32px;">
              <strong class="text-primary">${currentUser?.displayName || 'Gamer'}</strong>
              <span class="text-muted ms-2 small">${typeLabels[type]}</span>
              <span class="text-muted ms-auto extra-small">${timeStr}</span>
            </div>
            <div class="d-flex align-items-start gap-3 mb-1">
              <div>
                <h6 class="mb-1 small">${game}</h6>
                ${extraHTML}
              </div>
            </div>
            <p class="mb-2 small text-white-50">"${comment.replace(/</g, '&lt;').replace(/>/g, '&gt;')}"</p>
            ${photoHTML}
          `;

    const feedList = document.querySelector(".list-group");
    feedList.insertBefore(newItem, feedList.firstChild);

    // Animate in
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        newItem.style.opacity = "1";
        newItem.style.transform = "translateY(0)";
      });
    });

    // Close modal and reset form
    const modal = bootstrap.Modal.getInstance(document.getElementById("postUpdateModal"));
    modal.hide();
    document.getElementById("updateComment").value = "";
    updateType.value = "session";
    ratingGroup.style.display = "none";

    // Reset photo
    selectedPhoto = null;
    photoInput.value = "";
    photoUploadArea.classList.remove("has-photo");
    photoUploadArea.innerHTML = `<i class="bi bi-image" style="font-size: 1.5rem; color: #5383e8;"></i><p class="mb-0 mt-2 small">Click to upload a screenshot</p>`;
  });
</script>
<!-- Floating CTA button — always visible in bottom-right corner -->
<a class="sticky-cta" href="search+_">Find Games</a>
<script>
  // Logout function
  async function logout(event) {
    event.preventDefault();
    try {
      await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'include'
      });
      window.location.href = 'login+_';
    } catch (err) {
      console.error('Logout failed:', err);
      window.location.href = 'login+_';
    }
  }

  // Steam sync function
  async function syncSteam() {
    const btn = document.getElementById('steamSyncBtn');
    const origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-arrow-repeat me-1 spin-icon"></i>Syncing...';
    try {
      const res = await fetch('/api/steam/sync', {
        method: 'POST',
        credentials: 'include'
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('statHours').textContent = data.totalHours;
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>' + data.message;
        btn.classList.replace('btn-outline-light', 'btn-outline-success');
        setTimeout(() => { btn.innerHTML = origText; btn.classList.replace('btn-outline-success', 'btn-outline-light'); btn.disabled = false; }, 3000);
      } else {
        btn.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>' + (data.error || 'Sync failed');
        btn.classList.replace('btn-outline-light', 'btn-outline-danger');
        setTimeout(() => { btn.innerHTML = origText; btn.classList.replace('btn-outline-danger', 'btn-outline-light'); btn.disabled = false; }, 3000);
      }
    } catch (err) {
      btn.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Network error';
      btn.classList.replace('btn-outline-light', 'btn-outline-danger');
      setTimeout(() => { btn.innerHTML = origText; btn.classList.replace('btn-outline-danger', 'btn-outline-light'); btn.disabled = false; }, 3000);
    }
  }

  // Check if user is logged in and fetch data
  async function initDashboard() {
    try {
      console.log('[Dashboard] Fetching current user...');
      // Fetch current user data with retry logic - more lenient
      let retries = 2;
      let currentUserData = null;

      while (retries > 0) {
        try {
          // Use AbortController for proper timeout
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 3000); // 3 second timeout

          const userRes = await fetch('/api/auth/current', {
            method: 'GET',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            signal: controller.signal
          });

          clearTimeout(timeoutId);

          console.log('[Dashboard] Auth response:', userRes.status);

          if (userRes.ok) {
            currentUserData = await userRes.json();
            console.log('[Dashboard] User logged in:', currentUserData.displayName);
            currentUser = currentUserData;
            document.getElementById('welcomeTitle').innerHTML = `Welcome back, <span class="gradient-text">${currentUser.displayName}!</span>`;

            // Fetch user stats
            try {
              const statsRes = await fetch('/api/auth/stats', {
                credentials: 'include'
              });

              if (statsRes.ok) {
                const stats = await statsRes.json();
                animateCounter('statCompleted', stats.completed);
                animateCounter('statTotal', stats.total);
                animateCounter('statBacklog', stats.backlog);
                animateCounter('statPlaying', stats.playing);
                animateCounter('statHours', Math.round(stats.totalHours));
                // streak removed — replaced by trailers
              }
            } catch (statsErr) {
              console.warn('[Dashboard] Could not fetch stats:', statsErr);
            }

            // Show Steam sync button if user has a Steam ID
            if (currentUserData.steamId) {
              document.getElementById('steamSyncBtn').style.display = '';

              // Check if currently playing a game on Steam
              try {
                const steamRes = await fetch('/api/auth/steam-status', { credentials: 'include' });
                if (steamRes.ok) {
                  const steamData = await steamRes.json();
                  if (steamData.playing && steamData.gameName) {
                    document.getElementById('steamLiveGameName').textContent = steamData.gameName;
                    document.getElementById('steamLiveStatus').style.display = '';
                  }
                }
              } catch (steamErr) {
                console.warn('[Dashboard] Could not fetch live Steam status:', steamErr);
              }
            }

            // Load dynamic content — fire all in parallel, no need to await
            loadActivityFeed(currentUserData);
            loadCommunityScores(currentUserData);
            loadGameDropdown(currentUserData);
            loadPendingBadge();
            // Pre-fetch trending data once, then both sections use it
            fetchTrendingGames();
            loadTrendingGames();
            loadTrailers();

            return; // Success - exit function
          }
          // Retry on any non-200 status
        } catch (fetchErr) {
          console.warn('[Dashboard] Fetch attempt ' + (3 - retries) + ' failed:', fetchErr.message);
          // Network errors are temporary - retry
        }
        retries--;
        if (retries > 0) {
          await new Promise(r => setTimeout(r, 300)); // Brief wait before retry
        }
      }

      // If all retries exhausted, do one final redirect attempt
      console.error('[Dashboard] Auth check failed after all retries - redirecting');
      setTimeout(() => {
        window.location.href = 'login+_';
      }, 500);

    } catch (err) {
      console.error('[Dashboard] Failed to load dashboard:', err);
      setTimeout(() => {
        window.location.href = 'login+_';
      }, 500);
    }
  }

  // Hide loader after initialization
  window.addEventListener('load', () => {
    initDashboard();
    setTimeout(() => {
      const loader = document.getElementById('page-loader');
      if (loader) loader.classList.add('hidden');
    }, 600);
  });

  // Smart home navigation - if logged in go to dashboard, else go to index
  async function smartHomeClick(e) {
    e.preventDefault();
    try {
      const res = await fetch('/api/auth/current', { credentials: 'include' });
      const dest = res.ok ? 'dashboard+_' : 'index+_';
      document.body.classList.add('page-exit');
      setTimeout(() => window.location = dest, 300);
    } catch (err) {
      console.error('Auth check failed:', err);
      window.location = 'index+_';
    }
  }

  // --- Dynamic Activity Feed (combines own + friends activity) ---
  async function loadActivityFeed(user) {
    const feedEl = document.getElementById('activityFeed');
    try {
      const userId = user._id || user.id;
      // Fetch own library
      const libRes = await fetch('/api/library/' + userId, { credentials: 'include' });
      let ownEntries = [];
      if (libRes.ok) {
        const entries = await libRes.json();
        ownEntries = entries.filter(e => e.gameId).map(e => ({ ...e, _user: user }));
      }

      // Fetch friends' activity
      let friendEntries = [];
      try {
        const friendRes = await fetch('/api/friends/activity', { credentials: 'include' });
        if (friendRes.ok) {
          const fEntries = await friendRes.json();
          friendEntries = fEntries.filter(e => e.gameId && e.userId);
        }
      } catch (e) { console.warn('[Dashboard] Friends activity fetch failed:', e); }

      // Combine own (last 5) + friend entries, sort by addedAt desc
      const ownRecent = ownEntries.slice(0, 5);
      const allEntries = [...ownRecent.map(e => ({ entry: e, user: user, isOwn: true })), ...friendEntries.map(e => ({ entry: e, user: e.userId, isOwn: false }))];
      allEntries.sort((a, b) => new Date(b.entry.addedAt || 0) - new Date(a.entry.addedAt || 0));
      const top = allEntries.slice(0, 10);

      if (top.length === 0) {
        feedEl.innerHTML = '<div class="list-group-item p-3 text-center text-muted">No activity yet. <a href="search+_" style="color:#5383e8;">Find games to play!</a></div>';
        return;
      }

      let html = '';
      for (const item of top) {
        const entry = item.entry;
        const u = item.user;
        const game = entry.gameId;
        const gameName = (typeof game === 'object' ? game.name : '') || 'Unknown Game';
        const coverUrl = (typeof game === 'object' ? game.coverUrl : '') || '';
        const coverTag = coverUrl
          ? `<img src="${coverUrl}" class="feed-cover" alt="${gameName} cover" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.insertAdjacentHTML('afterend','<div class=\\'feed-cover d-flex align-items-center justify-content-center\\' style=\\'background:#1a2634;\\'><i class=\\'bi bi-controller\\' style=\\'font-size:1.2rem;color:#5383e8;\\'></i></div>')">`
          : `<div class="feed-cover d-flex align-items-center justify-content-center" style="background:#1a2634;"><i class="bi bi-controller" style="font-size:1.2rem;color:#5383e8;"></i></div>`;
        let typeLabel = 'added to library', borderClass = '', badgeHtml = '';
        if (entry.status === 'completed') { typeLabel = 'completed'; borderClass = 'border-start border-success border-4'; badgeHtml = '<span class="badge bg-success extra-small">COMPLETED</span>'; }
        else if (entry.status === 'playing') { typeLabel = 'is playing'; borderClass = 'border-start border-primary border-4'; }
        else if (entry.status === 'backlog') { typeLabel = 'added to backlog'; borderClass = 'border-start border-warning border-4'; }
        const hoursText = entry.playtime ? `${Math.round(entry.playtime * 10) / 10}h played` : '';
        const ratingText = entry.rating ? '★'.repeat(entry.rating) + '☆'.repeat(5 - entry.rating) : '';
        const displayName = u.displayName || u.username || 'User';
        const userAvatar = u.avatar || '';
        const profileLink = item.isOwn ? 'profile+_' : `profile+_?user=${u._id}`;
        html += `
              <div class="list-group-item p-3 ${borderClass} reveal is-visible">
                <div class="d-flex align-items-center mb-2">
                  <a href="${profileLink}"><img src="${userAvatar}" class="rounded-circle me-2 avatar-sm" alt="User" style="width:32px;height:32px;" onerror="this.style.display='none'"></a>
                  <a href="${profileLink}" class="text-primary fw-bold text-decoration-none">${displayName}</a>
                  <span class="text-muted ms-2 small">${typeLabel}</span>
                </div>
                <div class="d-flex align-items-start gap-3">
                  ${coverTag}
                  <div>
                    <h6 class="mb-1 small">${gameName}</h6>
                    ${badgeHtml}
                    ${ratingText ? `<div class="text-warning extra-small">${ratingText}</div>` : ''}
                    ${hoursText ? `<div class="text-muted extra-small">${hoursText}</div>` : ''}
                  </div>
                </div>
              </div>`;
      }
      feedEl.innerHTML = html;
    } catch (err) {
      console.warn('[Dashboard] Activity feed error:', err);
      feedEl.innerHTML = '<div class="list-group-item p-3 text-center text-muted">Could not load activity feed.</div>';
    }
  }

  // --- Dynamic Community Scores ---
  async function loadCommunityScores(user) {
    const scoresEl = document.getElementById('communityScores');
    try {
      const userId = user._id || user.id;
      const libRes = await fetch('/api/library/' + userId, { credentials: 'include' });
      if (!libRes.ok) { scoresEl.innerHTML = '<p class="text-muted small mb-0">No rated games yet.</p>'; return; }
      const entries = await libRes.json();
      const rated = entries.filter(e => e.gameId && e.rating && e.rating > 0)
        .sort((a, b) => b.rating - a.rating)
        .slice(0, 5);
      if (rated.length === 0) {
        scoresEl.innerHTML = '<p class="text-muted small mb-0">Rate games in your library to see scores here.</p>';
        return;
      }
      let html = '';
      rated.forEach(e => {
        html += `<div class="d-flex justify-content-between mb-2 small"><span>${e.gameId.name}</span><span class="text-warning">★ ${e.rating}.0</span></div>`;
      });
      scoresEl.innerHTML = html;
    } catch (err) {
      scoresEl.innerHTML = '<p class="text-muted small mb-0">Could not load scores.</p>';
    }
  }

  // --- Dynamic Game Dropdown for Post Update ---
  async function loadGameDropdown(user) {
    const sel = document.getElementById('updateGame');
    try {
      const userId = user._id || user.id;
      const libRes = await fetch('/api/library/' + userId, { credentials: 'include' });
      if (!libRes.ok) { sel.innerHTML = '<option value="">No games in library</option>'; return; }
      const entries = await libRes.json();
      const games = entries.filter(e => e.gameId).map(e => e.gameId.name).filter(Boolean);
      if (games.length === 0) {
        sel.innerHTML = '<option value="">No games in library</option>';
        return;
      }
      sel.innerHTML = games.map(name => `<option value="${name}">${name}</option>`).join('');
    } catch (err) {
      sel.innerHTML = '<option value="">Could not load games</option>';
    }
  }

  // --- Pending Friend Requests Badge ---
  async function loadPendingBadge() {
    try {
      const res = await fetch('/api/friends/requests', { credentials: 'include' });
      if (!res.ok) return;
      const requests = await res.json();
      if (requests.length > 0) {
        const profileLink = document.querySelector('a.nav-link[href="profile+_"]');
        if (profileLink) {
          profileLink.innerHTML = `Profile <span style="display:inline-flex;align-items:center;justify-content:center;background:#ef4444;color:#fff;font-size:0.6rem;font-weight:700;width:16px;height:16px;border-radius:50%;margin-left:4px;">${requests.length}</span>`;
        }
      }
    } catch (e) { /* silent */ }
  }

  // Page exit transition
  document.querySelectorAll('a[href]').forEach(a => {
    if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
      a.addEventListener('click', e => {
        e.preventDefault();
        const dest = a.href;
        document.body.classList.add('page-exit');
        setTimeout(() => window.location = dest, 300);
      });
    }
  });

  // ============================================================
  // Animated Counter
  // ============================================================
  function animateCounter(elementId, target) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const duration = 1200;
    const start = performance.now();
    const from = 0;
    function update(now) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(from + (target - from) * eased);
      if (progress < 1) requestAnimationFrame(update);
    }
    requestAnimationFrame(update);
  }

  // ============================================================
  // Latest Trailers — pulled from trending games' IGDB videos
  // ============================================================
  let _trendingGamesPromise = null;
  function fetchTrendingGames() {
    if (!_trendingGamesPromise) {
      _trendingGamesPromise = fetch('/api/games/popular', { credentials: 'include' })
        .then(r => r.ok ? r.json() : [])
        .catch(() => []);
    }
    return _trendingGamesPromise;
  }

  async function loadTrailers() {
    const container = document.getElementById('trailersScroll');
    if (!container) return;
    try {
      const games = await fetchTrendingGames();
      // Extract trailers — max 1 per game for diversity
      const trailers = [];
      for (const game of games) {
        if (!game.videos || game.videos.length === 0) continue;
        trailers.push({ gameName: game.name, videoId: game.videos[0].video_id });
        if (trailers.length >= 12) break;
      }
      if (trailers.length === 0) {
        container.innerHTML = '<div class="text-muted small p-2">No trailers available for current trending games.</div>';
        return;
      }
      container.innerHTML = '';
      trailers.slice(0, 12).forEach((t, idx) => {
        const thumb = `https://img.youtube.com/vi/${t.videoId}/mqdefault.jpg`;
        const item = document.createElement('div');
        item.className = 'trailer-item';
        item.style.animation = `fadeInUp 0.4s ease ${idx * 0.07}s both`;
        item.innerHTML = `
              <img class="trailer-thumb" src="${thumb}" alt="${t.gameName}" loading="lazy">
              <div class="trailer-play-icon"><i class="bi bi-play-fill"></i></div>
              <div class="trailer-name">${t.gameName}</div>
            `;
        item.addEventListener('click', () => openTrailerPlayer(t.videoId, t.gameName));
        container.appendChild(item);
      });
    } catch (err) {
      console.warn('[Dashboard] Trailers load error:', err);
      container.innerHTML = '<div class="text-muted small p-2">Could not load trailers.</div>';
    }
  }

  // Inline YouTube player modal
  function openTrailerPlayer(videoId, gameName) {
    // Remove existing modal if any
    let existing = document.getElementById('trailerModal');
    if (existing) existing.remove();
    const modal = document.createElement('div');
    modal.id = 'trailerModal';
    modal.className = 'trailer-modal';
    modal.innerHTML = `
          <div class="trailer-modal-backdrop"></div>
          <div class="trailer-modal-content">
            <div class="trailer-modal-header">
              <span class="trailer-modal-title">${gameName}</span>
              <button class="trailer-modal-close" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="trailer-modal-body">
              <iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" 
                      allow="autoplay; encrypted-media; fullscreen" 
                      allowfullscreen 
                      frameborder="0"></iframe>
            </div>
          </div>
        `;
    document.body.appendChild(modal);
    // Animate in
    requestAnimationFrame(() => modal.classList.add('active'));
    // Close handlers
    const close = () => { modal.classList.remove('active'); setTimeout(() => modal.remove(), 300); };
    modal.querySelector('.trailer-modal-backdrop').addEventListener('click', close);
    modal.querySelector('.trailer-modal-close').addEventListener('click', close);
    document.addEventListener('keydown', function escHandler(e) {
      if (e.key === 'Escape') { close(); document.removeEventListener('keydown', escHandler); }
    });
  }

  // ============================================================
  // Trending Games (IGDB via server)
  // ============================================================
  async function loadTrendingGames() {
    const container = document.getElementById('trendingScroll');
    if (!container) return;
    // Show current date range
    const dateEl = document.getElementById('trendingDate');
    if (dateEl) {
      const now = new Date();
      const thirtyAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
      const fmt = d => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      dateEl.textContent = fmt(thirtyAgo) + ' — ' + fmt(now);
    }
    try {
      let games = await fetchTrendingGames();
      // Fallback to hardcoded popular games if API fails
      if (!games || games.length === 0) {
        games = discoverGames.map((g, i) => ({
          name: g.name,
          coverUrl: g.img,
          rating: 80 + Math.floor(Math.random() * 15),
          _fallback: true
        }));
      }
      // Take top 15
      const top = games.slice(0, 15);
      container.innerHTML = '';
      top.forEach((game, idx) => {
        const name = game.name || 'Unknown';
        let cover = game.coverUrl || game.cover?.url || '';
        // Upgrade IGDB thumbnail to high-res cover
        if (cover.includes('t_thumb')) cover = cover.replace('t_thumb', 't_cover_big');
        if (cover.includes('t_micro')) cover = cover.replace('t_micro', 't_cover_big');
        const rating = (game.total_rating || game.rating) ? Math.round(game.total_rating || game.rating) : '';
        const card = document.createElement('div');
        card.className = 'trending-card';
        card.style.animationDelay = `${idx * 0.06}s`;
        card.style.animation = `fadeInUp 0.5s ease ${idx * 0.06}s both`;
        const coverImg = cover
          ? `<img src="${cover.startsWith('//') ? 'https:' + cover : cover}" alt="${name}" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 160 220%22 fill=%22%231e2d3a%22%3E%3Crect width=%22160%22 height=%22220%22/%3E%3Ctext x=%2280%22 y=%22110%22 fill=%22%235a6a7a%22 text-anchor=%22middle%22 font-size=%2222%22%3E🎮%3C/text%3E%3C/svg%3E'">`
          : `<div style="width:100%;height:220px;background:#1e2d3a;display:flex;align-items:center;justify-content:center;font-size:2rem;">🎮</div>`;
        card.innerHTML = `
              <span class="trending-rank">#${idx + 1}</span>
              ${coverImg}
              <div class="trending-overlay">
                <div class="trending-name">${name}</div>
                ${rating ? `<div class="trending-rating">★ ${rating}%</div>` : ''}
              </div>
            `;
        card.addEventListener('click', () => {
          window.location.href = 'search+_?q=' + encodeURIComponent(name);
        });
        container.appendChild(card);
      });
    } catch (err) {
      console.warn('[Dashboard] Trending games load error:', err);
      container.innerHTML = '<div class="text-muted small p-3">Could not load trending games.</div>';
    }
  }

  // ============================================================
  // Particle Canvas Animation (GPU-optimized, no connection lines)
  // ============================================================
  (function initParticles() {
    const canvas = document.getElementById('particleCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { willReadFrequently: false });
    let w, h, particles = [];
    const PARTICLE_COUNT = 30;

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 1.5 + 0.5,
        alpha: Math.random() * 0.3 + 0.05,
        color: Math.random() > 0.5 ? '83,131,232' : '45,212,191'
      });
    }

    let lastFrame = 0;
    let running = true;
    const FRAME_INTERVAL = 1000 / 30; // cap at 30fps — visually identical, half the CPU
    function draw(now) {
      if (!running) return;
      requestAnimationFrame(draw);
      if (now - lastFrame < FRAME_INTERVAL) return;
      lastFrame = now;
      ctx.clearRect(0, 0, w, h);
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.color},${p.alpha})`;
        ctx.fill();
      }
    }
    requestAnimationFrame(draw);

    // Stop rendering when tab is hidden, resume when visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { running = false; }
      else { running = true; requestAnimationFrame(draw); }
    });
  })();

  // ============================================================
  // Top 50 Modal
  // ============================================================
  document.getElementById('seeAllBtn')?.addEventListener('click', async () => {
    const modal = new bootstrap.Modal(document.getElementById('top50Modal'));
    const grid = document.getElementById('top50Grid');
    grid.innerHTML = '<div class="text-center py-5 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Loading top games...</div>';
    modal.show();
    try {
      const res = await fetch('/api/games/top', { credentials: 'include' });
      const games = res.ok ? await res.json() : [];
      if (!games.length) { grid.innerHTML = '<div class="text-muted text-center py-4">No games found.</div>'; return; }
      grid.innerHTML = '';
      games.forEach((game, idx) => {
        let cover = game.cover?.url || '';
        if (cover) {
          cover = cover.replace('t_thumb', 't_cover_big');
          if (!cover.startsWith('http')) cover = 'https:' + cover;
        }
        const rating = game.total_rating ? Math.round(game.total_rating) : '';
        const name = game.name || 'Unknown';
        const card = document.createElement('div');
        card.className = 'top50-card';
        card.innerHTML = `
              ${cover ? `<img src="${cover}" alt="${name}" loading="lazy" onerror="this.onerror=null;this.style.display='none'">` : '<div style="width:100%;aspect-ratio:3/4;background:#1e2d3a;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">🎮</div>'}
              <span class="top50-rank">#${idx + 1}</span>
              <div class="top50-info">
                <div class="top50-name">${name}</div>
                ${rating ? `<div class="top50-rating">★ ${rating}%</div>` : ''}
              </div>
            `;
        card.addEventListener('click', () => { window.location.href = 'search+_?q=' + encodeURIComponent(name); });
        grid.appendChild(card);
      });
    } catch (err) {
      grid.innerHTML = '<div class="text-muted text-center py-4">Failed to load games.</div>';
    }
  });

  // ============================================================
  // Navbar scroll effect
  // ============================================================
  // Navbar scroll shadow (passive, cached)
  const _nav = document.querySelector('.navbar');
  let _scrollTick = false;
  window.addEventListener('scroll', () => {
    if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
  }, { passive: true });
</script>

