    { name: "Grand Theft Auto V", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1qx8.jpg", genre: "Action", minSession: 30, avgSession: 60, note: "Los Santos awaits" },
    { name: "God of War", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1r8h.jpg", genre: "Action", minSession: 30, avgSession: 60, note: "Cinematic combat" },
    { name: "Resident Evil 4", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co5v96.jpg", genre: "Horror", minSession: 20, avgSession: 45, note: "Survival horror at its best" },
    { name: "Dota 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1n00.jpg", genre: "MOBA", minSession: 35, avgSession: 50, note: "Intense team battles" },
    { name: "Among Us", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2nl0.jpg", genre: "Social Deduction", minSession: 5, avgSession: 15, note: "Find the imposter" },
    { name: "Apex Legends", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2v6i.jpg", genre: "Battle Royale", minSession: 15, avgSession: 30, note: "Fast-paced hero shooter" }
  ];

  let dashboardLibraryCache = null;

  async function getMyLibrary() {
    if (dashboardLibraryCache) return dashboardLibraryCache;
    try {
      const userId = currentUser && (currentUser._id || currentUser.id);
      if (!userId) return [];
      const res = await fetch('/api/library/' + userId, { credentials: 'include' });
      if (!res.ok) return [];
      const entries = await res.json();
      dashboardLibraryCache = entries.filter(e => e.gameId).map(e => ({
        name: e.gameId.name || 'Unknown',
        genre: (e.gameId.genres || []).join(' • ') || 'Game',
        cover: e.gameId.coverUrl || '',
        status: e.status,
        rating: e.rating || 0
      }));
      return dashboardLibraryCache;
    } catch (err) {
      console.error('[Dashboard] Library fetch error:', err);
      return [];
    }
  }

  async function getLibraryGames(totalMins) {
    const lib = await getMyLibrary();
    const playable = lib.filter(g => g.status === 'backlog' || g.status === 'playing');
    if (playable.length === 0) return null;
    return playable.map(g => ({
      name: g.name,
      img: g.cover || '',
      genre: g.genre || 'Game',
      avgSession: 30,
      minSession: 15,
      note: g.status === 'playing' ? 'Continue where you left off' : 'Sitting in your backlog',
      fromLibrary: true
    }));
  }

  async function getNewGames(totalMins) {
    const lib = await getMyLibrary();
    const libNames = lib.map(g => g.name.toLowerCase());
    return discoverGames.filter(g => !libNames.includes(g.name.toLowerCase()));
  }

  const planInput = document.getElementById("planMinutes");
  const planBtn = document.getElementById("planSuggestBtn");
  const planResult = document.getElementById("planResult");
  const planHours = document.getElementById("planHours");

  planBtn.addEventListener("click", suggestGame);
  planInput.addEventListener("keydown", (e) => { if (e.key === "Enter") suggestGame(); });
  planHours.addEventListener("keydown", (e) => { if (e.key === "Enter") suggestGame(); });

  async function suggestGame() {
    const hours = parseInt(planHours.value) || 0;
    const mins = parseInt(planInput.value) || 0;
    const totalMins = (hours * 60) + mins;
    const source = document.querySelector('input[name="planSource"]:checked').value;

    if (totalMins < 1) {
      planResult.innerHTML = `<p class="mb-0 small text-warning">Please enter at least 1 minute of available time.</p>`;
      return;
    }

    // Collect selected genre filters
    const selectedGenres = [...document.querySelectorAll('#genreChips input:checked')].map(c => c.value.toLowerCase());

    let pool;
    if (source === 'library') {
      pool = await getLibraryGames(totalMins);
      if (!pool || pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-warning">Your library is empty! Add some games first, or try "Try Something New".</p>`;
        return;
      }
    } else {
      pool = await getNewGames(totalMins);
      if (pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-info">You already have all our suggestions! Nice collection.</p>`;
        return;
      }
    }

    // Filter by selected genres (if any selected)
    if (selectedGenres.length > 0) {
      pool = pool.filter(g => {
        const gGenre = (g.genre || '').toLowerCase();
        return selectedGenres.some(sg => gGenre.includes(sg));
      });
      if (pool.length === 0) {
        planResult.innerHTML = `<p class="mb-0 small text-warning">No games match those genres. Try selecting different ones!</p>`;
        return;
      }
    }

    // Filter games that fit within the available time
    const fits = pool.filter(g => g.minSession <= totalMins);
    if (fits.length === 0) {
      planResult.innerHTML = `<p class="mb-0 small text-warning">No games fit in ${hours}h ${mins}m. Try adding more time!</p>`;
      return;
    }

    // Fisher-Yates Shuffle for true randomness
    const shuffle = (array) => {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    };

    const shuffled = shuffle([...fits]);
    const selected = shuffled.slice(0, 3);
    
    let html = '';
    selected.forEach((pick, index) => {
      const sessions = Math.max(1, Math.floor(totalMins / pick.avgSession));
      const imgTag = pick.img
        ? `<img src="${pick.img}" style="width:44px;height:58px;border-radius:6px;object-fit:cover;border:1px solid rgba(255,255,255,0.1);" alt="${pick.name}" loading="lazy">`
        : `<div style="width:44px;height:58px;border-radius:6px;background:#2a3843;display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:#6f7d8a;"><i class="bi bi-controller"></i></div>`;

      const sourceLabel = pick.fromLibrary
        ? '<span class="badge bg-primary ms-1" style="font-size:0.6rem; vertical-align:middle;">Library</span>'
        : '<span class="badge bg-success ms-1" style="font-size:0.6rem; vertical-align:middle;">New Discovery</span>';

      html += `
        <div class="suggestion-item d-flex align-items-center gap-3 ${index > 0 ? 'mt-3 pt-3 border-top border-secondary' : ''}" style="animation: fadeInScale 0.3s ease forwards ${index * 0.1}s; opacity:0; transform:scale(0.95);">
          ${imgTag}
          <div style="flex:1; min-width:0;">
            <p class="mb-0 small text-truncate"><strong>${pick.name}</strong>${sourceLabel}</p>
            <div class="d-flex justify-content-between align-items-center mt-1">
              <small class="text-info" style="font-size:0.7rem; font-weight:600;">~${pick.avgSession}m/sess · ${sessions > 1 ? sessions + ' fit' : '1 fits'}</small>
              <small class="text-muted text-truncate ms-2" style="font-size:0.7rem;">${pick.genre}</small>
            </div>
          </div>
        </div>
      `;
    });
    planResult.innerHTML = html;

    // Highlight animation
    planResult.classList.add("highlight");
    setTimeout(() => planResult.classList.remove("highlight"), 1200);
  }

  // ============================================================
  // Post Update — adds new feed items to the activity feed
  // ============================================================

  let currentUser = null;

  const typeLabels = {
    "session": "logged a session",
    "review": "reviewed a game",
    "completed": "completed a game",
    "playing": "started playing"
  };

  const updateType = document.getElementById("updateType");
  const ratingGroup = document.getElementById("ratingGroup");

  // Photo upload handling
  let selectedPhoto = null;
  const photoUploadArea = document.getElementById("photoUploadArea");
  const photoInput = document.getElementById("photoInput");
  const photoPreviewContainer = document.getElementById("photoPreviewContainer");

  photoUploadArea.addEventListener("click", () => photoInput.click());
  photoInput.addEventListener("change", (e) => {
    const file = e.target.files[0];
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        alert("Photo must be less than 5MB");
        return;
      }
      const reader = new FileReader();
      reader.onload = (event) => {
        selectedPhoto = event.target.result;
        photoUploadArea.classList.add("has-photo");
        photoUploadArea.innerHTML = `<img src="${selectedPhoto}" class="photo-preview-img" alt="Preview" loading="lazy">`;
        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "btn btn-sm btn-outline-danger photo-remove-btn";
        removeBtn.textContent = "Remove Photo";
        removeBtn.addEventListener("click", (e) => {
          e.preventDefault();
          selectedPhoto = null;
          photoInput.value = "";
          photoUploadArea.classList.remove("has-photo");
          photoUploadArea.innerHTML = `<i class="bi bi-image" style="font-size: 1.5rem; color: #5383e8;"></i><p class="mb-0 mt-2 small">Click to upload a screenshot</p>`;
        });
        photoUploadArea.appendChild(removeBtn);
      };
      reader.readAsDataURL(file);
    }
  });

  // Show/hide rating when type changes
  updateType.addEventListener("change", () => {
    ratingGroup.style.display = updateType.value === "review" ? "block" : "none";
  });

  document.getElementById("submitUpdateBtn").addEventListener("click", () => {
    const type = updateType.value;
    const game = document.getElementById("updateGame").value;
    const comment = document.getElementById("updateComment").value.trim();
    const rating = document.getElementById("updateRating").value;
    const errorEl = document.getElementById("updateError");

    if (!comment) {
      errorEl.textContent = "Please write a comment.";
      errorEl.style.display = "block";
      return;
    }

    errorEl.style.display = "none";
    const cover = document.getElementById("updateGame").value; // Just use the game name for now
    const stars = "★".repeat(parseInt(rating)) + "☆".repeat(5 - parseInt(rating));

    let extraHTML = "";
    if (type === "review") {
      extraHTML = `<div class="text-warning mb-1 extra-small">${stars}</div>`;
    } else if (type === "completed") {
      extraHTML = `<span class="badge bg-success extra-small">COMPLETED</span>`;
    } else if (type === "playing") {
      extraHTML = `<span class="badge bg-info text-dark extra-small">NOW PLAYING</span>`;
    }

    const now = new Date();
    const timeStr = now.toLocaleString(undefined, { month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit" });

    const newItem = document.createElement("div");
    newItem.className = "list-group-item p-3 user-post-item";
    newItem.style.opacity = "0";
    newItem.style.transform = "translateY(-10px)";
    newItem.style.transition = "opacity 0.4s ease, transform 0.4s ease";

    let photoHTML = "";
    if (selectedPhoto) {
      photoHTML = `<img src="${selectedPhoto}" class="feed-photo" alt="Session screenshot" loading="lazy">`;
    }

    // Get user avatar or use default
    const userAvatar = currentUser?.avatar || "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%235383e8'%3E%3Ccircle cx='12' cy='8' r='4'/%3E%3Cpath d='M12 14c-6 0-8 3-8 3v6h16v-6s-2-3-8-3z'/%3E%3C/svg%3E";

    newItem.innerHTML = `
            <div class="d-flex align-items-center mb-2">
              <img src="${userAvatar}" class="rounded-circle me-2 avatar-sm" alt="User" style="width: 32px; height: 32px;">
              <strong class="text-primary">${currentUser?.displayName || 'Gamer'}</strong>
              <span class="text-muted ms-2 small">${typeLabels[type]}</span>
              <span class="text-muted ms-auto extra-small">${timeStr}</span>
            </div>
            <div class="d-flex align-items-start gap-3 mb-1">
              <div>
                <h6 class="mb-1 small">${game}</h6>
                ${extraHTML}
              </div>
            </div>
            <p class="mb-2 small text-white-50">"${comment.replace(/</g, '&lt;').replace(/>/g, '&gt;')}"</p>
            ${photoHTML}
          `;

    const feedList = document.querySelector(".list-group");
    feedList.insertBefore(newItem, feedList.firstChild);

    // Animate in
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        newItem.style.opacity = "1";
        newItem.style.transform = "translateY(0)";
      });
    });

    // Close modal and reset form
    const modal = bootstrap.Modal.getInstance(document.getElementById("postUpdateModal"));
    modal.hide();
    document.getElementById("updateComment").value = "";
    updateType.value = "session";
    ratingGroup.style.display = "none";

    // Reset photo
    selectedPhoto = null;
    photoInput.value = "";
    photoUploadArea.classList.remove("has-photo");
    photoUploadArea.innerHTML = `<i class="bi bi-image" style="font-size: 1.5rem; color: #5383e8;"></i><p class="mb-0 mt-2 small">Click to upload a screenshot</p>`;
  });
</script>
