    { name: "Hades", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2qx5.jpg", genre: "Roguelike", minSession: 15, avgSession: 25, note: "Perfect for short runs" },
    { name: "Stardew Valley", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/xrpmydnu9rpxvxfjkiu7.jpg", genre: "Farming Sim", minSession: 15, avgSession: 30, note: "Relaxed pace, save anytime" },
    { name: "Balatro", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co7kaq.jpg", genre: "Roguelike Deckbuilder", minSession: 10, avgSession: 20, note: "One run = one sitting" },
    { name: "Hollow Knight", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1rgi.jpg", genre: "Metroidvania", minSession: 20, avgSession: 45, note: "Bench saves are frequent" },
    { name: "Slay the Spire", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1iyf.jpg", genre: "Deckbuilder", minSession: 15, avgSession: 30, note: "Turn-based, pause anytime" },
    { name: "Celeste", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co3byy.jpg", genre: "Platformer", minSession: 15, avgSession: 30, note: "Short chapters, tight controls" },
    { name: "Persona 5 Royal", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co2t97.jpg", genre: "JRPG", minSession: 45, avgSession: 90, note: "Story-heavy, plan long sessions" },
    { name: "Elden Ring", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co4jni.jpg", genre: "Action RPG", minSession: 30, avgSession: 60, note: "Open world exploration" },
    { name: "Portal 2", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1rs4.jpg", genre: "Puzzle", minSession: 20, avgSession: 40, note: "Clever puzzles, quick chapters" },
    { name: "Disco Elysium", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1sfj.jpg", genre: "RPG", minSession: 30, avgSession: 60, note: "Dialogue-heavy detective RPG" },
    { name: "The Witcher 3", img: "https://images.igdb.com/igdb/image/upload/t_cover_big/co1wyy.jpg", genre: "Action RPG", minSession: 40, avgSession: 80, note: "Incredible world-building" },
