        <h5 class="modal-title"><i class="bi bi-trophy me-2" style="color:#fb923c;"></i>Top 50 Games of All Time</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="top50-grid" id="top50Grid"></div>
      </div>
    </div>
  </div>
</div>
