<section class="section-block" style="padding-top:20px; padding-bottom:80px;">
    <div class="container">
        <div class="cta-banner">
            <h2>Ready to conquer your backlog?</h2>
            <p>Join hundreds of gamers already tracking their collections on Backlog Hero.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap" style="position:relative;z-index:1;">
                <a href="/register" class="btn hero-cta-primary">
                    <i class="bi bi-person-plus-fill me-2"></i>Create a free account
                </a>
                <a href="/login" class="btn hero-cta-secondary">Log In</a>
            </div>
        </div>
    </div>
</section>

<!-- Simple Copyright -->
<div style="border-top: 1px solid rgba(255, 255, 255, 0.07); padding: 24px 0; text-align: center;">
    <p style="color: rgba(180, 200, 230, 0.4); font-size: 0.85rem; margin: 0;">&copy; 2026 Backlog Hero</p>
</div>

<script>
    let allGames = [];
    let heroCoversReady = false;

    // Check if user is logged in immediately and redirect away from intro
    fetch('/api/auth/current', { credentials: 'include' })
        .then(res => {
            if (res.ok) window.location.replace('/dashboard');
        })
        .catch(err => console.error('Auth check failed:', err));

    function populateHeroCovers(igdbGames) {
        if (heroCoversReady) return;
        const container = document.getElementById('heroCovers');
        if (!container) return;
        heroCoversReady = true;

        let coverUrls = [];
        if (igdbGames && igdbGames.length > 20) {
            coverUrls = igdbGames
                .filter(g => g.cover && g.cover.url)
                .map(g => 'https://images.igdb.com/igdb/image/upload/t_cover_big/' + g.cover.url.split('/').pop());
        }
        if (coverUrls.length < 30) {
            const ids = [1174180, 292030, 271590, 1245620, 1086940, 1091500, 1593500, 814380, 2358720, 990080, 1817070, 2050650, 1196590, 1172380, 374320, 1151640, 1190460, 582010, 367520, 413150, 1145360, 1332010, 391540, 620, 1426210, 1382330, 524220, 275850, 379720, 892970, 739630, 381210, 252490, 242760, 105600, 570940];
            coverUrls = ids.map(id => 'https://cdn.cloudflare.steamstatic.com/steam/apps/' + id + '/library_600x900_2x.jpg');
        }
        for (let i = coverUrls.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [coverUrls[i], coverUrls[j]] = [coverUrls[j], coverUrls[i]];
        }
        const perRow = Math.ceil(coverUrls.length / 3);
        for (let r = 0; r < 3; r++) {
            const row = document.createElement('div');
            row.className = 'covers-row';
            const slice = coverUrls.slice(r * perRow, (r + 1) * perRow);
            [...slice, ...slice].forEach(url => {
                const imgWrap = document.createElement('div');
                imgWrap.className = 'hero-img-wrap';
                imgWrap.style.width = '148px';
                imgWrap.style.height = '210px';
                imgWrap.style.flexShrink = '0';
                imgWrap.style.position = 'relative';

                const img = document.createElement('img');
                img.src = url;
                img.alt = '';
                img.loading = r === 0 ? 'eager' : 'lazy';
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover';
                img.style.borderRadius = '10px';
                img.onerror = function () {
                    this.style.display = 'none';
                    this.nextElementSibling.style.display = 'flex';
                };

                const fallback = document.createElement('div');
                fallback.className = 'cover-placeholder';
                fallback.style.display = 'none';
                fallback.style.height = '100%';
                fallback.style.width = '100%';
                fallback.style.alignItems = 'center';
                fallback.style.justifyContent = 'center';
                fallback.style.background = '#1c252e';
                fallback.style.borderRadius = '10px';
                fallback.innerHTML = '<i class="bi bi-controller" style="font-size: 2.5rem; color: var(--primary);"></i>';

                imgWrap.appendChild(img);
                imgWrap.appendChild(fallback);
                row.appendChild(imgWrap);
            });
            container.appendChild(row);
        }
        setTimeout(() => container.classList.add('loaded'), 300);
    }

    async function loadFeaturedGames() {
        try {
            const response = await fetch('/api/igdb/games', { credentials: 'include' });
            if (!response.ok) { populateHeroCovers([]); return; }
            allGames = await response.json();
            populateHeroCovers(allGames);
            if (allGames && allGames.length > 0) displayRandomGames();
        } catch (err) {
            populateHeroCovers([]);
        }
    }

    function displayRandomGames() {
        const gameCardsContainer = document.getElementById('gameCardsContainer');
        if (!gameCardsContainer || !allGames.length) return;

        const topGames = allGames.filter(g => g.rating && g.rating > 85)
            .sort((a, b) => (b.rating || 0) - (a.rating || 0)).slice(0, 12);
        if (!topGames.length) return;

        gameCardsContainer.style.opacity = '0';
        gameCardsContainer.style.transition = 'opacity 0.5s ease';

        setTimeout(() => {
            let html = `<div style="display:flex;gap:12px;width:max-content;animation:scrollLeftAnim 40s linear infinite;" class="gameCarousel">`;
            [...topGames, ...topGames].forEach(game => {
                const coverUrl = game.cover?.url
                    ? 'https://images.igdb.com/igdb/image/upload/t_cover_big/' + game.cover.url.split('/').pop()
                    : '';
                const rating = game.rating ? Math.round(game.rating) : 'N/A';
                html += `<div style="flex:0 0 auto;position:relative;width:106px;height:150px;overflow:hidden;border-radius:10px;border:1px solid rgba(83,131,232,0.35);box-shadow:0 6px 18px rgba(0,0,0,0.4);">
                    ${coverUrl
                        ? `<img src="${coverUrl}" alt="${game.name}" loading="lazy"
                             style="width:100%;height:100%;object-fit:cover;"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                             title="${game.name} — ${rating}/100">
                           <div class="cover-placeholder" style="display:none; height:100%; width:100%; align-items:center; justify-content:center; background:#1c252e;">
                               <i class="bi bi-controller" style="font-size: 2rem; color: var(--primary);"></i>
                           </div>`
                        : `<div class="cover-placeholder" style="display:flex; height:100%; width:100%; align-items:center; justify-content:center; background:#1c252e;">
                               <i class="bi bi-controller" style="font-size: 2rem; color: var(--primary);"></i>
                           </div>`
                    }
                    <div style="position:absolute;top:6px;right:6px;background:rgba(254,188,46,0.95);color:#0f1519;padding:2px 6px;border-radius:5px;font-size:0.65rem;font-weight:700;">${rating}★</div>
                </div>`;
            });
            html += '</div>';
            gameCardsContainer.innerHTML = html;
            gameCardsContainer.style.opacity = '1';
        }, 400);
    }

    // Search animation mockup
    function animateSearch() {
        const searchDiv = document.getElementById('searchAnimation');
        if (!searchDiv) return;
        const targetGame = 'Red Dead Redemption';
        let idx = 0;
        function update() {
            const text = targetGame.substring(0, idx);
            const pct = (idx / targetGame.length) * 100;
            searchDiv.innerHTML = `
                <div style="margin-bottom:16px;">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                        <i class="bi bi-search" style="color:#febc2e;font-size:1.1rem;"></i>
                        <div style="flex:1;height:14px;background:#1e2a34;border-radius:6px;overflow:hidden;">
                            <div style="height:100%;width:${pct}%;background:linear-gradient(90deg,#5383e8,#2dd4bf);transition:width 0.2s;"></div>
                        </div>
                    </div>
                    <div style="color:#b5c0cc;font-size:0.88rem;">Searching: <strong style="color:#febc2e;">${text}${idx < targetGame.length ? '|' : ''}</strong></div>
                </div>
                ${idx >= targetGame.length ? `
                <div style="background:#1a2634;padding:10px 14px;border-radius:8px;border:1px solid #2a3843;animation:fadeInUp 0.4s ease;">
                    <div style="font-weight:700;color:#7eb3ff;margin-bottom:3px;">${targetGame}</div>
                    <div style="font-size:0.75rem;color:#6b7b8d;">2010 · Action Adventure · 96/100</div>
                </div>` : ''}`;
            if (idx < targetGame.length) { idx++; setTimeout(update, 80); }
            else { setTimeout(() => { idx = 0; update(); }, 3000); }
        }
        update();
    }

    // Community feed animation
    const sampleComments = [
        { user: 'GamerPro', comment: 'Just finished Elden Ring! Finally! 🎮', upvotes: 124 },
        { user: 'CasualPlayer', comment: 'Anyone else have 200+ games in backlog?', upvotes: 89 },
        { user: 'SpeedRunner99', comment: 'Got all achievements in BG3, legendary run!', upvotes: 256 },
        { user: 'IndieGames', comment: 'Hades II early access is incredible', upvotes: 142 },
        { user: 'RetroFan', comment: 'Revisiting classic games from 2010s hits different', upvotes: 78 },
        { user: 'CompletionistKing', comment: 'Cleared my entire backlog this year 🏆', upvotes: 195 },
    ];

    function populateCommunityFeed() {
        const feed = document.getElementById('communityFeed');
        if (!feed) return;
        const colors = ['#5383e8', '#2dd4bf', '#e85383', '#febc2e', '#7c3aed', '#10b981'];
        const commentsHtml = sampleComments.map((c, i) => `
            <div style="background:rgba(26,38,52,0.8);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:10px 14px;margin-bottom:8px;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px;">
                    <div style="width:26px;height:26px;border-radius:50%;background:${colors[i % colors.length]};display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:#fff;flex-shrink:0;">${c.user[0]}</div>
                    <span style="font-weight:700;font-size:0.82rem;color:#c8d8f0;">${c.user}</span>
                    <span style="margin-left:auto;font-size:0.75rem;color:#febc2e;">▲ ${c.upvotes}</span>
                </div>
                <div style="font-size:0.85rem;color:rgba(180,200,230,0.72);">${c.comment}</div>
            </div>`).join('');

        // Use CSS animation on an inner container instead of JS scrolling
        feed.innerHTML = `
            <div style="animation: scrollUpAnim 30s linear infinite;">
                ${commentsHtml}
                ${commentsHtml}
            </div>
        `;
    }

    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.section-block').forEach(el => observer.observe(el));

    // Init on load
    window.addEventListener('load', () => {
        loadFeaturedGames();
        animateSearch();
        populateCommunityFeed();

        // Animated Stats Counter
        const counters = document.querySelectorAll('.counter');
        const countSpeed = 200;

        const countObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const counter = entry.target;
                    const target = parseFloat(counter.getAttribute('data-target'));
                    let count = 0;
                    const increment = target / countSpeed;

                    const updateCount = () => {
                        count += increment;
                        if (count < target) {
                            counter.innerText = Math.ceil(count).toLocaleString();
                            setTimeout(updateCount, 1);
                        } else {
                            counter.innerText = target.toLocaleString();
                        }
                    };
                    updateCount();
                    countObserver.unobserve(counter);
                }
            });
        }, { threshold: 0.5 });

        counters.forEach(counter => countObserver.observe(counter));
    });

    // Page transitions
    document.querySelectorAll('a[href]').forEach(a => {
        if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
            a.addEventListener('click', e => {
                e.preventDefault();
                const dest = a.href;
                document.body.classList.add('page-exit');
                setTimeout(() => window.location = dest, 280);
            });
        }
    });

    // Navbar scroll shadow
    const _nav = document.querySelector('.navbar');
    let _tick = false;
    window.addEventListener('scroll', () => {
        if (!_tick) { _tick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _tick = false; }); }
    }, { passive: true });
</script>