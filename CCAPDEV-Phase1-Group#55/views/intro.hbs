<style>
    /* ═══ Intro / Landing Page ═══ */

    /* Scrolling cover mosaic */
    .hero-section {
        position: relative;
        overflow: hidden;
        min-height: 680px;
        display: flex;
        align-items: center;
        background: var(--bg-base) !important;
    }

    .hero-covers-bg {
        position: absolute;
        inset: -10px;
        z-index: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        justify-content: center;
        opacity: 0;
        transition: opacity 1.8s ease;
    }

    .hero-covers-bg.loaded {
        opacity: 1;
    }

    .covers-row {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
        width: max-content;
        animation: coverScroll 130s linear infinite;
    }

    .covers-row:nth-child(2) {
        animation-delay: -32s;
    }

    .covers-row:nth-child(3) {
        animation-delay: -65s;
    }

    .covers-row:nth-child(even) {
        animation-direction: reverse;
    }

    .covers-row img {
        width: 148px;
        height: 210px;
        object-fit: cover;
        border-radius: 10px;
        flex-shrink: 0;
    }

    @keyframes coverScroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    /* Hero overlays */
    .hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
            linear-gradient(to right, rgba(10, 14, 19, 0.95) 0%, rgba(10, 14, 19, 0.70) 55%, rgba(10, 14, 19, 0.35) 100%),
            linear-gradient(to bottom, rgba(10, 14, 19, 0.15) 0%, rgba(10, 14, 19, 0.10) 60%, rgba(10, 14, 19, 1) 100%);
    }

    .hero-section>.container {
        position: relative;
        z-index: 2;
    }

    /* Hero text */
    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(83, 131, 232, 0.12);
        border: 1px solid rgba(83, 131, 232, 0.3);
        color: #7eb3ff;
        padding: 5px 14px;
        border-radius: 100px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .hero-eyebrow i {
        font-size: 0.9rem;
    }

    .hero-title {
        font-size: clamp(2.4rem, 5vw, 3.8rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.08;
        color: #fff;
        margin-bottom: 20px;
    }

    .hero-title .gradient-word {
        background: linear-gradient(135deg, #5383e8 0%, #2dd4bf 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-sub {
        font-size: 1.15rem;
        color: rgba(180, 200, 230, 0.80);
        line-height: 1.65;
        max-width: 520px;
        margin-bottom: 36px;
    }

    .hero-cta-primary {
        background: linear-gradient(135deg, #5383e8, #3b6fd4);
        border: none;
        color: #fff;
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        position: relative;
        overflow: hidden;
    }

    .hero-cta-primary::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
        transition: left 0.5s ease;
    }

    .hero-cta-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(83, 131, 232, 0.45);
        filter: brightness(1.08);
    }

    .hero-cta-primary:hover::after {
        left: 100%;
    }

    .hero-cta-secondary {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.85);
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .hero-cta-secondary:hover {
        background: rgba(255, 255, 255, 0.11);
        border-color: rgba(255, 255, 255, 0.28);
        color: #fff;
    }

    /* Bento-style Stat Grid */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 16px;
        margin-top: 48px;
        padding-top: 32px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 20px;
        padding: 20px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(83, 131, 232, 0.1), transparent 70%);
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(83, 131, 232, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(83, 131, 232, 0.1);
    }

    .stat-card:hover::before {
        opacity: 1;
    }

    .stat-icon {
        font-size: 1.5rem;
        margin-bottom: 12px;
        background: linear-gradient(135deg, #5383e8, #2dd4bf);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
    }

    .stat-num {
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        color: #fff;
        margin-bottom: 4px;
        display: block;
    }

    .stat-label {
        font-size: 0.7rem;
        color: rgba(180, 200, 230, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
    }

    /* Section blocks */
    .section-block {
        padding: 90px 0;
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .section-block.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 18px;
    }

    .section-title {
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        background: linear-gradient(135deg, #c8d8f8, #ffffff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 16px;
    }

    .section-desc {
        font-size: 1.03rem;
        color: rgba(180, 200, 230, 0.72);
        line-height: 1.7;
    }

    /* Feature cards */
    .feature-card {
        background: rgba(20, 28, 38, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 16px;
        padding: 28px 24px;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, #5383e8, #2dd4bf);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .feature-card:hover {
        border-color: rgba(83, 131, 232, 0.35);
        transform: translateY(-3px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25), 0 0 24px rgba(83, 131, 232, 0.08);
    }

    .feature-card:hover::before {
        opacity: 1;
    }

    .fi {
        width: 48px;
        height: 48px;
        background: rgba(83, 131, 232, 0.12);
        border: 1px solid rgba(83, 131, 232, 0.2);
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #7eb3ff;
        margin-bottom: 16px;
    }

    .feature-card h5 {
        font-size: 1rem;
        font-weight: 700;
        color: #d8e8ff;
        margin-bottom: 10px;
    }

    .feature-card p {
        font-size: 0.88rem;
        color: rgba(180, 200, 230, 0.62);
        line-height: 1.65;
        margin: 0;
    }

    /* Mockup placeholder */
    .mockup-placeholder {
        background: rgba(14, 20, 28, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    }

    .mockup-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .mockup-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .mockup-body {
        padding: 20px;
    }

    .mockup-line {
        height: 10px;
        background: rgba(255, 255, 255, 0.07);
        border-radius: 5px;
        margin-bottom: 14px;
    }

    /* CTA banner */
    .cta-banner {
        background: linear-gradient(135deg, rgba(83, 131, 232, 0.12) 0%, rgba(45, 212, 191, 0.08) 100%);
        border: 1px solid rgba(83, 131, 232, 0.2);
        border-radius: 24px;
        padding: 60px 48px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .cta-banner::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: conic-gradient(from 0deg, transparent, rgba(83, 131, 232, 0.05), transparent 30%);
        animation: rotateSweep 10s linear infinite;
        pointer-events: none;
    }

    .cta-banner h2 {
        color: #fff;
        font-weight: 800;
        font-size: 2rem;
        letter-spacing: -0.02em;
        margin-bottom: 10px;
    }

    .cta-banner p {
        color: rgba(180, 200, 230, 0.65);
        margin-bottom: 30px;
    }

    @keyframes rotateSweep {
        to {
            transform: rotate(360deg);
        }
    }


    /* Scroll animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes scrollLeftAnim {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(calc(-50% - 6px));
        }

        /* -6px compensates for gap/2 */
    }

    @keyframes scrollUpAnim {
        from {
            transform: translateY(0);
        }

        to {
            transform: translateY(-50%);
        }
    }
</style>
