<style>
        /* Page-specific: profile edit form */
        body { background: radial-gradient(circle at 20% 20%, rgba(83, 131, 232, 0.12), transparent 30%), radial-gradient(circle at 80% 0%, rgba(167, 139, 250, 0.08), transparent 25%), var(--bg-base); }
        .section-title { color: var(--text-muted); }
        .card { animation: fadeInScale 0.6s ease both; }
        @keyframes fadeInScale { from { opacity: 0; transform: scale(0.97) translateY(14px); } to { opacity: 1; transform: scale(1) translateY(0); } }
        .avatar-preview-container { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 20px; }
        .avatar-preview { width: 100px; height: 100px; border-radius: 50%; border: 3px solid var(--primary); object-fit: cover; background: #151d24; }
        .avatar-upload-controls { flex: 1; }
        .avatar-upload-controls input[type="file"] { display: none; }
        .avatar-upload-btn { cursor: pointer; }
        .games-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; margin: 12px 0; }
        .game-option { background: #151d24; border: 2px solid var(--border); border-radius: var(--radius-sm); padding: 10px; text-align: center; cursor: pointer; transition: border-color var(--duration) var(--ease), background var(--duration) var(--ease), transform var(--duration) var(--ease); font-size: 0.75rem; }
        .game-option:hover { border-color: var(--primary); transform: translateY(-2px); }
        .game-option.selected { border-color: var(--primary); background: rgba(83, 131, 232, 0.15); box-shadow: 0 0 12px rgba(83, 131, 232, 0.3); }
        .game-option-icon { font-size: 2rem; margin-bottom: 6px; display: block; }
        .game-count { display: inline-block; background: var(--primary); color: white; border-radius: 12px; padding: 2px 8px; font-size: 0.7rem; margin-left: 8px; }
        .notification-container { position: fixed; top: 20px; right: 20px; z-index: 10000; pointer-events: none; }
        .notification { background: linear-gradient(135deg, rgba(83, 131, 232, 0.95), rgba(45, 212, 191, 0.9)); color: #fff; padding: 16px 24px; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); display: flex; align-items: center; gap: 12px; margin-bottom: 12px; animation: slideIn 0.4s ease forwards; pointer-events: all; border: 1px solid rgba(255, 255, 255, 0.2); }
        .notification.error { background: linear-gradient(135deg, rgba(220, 53, 69, 0.95), rgba(255, 107, 107, 0.9)); }
        .notification.success { background: linear-gradient(135deg, rgba(45, 212, 191, 0.95), rgba(83, 131, 232, 0.85)); }
        .notification-icon { font-size: 1.5rem; flex-shrink: 0; }
        .notification-content { display: flex; flex-direction: column; gap: 2px; }
        .notification-title { font-weight: 700; font-size: 0.95rem; }
        .notification-message { font-size: 0.85rem; opacity: 0.95; }
        @keyframes slideIn { from { opacity: 0; transform: translateX(400px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes slideOut { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(400px); } }
    </style>{{> navbar-app activePage="profile"}}

    <div class="container my-5">
        <div class="row justify-content-center">
            <!-- Edit form card — centered on the page, max col-md-8 so it doesn't stretch too wide -->
            <div class="col-md-8">
                <div class="card shadow-lg">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                            <div>
                                <div class="section-title mb-2">Edit Profile</div>
                                <h3 class="fw-bold mb-1" id="editPageName">Loading...</h3>
                                <p class="text-muted mb-0">Update your gaming identity and preferences.</p>
                            </div>
                            <a href="/profile" class="btn btn-outline-secondary">Back to Profile</a>
                        </div>

                        <!-- Profile edit form — fields pre-filled with hardcoded data.
                             Gaming identity and timezone add fun profile details -->
                        <form id="profileForm">
                            <!-- Avatar section -->
                            <div class="avatar-preview-container">
                                <img id="avatarPreview" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%235383e8'%3E%3Ccircle cx='12' cy='8' r='4'/%3E%3Cpath d='M12 14c-6 0-8 3-8 3v6h16v-6s-2-3-8-3z'/%3E%3C/svg%3E" class="avatar-preview" alt="Avatar Preview">
                                <div class="avatar-upload-controls">
                                    <label class="form-label">Profile Picture</label>
                                    <input type="file" id="avatarInput" accept="image/*">
                                    <button type="button" class="btn btn-outline-primary btn-sm" id="uploadAvatarBtn">
                                        <i class="bi bi-upload me-1"></i> Upload Avatar
                                    </button>
                                    <p class="text-muted small mt-2">JPG, PNG (Max 5MB)</p>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Display Name</label>
                                    <input type="text" class="form-control" id="inputName" placeholder="Your gaming name">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Username</label>
                                    <input type="text" class="form-control" id="inputUsername" placeholder="@username">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Bio</label>
                                    <textarea class="form-control" rows="3" id="inputBio" placeholder="Tell the gaming community about yourself..."></textarea>
                                    <small class="text-muted">Share your gaming passions, favorite genres, or gaming philosophy.</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Gaming Identity</label>
                                    <select class="form-select" id="inputIdentity">
                                        <option value="">Select your playstyle...</option>
                                        <option value="Completionist">Completionist</option>
                                        <option value="Casual">Casual</option>
                                        <option value="Speedrunner">Speedrunner</option>
                                        <option value="Explorer">Explorer</option>
                                        <option value="Competitive">Competitive</option>
                                        <option value="Story-Driven">Story-Driven</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Favorite Platform</label>
                                    <select class="form-select" id="inputPlatform">
                                        <option value="">Select favorite platform...</option>
                                        <option value="PC">PC</option>
                                        <option value="PlayStation">PlayStation</option>
                                        <option value="Xbox">Xbox</option>
                                        <option value="Nintendo Switch">Nintendo Switch</option>
                                        <option value="Mobile">Mobile</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Favorite Games <span class="game-count" id="gameCount">0/5</span></label>
                                    <p class="text-muted small mb-2">Choose up to 5 games from your library to showcase on your profile.</p>
                                    <div class="games-grid" id="gamesGrid">
                                        <div class="text-muted text-center" style="grid-column: 1/-1; padding: 20px;">Loading your library...</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label"><i class="bi bi-steam me-1"></i>Steam ID</label>
                                    <input type="text" class="form-control" id="inputSteamId" placeholder="Your 17-digit Steam ID (e.g. 76561198012345678)">
                                    <small class="text-muted">Find your Steam ID at <a href="https://steamid.io" target="_blank" rel="noopener" style="color:#5383e8;">steamid.io</a>. Needed to sync playtime from Steam.</small>
                                </div>
                                <!-- Privacy toggle — controls whether activity shows on the community feed.
                                     Defaults to checked (public) -->
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="privacyToggle" checked>
                                        <label class="form-check-label" for="privacyToggle">Show my profile on community</label>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">Save Profile</button>
                                <a href="/profile" class="btn btn-outline-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Container -->
    <div class="notification-container" id="notificationContainer"></div>
    <script>
        const PROFILE_STORAGE_KEY = 'bh_profile_v1';
        const LIBRARY_STORAGE_KEY = 'bh_library_v1';

        const defaultProfile = {
            displayName: 'Gamer',
            username: 'gamer',
            bio: '',
            avatar: 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%235383e8"%3E%3Ccircle cx="12" cy="8" r="4"/%3E%3Cpath d="M12 14c-6 0-8 3-8 3v6h16v-6s-2-3-8-3z"/%3E%3C/svg%3E',
            gamingIdentity: '',
            favoritePlatform: '',
            favoriteGames: [],
            joinDate: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short' })
        };

        function loadProfile() {
            const stored = localStorage.getItem(PROFILE_STORAGE_KEY);
            return stored ? JSON.parse(stored) : defaultProfile;
        }

        function loadLibrary() {
            const stored = localStorage.getItem(LIBRARY_STORAGE_KEY);
            return stored ? JSON.parse(stored) : [];
        }

        function saveProfile(profile) {
            localStorage.setItem(PROFILE_STORAGE_KEY, JSON.stringify(profile));
        }

        let selectedFavoriteGames = [];

        function showNotification(title, message, type = 'success') {
            const container = document.getElementById('notificationContainer');
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            
            const icon = type === 'success' ? '✓' : '!';
            
            notification.innerHTML = `
                <div class="notification-icon">${icon}</div>
                <div class="notification-content">
                    <div class="notification-title">${title}</div>
                    <div class="notification-message">${message}</div>
                </div>
            `;
            
            container.appendChild(notification);
            
            // Auto-remove after 4 seconds
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.4s ease forwards';
                setTimeout(() => notification.remove(), 400);
            }, 4000);
        }

        let serverLibraryGames = []; // populated from server

        async function initializeForm() {
            const localProfile = loadProfile();

            // Fetch current user from server to get the latest avatar & profile data
            let serverUser = null;
            try {
                const res = await fetch('/api/auth/current', { credentials: 'include' });
                if (res.ok) serverUser = await res.json();
            } catch (e) { console.warn('Could not fetch server profile:', e); }

            // Fetch user's library from server for the favorite games picker
            if (serverUser) {
                try {
                    const userId = serverUser._id || serverUser.id;
                    const libRes = await fetch('/api/library/' + userId, { credentials: 'include' });
                    if (libRes.ok) {
                        const entries = await libRes.json();
                        serverLibraryGames = entries
                            .filter(e => e.gameId)
                            .map(e => ({ id: e.gameId._id, name: e.gameId.name, coverUrl: e.gameId.coverUrl }));
                    }
                } catch (e) { console.warn('Could not fetch library:', e); }
            }

            // Merge: prefer server data for key fields, fall back to localStorage
            const profile = {
                ...localProfile,
                displayName: (serverUser && serverUser.displayName) || localProfile.displayName,
                username: (serverUser && serverUser.username) || localProfile.username,
                bio: (serverUser && serverUser.bio && serverUser.bio !== 'No bio yet') ? serverUser.bio : localProfile.bio,
                avatar: (serverUser && serverUser.avatar) || localProfile.avatar,
                steamId: (serverUser && serverUser.steamId) || localProfile.steamId || '',
                favoriteGames: (serverUser && serverUser.favoriteGames && serverUser.favoriteGames.length > 0)
                    ? serverUser.favoriteGames
                    : localProfile.favoriteGames || [],
            };

            // favoriteGames are stored as game name strings on the server
            selectedFavoriteGames = [...profile.favoriteGames];

            // Populate form with merged profile data
            document.getElementById('inputName').value = profile.displayName;
            document.getElementById('inputUsername').value = profile.username;
            document.getElementById('inputBio').value = profile.bio;
            document.getElementById('inputIdentity').value = profile.gamingIdentity || '';
            document.getElementById('inputPlatform').value = profile.favoritePlatform || '';
            document.getElementById('avatarPreview').src = profile.avatar;
            document.getElementById('inputSteamId').value = profile.steamId || '';
            document.getElementById('editPageName').textContent = profile.displayName;

            // Render games grid from server library
            const gamesGrid = document.getElementById('gamesGrid');
            if (serverLibraryGames.length === 0) {
                gamesGrid.innerHTML = '<div class="text-muted text-center" style="grid-column: 1/-1; padding: 20px;">No games in your library yet. <a href="/search" style="color: #5383e8;">Find games to add!</a></div>';
            } else {
                let html = '';
                serverLibraryGames.forEach(game => {
                    const isSelected = selectedFavoriteGames.includes(game.name);
                    html += `
                    <div class="game-option ${isSelected ? 'selected' : ''}" onclick="toggleFavoriteGame(this, '${game.name.replace(/'/g, "\\'")}')" data-game-name="${game.name}">
                        <span class="game-option-icon">🎮</span>
                        <div style="font-weight: 600; color: #dbe7ff;">${game.name}</div>
                    </div>`;
                });
                gamesGrid.innerHTML = html;
            }

            updateGameCount();
        }

        function toggleFavoriteGame(el, gameName) {
            if (selectedFavoriteGames.includes(gameName)) {
                selectedFavoriteGames = selectedFavoriteGames.filter(n => n !== gameName);
                el.classList.remove('selected');
            } else {
                if (selectedFavoriteGames.length < 5) {
                    selectedFavoriteGames.push(gameName);
                    el.classList.add('selected');
                } else {
                    alert('You can only select up to 5 favorite games.');
                    return;
                }
            }
            updateGameCount();
        }

        function updateGameCount() {
            document.getElementById('gameCount').textContent = `${selectedFavoriteGames.length}/5`;
        }

        // Avatar upload handler
        document.getElementById('uploadAvatarBtn').addEventListener('click', () => {
            document.getElementById('avatarInput').click();
        });

        document.getElementById('avatarInput').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    showNotification('File Too Large', 'Avatar must be less than 5MB', 'error');
                    return;
                }
                const reader = new FileReader();
                reader.onload = (event) => {
                    document.getElementById('avatarPreview').src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Form submission
        document.getElementById('profileForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const displayName = document.getElementById('inputName').value.trim();
            if (!displayName) {
                showNotification('Missing Information', 'Please enter a display name', 'error');
                return;
            }

            const profile = {
                displayName: displayName,
                username: document.getElementById('inputUsername').value.trim() || displayName.toLowerCase().replace(/\s+/g, ''),
                bio: document.getElementById('inputBio').value.trim(),
                avatar: document.getElementById('avatarPreview').src,
                gamingIdentity: document.getElementById('inputIdentity').value,
                favoritePlatform: document.getElementById('inputPlatform').value,
                favoriteGames: selectedFavoriteGames,
                steamId: document.getElementById('inputSteamId').value.trim(),
                joinDate: loadProfile().joinDate
            };

            saveProfile(profile);

            // Also save steamId to the server DB
            try {
              const authRes = await fetch('/api/auth/current', { credentials: 'include' });
              if (authRes.ok) {
                const me = await authRes.json();
                await fetch('/api/users/' + me._id, {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  credentials: 'include',
                  body: JSON.stringify({
                    displayName: profile.displayName,
                    bio: profile.bio,
                    avatar: profile.avatar,
                    steamId: profile.steamId,
                    favoriteGames: selectedFavoriteGames
                  })
                });
              }
            } catch (e) { console.warn('Could not sync profile to server:', e); }

            // Check for achievements
            const games = loadLibrary();
            const achievementsKey = 'bh_achievements_v1';
            const unlockedAchievements = JSON.parse(localStorage.getItem(achievementsKey) || '[]');
            
            // Check for curator achievement
            if (profile.bio && profile.gamingIdentity && profile.favoriteGames.length > 0) {
                if (!unlockedAchievements.some(a => a.id === 'curator')) {
                    unlockedAchievements.push({ id: 'curator', unlockedAt: new Date().toISOString() });
                    localStorage.setItem(achievementsKey, JSON.stringify(unlockedAchievements));
                }
            }

            showNotification('Profile Updated', 'Your profile has been saved successfully!', 'success');
            setTimeout(() => window.location.href = '/profile', 1500);
        });

        // Logout function
        async function logout(event) {
          event.preventDefault();
          try {
              await fetch('/api/auth/logout', {
                  method: 'POST',
                  credentials: 'include'
              });
              window.location.href = '/login';
          } catch (err) {
              console.error('Logout failed:', err);
              window.location.href = '/login';
          }
        }

        // Smart home navigation - if logged in go to dashboard, else go to index
        async function smartHomeClick(e) {
          e.preventDefault();
          try {
            const res = await fetch('/api/auth/current', { credentials: 'include' });
            const dest = res.ok ? '/dashboard' : '/';
            document.body.classList.add('page-exit');
            setTimeout(() => window.location = dest, 300);
          } catch (err) {
            console.error('Auth check failed:', err);
            window.location = '/';
          }
        }

        // Auth check with enhanced retry logic
        async function initProfileEdit() {
          try {
            console.log('[ProfileEdit] Fetching current user...');
            let retries = 5;
            
            while (retries > 0) {
              try {
                // Use AbortController for proper timeout
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 5000); // 5 second timeout
                
                const res = await fetch('/api/auth/current', {
                  method: 'GET',
                  credentials: 'include',
                  headers: { 'Content-Type': 'application/json' },
                  signal: controller.signal
                });
                
                clearTimeout(timeoutId);

                console.log('[ProfileEdit] Response status:', res.status);
                
                if (res.ok) {
                  console.log('[ProfileEdit] User authenticated');
                  initializeForm();
                  return;
                } else if (res.status === 401 || res.status === 403) {
                  // Explicit auth failure - don't retry
                  console.error('[ProfileEdit] Unauthorized (' + res.status + ') - redirecting to login');
                  setTimeout(() => {
                    window.location.href = '/login';
                  }, 500);
                  return;
                }
                // Other status codes (5xx, etc) - try again
              } catch (fetchErr) {
                console.warn('[ProfileEdit] Fetch attempt ' + (6 - retries) + ' failed:', fetchErr.message);
                // Network errors are temporary - retry
              }
              retries--;
              if (retries > 0) {
                await new Promise(r => setTimeout(r, 500)); // Longer wait before retry
              }
            }
            
            // If all retries exhausted, redirect
            console.error('[ProfileEdit] Auth check failed after all retries - redirecting');
            window.location.href = '/login';
            
          } catch (err) {
            console.error('[ProfileEdit] Failed to load:', err);
            window.location.href = '/login';
          }
        }

        // Page exit transition
        document.querySelectorAll('a[href]').forEach(a => {
          if (a.hostname === location.hostname && !a.hash && !a.getAttribute('href').startsWith('#') && a.target !== '_blank') {
            a.addEventListener('click', e => {
              e.preventDefault();
              const dest = a.href;
              document.body.classList.add('page-exit');
              setTimeout(() => window.location = dest, 300);
            });
          }
        });

        // Initialize on page load
        window.addEventListener('load', initProfileEdit);

        // Navbar scroll shadow (passive, cached)
        const _nav = document.querySelector('.navbar');
        let _scrollTick = false;
        window.addEventListener('scroll', () => {
            if (!_scrollTick) { _scrollTick = true; requestAnimationFrame(() => { _nav?.classList.toggle('scrolled', window.scrollY > 20); _scrollTick = false; }); }
        }, { passive: true });
    </script>
