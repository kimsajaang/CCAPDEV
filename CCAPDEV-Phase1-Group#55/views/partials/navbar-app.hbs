<!-- Steam Status Bar (always shown when Steam account is linked) -->
<div id="steamStatusBar"
    style="display:none; border-bottom: 1px solid rgba(74,183,107,0.3); padding: 5px 0; font-size: 0.8rem; background: rgba(22,30,38,0.9); transition: background 0.3s var(--ease);">
    <div class="container d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <span id="steamDot"
                style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:#4ab76b;box-shadow: 0 0 6px rgba(74,183,107,0.4);"></span>
            <i class="bi bi-steam" style="color:#4ab76b;"></i>
            <span id="steamStatusText" style="color:#a8d8b0;">Steam Connected</span>
            <span id="steamLiveGame" class="fw-bold" style="color:#4ab76b;"></span>
        </div>
        <button id="navbarSteamSyncBtn" onclick="syncSteam(event)" class="btn btn-sm py-0 px-2"
            style="color:#a8d8b0; font-size: 0.75rem; border: 1px solid rgba(168,216,176,0.2); background: rgba(255,255,255,0.03); border-radius: 4px; transition: all 0.2s;">
            <i class="bi bi-arrow-repeat me-1"></i>Sync Library
        </button>
    </div>
</div>
<style>
    @keyframes steamPulse {

        0%,
        100% {
            opacity: 1;
            box-shadow: 0 0 6px #4ab76b
        }

        50% {
            opacity: .6;
            box-shadow: 0 0 14px #4ab76b
        }
    }

    .steam-playing #steamDot {
        animation: steamPulse 2s ease-in-out infinite;
    }
</style>

<script>
    function smartHomeClick(e) {
        e.preventDefault();
        fetch('/api/auth/current', { credentials: 'include' })
            .then(r => { window.location.href = r.ok ? '/dashboard' : '/'; })
            .catch(() => { window.location.href = '/'; });
    }

    // Show/hide nav items based on authentication — use sessionStorage cache to avoid flicker
    (async function initNav() {
        // Instantly restore from cache (no flicker)
        const cached = sessionStorage.getItem('bh_user');
        if (cached) {
            try { applyUser(JSON.parse(cached)); } catch (e) { }
        }
        // Always re-fetch fresh data in background
        try {
            const r = await fetch('/api/auth/current', { credentials: 'include' });
            const user = r.ok ? await r.json() : null;
            sessionStorage.setItem('bh_user', user ? JSON.stringify(user) : 'null');
            applyUser(user);
        } catch (e) { }
    })();

    function applyUser(user) {
        if (user) {
            document.getElementById('nav-back').classList.add('d-none');
            document.getElementById('nav-dashboard').classList.remove('d-none');
            document.getElementById('nav-library').classList.remove('d-none');
            document.getElementById('nav-profile').classList.remove('d-none');
            document.getElementById('nav-friends').classList.remove('d-none');
            document.getElementById('nav-notifications').classList.remove('d-none');
            document.getElementById('nav-logout').classList.remove('d-none');
            document.getElementById('nav-login').classList.add('d-none');
            // Friend request badge
            const count = user.pendingRequests || 0;
            const badge = document.getElementById('friendReqBadge');
            if (badge && count > 0) {
                badge.textContent = count > 9 ? '9+' : count;
                badge.classList.remove('d-none');
            }
            // Steam bar — always show when linked
            if (user.steamId && user.steamId !== '') {
                document.getElementById('steamStatusBar').style.display = '';
                checkSteamStatus();
            }
        } else {
            document.getElementById('nav-back').classList.remove('d-none');
            document.getElementById('nav-dashboard').classList.add('d-none');
            document.getElementById('nav-library').classList.add('d-none');
            document.getElementById('nav-profile').classList.add('d-none');
            document.getElementById('nav-friends')?.classList.add('d-none');
            document.getElementById('nav-notifications')?.classList.add('d-none');
            document.getElementById('nav-logout').classList.add('d-none');
            document.getElementById('nav-login').classList.remove('d-none');
        }
    }

    // Logout handler
    async function handleLogout(e) {
        e.preventDefault();
        try {
            await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
        } catch (err) {
            console.error('Logout failed:', err);
        }
        window.location.href = '/login';
    }

    // Check live Steam status and update the bar content
    async function syncSteam(e) {
        if (e) e.preventDefault();
        const btn = document.getElementById('navbarSteamSyncBtn');
        if (!btn) return;
        const origContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-arrow-repeat spin-icon"></i>';
        try {
            const res = await fetch('/api/auth/stats', { credentials: 'include' }); // Reuse stats endpoint which does a sync
            const data = await res.json();
            if (res.ok) {
                // Update dashboard stat if present
                const statHours = document.getElementById('statHours');
                if (statHours) {
                    const startValue = parseInt(statHours.textContent) || 0;
                    const targetValue = Math.round(data.totalHours);
                    // Simple animate if on dashboard
                    let current = startValue;
                    const interval = setInterval(() => {
                        if (current >= targetValue) { clearInterval(interval); statHours.textContent = targetValue; }
                        else { current += Math.ceil((targetValue - current) / 10); statHours.textContent = current; }
                    }, 30);
                }
                btn.innerHTML = '<i class="bi bi-check-circle text-success me-1"></i>Updated';
                setTimeout(() => { btn.innerHTML = origContent; btn.disabled = false; }, 3000);
            } else {
                btn.innerHTML = '<i class="bi bi-exclamation-circle text-danger me-1"></i>Failed';
                setTimeout(() => { btn.innerHTML = origContent; btn.disabled = false; }, 3000);
            }
        } catch (err) {
            btn.innerHTML = '<i class="bi bi-wifi-off text-danger me-1"></i>Error';
            setTimeout(() => { btn.innerHTML = origContent; btn.disabled = false; }, 3000);
        }
    }

    async function checkSteamStatus() {
        const bar = document.getElementById('steamStatusBar');
        const statusText = document.getElementById('steamStatusText');
        const gameEl = document.getElementById('steamLiveGame');
        try {
            const res = await fetch('/api/auth/steam-status', { credentials: 'include' });
            if (!res.ok) return;
            const data = await res.json();
            if (data.playing && data.gameName && !data.isFallback) {
                bar.style.background = 'linear-gradient(90deg, rgba(26,45,36,0.97), rgba(22,58,42,0.95))';
                bar.classList.add('steam-playing');
                statusText.textContent = 'Now Playing:';
                gameEl.textContent = data.gameName;
            } else {
                bar.style.background = 'rgba(22,30,38,0.9)';
                bar.classList.remove('steam-playing');
                statusText.textContent = 'Steam Connected';
                gameEl.textContent = '';
            }
        } catch (e) { /* ignore */ }
    }
</script>