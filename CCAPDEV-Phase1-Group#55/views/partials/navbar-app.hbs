<!-- App Navbar — used on dashboard, library, search, stats, profile, profile-edit -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container py-2">
        <a class="navbar-brand fw-bold" href="#" onclick="smartHomeClick(event)">🛡️ Backlog Hero</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto text-uppercase small fw-bold">
                <li class="nav-item"><a class="nav-link {{#if (eq activePage "dashboard")}}active{{/if}}" href="/dashboard.html">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link {{#if (eq activePage "library")}}active{{/if}}" href="/library.html">My Library</a></li>
                <li class="nav-item"><a class="nav-link {{#if (eq activePage "search")}}active{{/if}}" href="/search.html">Search Games</a></li>
                <li class="nav-item"><a class="nav-link {{#if (eq activePage "stats")}}active{{/if}}" href="/stats.html">Community</a></li>
                <li class="nav-item"><a class="nav-link {{#if (eq activePage "profile")}}active{{/if}}" href="/profile.html">Profile</a></li>
                <li class="nav-item"><a class="nav-link btn btn-outline-danger ms-lg-2 px-3 py-1" id="logoutBtn" href="#" onclick="logout(event)">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>
<script>
function smartHomeClick(e) {
    e.preventDefault();
    window.location.href = '/dashboard.html';
}
async function logout(e) {
    e.preventDefault();
    try {
        await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
    } catch (err) { console.error('Logout error:', err); }
    window.location.href = '/index.html';
}
</script>
